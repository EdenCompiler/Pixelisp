(in-package #:pixelisp.tests)
(in-suite pixelisp)

(defmacro with-sprite-source-surfaces (bindings &body body)
  (if bindings
      `(px:with-resource ,(first bindings)
         (with-sprite-source-surfaces ,(rest bindings) ,@body))
      `(progn ,@body)))

(test sprite-source-rect-is-copied-validated-and-native-independent
  (let* ((crop (px.rect:make-rect 1 0 2 1))
         (sprite (px:make-sprite :source-rect crop)))
    (setf (px.rect:x crop) 80)
    (is (equal '(1 0 2 1)
               (let ((copy (px.sprite:source-rect sprite)))
                 (list (px.rect:x copy) (px.rect:y copy)
                       (px.rect:width copy) (px.rect:height copy)))))
    (let ((copy (px.sprite:source-rect sprite)))
      (setf (px.rect:x copy) 81)
      (is (= 1 (px.rect:x (px.sprite:source-rect sprite)))))
    (signals error (setf (px.sprite:source-rect sprite) '(1 2 3)))
    (signals type-error (setf (px.sprite:source-rect sprite) :bad))))

(test sprite-source-rect-crops-normal-and-dirty-blits-at-sprite-position
  (with-sprite-source-surfaces ((source (px.surface:make-surface '(3 1)))
                                (background (px.surface:make-surface '(5 1)))
                                (target (px.surface:make-surface '(5 1))))
    (px.surface:set-at source '(0 0) '(10 0 0))
    (px.surface:set-at source '(1 0) '(80 0 0))
    (px.surface:set-at source '(2 0) '(160 0 0))
    (px.surface:fill background '(20 0 0))
    (px.surface:blit target background '(0 0))
    (let* ((crop (px.rect:make-rect 1 0 2 1))
           (sprite (px:make-sprite :image source :rect (px.rect:make-rect 2 0 3 1)
                                   :source-rect crop))
           (normal (px.sprite:make-group sprite)))
      (px.sprite:draw normal target)
      (is (= 20 (px.color:r (px.surface:get-at target '(1 0)))))
      (is (= 80 (px.color:r (px.surface:get-at target '(2 0)))))
      (is (= 160 (px.color:r (px.surface:get-at target '(3 0)))))
      (is (= 20 (px.color:r (px.surface:get-at target '(4 0))))))
    (px.surface:blit target background '(0 0))
    (let* ((sprite (px:make-sprite :image source :rect (px.rect:make-rect 2 0 3 1)
                                   :source-rect '(1 0 2 1)))
           (group (px.sprite:make-layered-dirty-group sprite)))
      (px.sprite:draw group target background)
      (is (= 80 (px.color:r (px.surface:get-at target '(2 0)))))
      (is (= 160 (px.color:r (px.surface:get-at target '(3 0)))))
      (setf (px.sprite:source-rect sprite) '(0 0 1 1))
      (is (= 1 (px.sprite:dirty sprite)))
      (px.sprite:draw group target)
      ;; The old, wider crop is restored before the replacement crop is drawn.
      (is (= 10 (px.color:r (px.surface:get-at target '(2 0)))))
      (is (= 20 (px.color:r (px.surface:get-at target '(3 0))))))))

(test sprite-source-rect-keeps-destination-origin
  (with-sprite-source-surfaces ((source (px.surface:make-surface '(4 3)))
                                (target (px.surface:make-surface '(8 7))))
    (px.surface:fill source '(10 0 0))
    (px.surface:set-at source '(2 1) '(200 0 0))
    (let* ((sprite (px:make-sprite :image source :rect (px.rect:make-rect 5 4 2 2)
                                   :source-rect '(2 1 2 2)))
           (group (px.sprite:make-group sprite)))
      (px.sprite:draw group target)
      (is (= 200 (px.color:r (px.surface:get-at target '(5 4)))))
      (is (= 0 (px.color:r (px.surface:get-at target '(3 3)))))
      (is (= 0 (px.color:r (px.surface:get-at target '(7 6))))))))
