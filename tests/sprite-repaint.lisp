(in-package #:pixelisp.tests)
(in-suite pixelisp)

(test layered-dirty-repaint-restores-an-edited-background
  (with-sprite-test-surfaces ((image (px.surface:make-surface '(1 1)))
                              (background (px.surface:make-surface '(3 1)))
                              (target (px.surface:make-surface '(3 1))))
    (px.surface:fill image '(200 0 0))
    (px.surface:fill background '(10 0 0))
    (px.surface:blit target background '(0 0))
    (let* ((sprite (px:make-sprite :image image :rect (px.rect:make-rect 1 0 1 1)))
           (group (px.sprite:make-layered-dirty-group sprite)))
      (px.sprite:draw group target background)
      (is (= 10 (px.color:r (px.surface:get-at target '(0 0)))))
      (px.surface:set-at background '(0 0) '(40 0 0))
      (px.sprite:repaint-rect group '(0 0 1 1))
      (px.sprite:draw group target)
      (is (= 40 (px.color:r (px.surface:get-at target '(0 0))))))))

(test layered-dirty-clip-intersects-surface-clip-and-restores-on-error
  (with-sprite-test-surfaces ((image (px.surface:make-surface '(3 1)))
                              (target (px.surface:make-surface '(4 1))))
    (px.surface:fill image '(180 0 0))
    (let* ((sprite (px:make-sprite :image image :rect (px.rect:make-rect 0 0 3 1)))
           (group (px.sprite:make-layered-dirty-group sprite)))
      (px.sprite:set-clip group '(1 0 2 1))
      (px.surface:set-clip target '(2 0 2 1))
      (px.sprite:draw group target)
      (is (= 0 (px.color:r (px.surface:get-at target '(1 0)))))
      (is (= 180 (px.color:r (px.surface:get-at target '(2 0)))))
      (is (= 0 (px.color:r (px.surface:get-at target '(3 0)))))
      (let ((clip-before (px.surface:get-clip target)))
        (signals error
          (px.sprite:clear group target (lambda (surface area)
                                          (declare (ignore surface area))
                                          (error "background callback failed"))))
        (is (equal (list (px.rect:x clip-before) (px.rect:y clip-before)
                         (px.rect:width clip-before) (px.rect:height clip-before))
                   (let ((clip-after (px.surface:get-clip target)))
                     (list (px.rect:x clip-after) (px.rect:y clip-after)
                           (px.rect:width clip-after) (px.rect:height clip-after)))))))))

(test layered-dirty-clip-and-repaint-rect-copy-their-rectangles
  (let ((group (px.sprite:make-layered-dirty-group))
        (clip (px.rect:make-rect 1 2 3 4))
        (repaint (px.rect:make-rect 2 3 1 1)))
    (px.sprite:set-clip group clip)
    (setf (px.rect:x clip) 99)
    (let ((returned (px.sprite:get-clip group)))
      (is (= 1 (px.rect:x returned)))
      (setf (px.rect:x returned) 77)
      (is (= 1 (px.rect:x (px.sprite:get-clip group)))))
    (px.sprite:repaint-rect group repaint)
    (setf (px.rect:x repaint) 88)
    ;; The queued repaint remains the original rectangle, returned as damage.
    (with-sprite-test-surfaces ((target (px.surface:make-surface '(20 20))))
      (is (= 2 (px.rect:x (first (px.sprite:draw group target))))))))

(test layered-dirty-changing-clip-to-and-from-nil-forces-redraw
  (with-sprite-test-surfaces ((image (px.surface:make-surface '(2 1)))
                              (target (px.surface:make-surface '(2 1))))
    (px.surface:fill image '(120 0 0))
    (let* ((sprite (px:make-sprite :image image))
           (group (px.sprite:make-layered-dirty-group sprite)))
      (px.sprite:set-clip group '(0 0 1 1))
      (px.sprite:draw group target)
      (is (= 0 (px.color:r (px.surface:get-at target '(1 0)))))
      (px.sprite:set-clip group nil)
      (is (null (px.sprite:get-clip group)))
      (is (not (null (px.sprite:draw group target))))
      (is (= 120 (px.color:r (px.surface:get-at target '(1 0))))))))

(test layered-dirty-clip-suppresses-outside-and-empty-damage
  (with-sprite-test-surfaces ((image (px.surface:make-surface '(1 1)))
                              (target (px.surface:make-surface '(4 2))))
    (px.surface:fill image '(160 0 0))
    (let* ((sprite (px:make-sprite :image image :rect (px.rect:make-rect 3 0 1 1)))
           (group (px.sprite:make-layered-dirty-group sprite)))
      (px.sprite:set-clip group '(1 0 1 1))
      (is (null (px.sprite:draw group target)))
      (is (= 0 (px.color:r (px.surface:get-at target '(3 0)))))
      (px.sprite:repaint-rect group '(3 0 1 1))
      (is (null (px.sprite:draw group target)))
      (px.sprite:repaint-rect group '(1 0 0 1))
      (is (null (px.sprite:draw group target))))))

(test layered-dirty-partially-clipped-clean-sprite-becomes-idle
  (with-sprite-test-surfaces ((image (px.surface:make-surface '(3 1)))
                              (target (px.surface:make-surface '(3 1))))
    (px.surface:fill image '(160 0 0))
    (let* ((sprite (px:make-sprite :image image))
           (group (px.sprite:make-layered-dirty-group sprite)))
      (px.sprite:set-clip group '(1 0 2 1))
      (let ((damage (px.sprite:draw group target)))
        (is (not (null damage)))
        (is (every (lambda (area)
                     (and (plusp (px.rect:width area))
                          (plusp (px.rect:height area))
                          (<= 1 (px.rect:x area))
                          (<= (+ (px.rect:x area) (px.rect:width area)) 3)
                          (= 0 (px.rect:y area))
                          (<= (+ (px.rect:y area) (px.rect:height area)) 1)))
                   damage))
        (is (some (lambda (area)
                    (equal '(1 0 2 1)
                           (list (px.rect:x area) (px.rect:y area)
                                 (px.rect:width area) (px.rect:height area))))
                  damage)))
      (is (null (px.sprite:draw group target))))))

(test layered-dirty-clip-widen-restores-area-after-clipped-movement
  (with-sprite-test-surfaces ((image (px.surface:make-surface '(1 1)))
                              (background (px.surface:make-surface '(4 1)))
                              (target (px.surface:make-surface '(4 1))))
    (px.surface:fill image '(200 0 0))
    (px.surface:fill background '(10 0 0))
    (px.surface:blit target background '(0 0))
    (let* ((sprite (px:make-sprite :image image))
           (group (px.sprite:make-layered-dirty-group sprite)))
      (px.sprite:draw group target background)
      (is (= 200 (px.color:r (px.surface:get-at target '(0 0)))))
      (px.sprite:set-clip group '(1 0 1 1))
      ;; An external edit outside the active group clip must survive this draw.
      (px.surface:set-at target '(0 0) '(30 0 0))
      (setf (px.sprite:rect sprite) (px.rect:make-rect 1 0 1 1))
      (px.sprite:draw group target background)
      (is (= 30 (px.color:r (px.surface:get-at target '(0 0)))))
      (is (= 200 (px.color:r (px.surface:get-at target '(1 0)))))
      (px.sprite:set-clip group nil)
      (px.sprite:draw group target background)
      (is (= 10 (px.color:r (px.surface:get-at target '(0 0)))))
      (is (= 200 (px.color:r (px.surface:get-at target '(1 0))))))))

(test layered-dirty-invisible-clean-sprite-becomes-idle
  (with-sprite-test-surfaces ((image (px.surface:make-surface '(1 1)))
                              (target (px.surface:make-surface '(1 1))))
    (let* ((sprite (px:make-sprite :image image :visible nil))
           (group (px.sprite:make-layered-dirty-group sprite)))
      (is (null (px.sprite:draw group target)))
      (is (zerop (px.sprite:dirty sprite)))
      (is (null (px.sprite:draw group target))))))

(test layered-dirty-background-error-can-be-retried
  (with-sprite-test-surfaces ((image (px.surface:make-surface '(1 1)))
                              (target (px.surface:make-surface '(2 1))))
    (px.surface:fill image '(90 0 0))
    (let* ((fail nil)
           (background (lambda (surface area)
                         (when fail (error "temporary background failure"))
                         (px.surface:fill surface '(0 0 0) area)))
           (sprite (px:make-sprite :image image))
           (group (px.sprite:make-layered-dirty-group sprite)))
      (px.sprite:draw group target background)
      (setf fail t (px.sprite:dirty sprite) 1)
      (signals error (px.sprite:draw group target))
      (setf fail nil)
      (is (not (null (px.sprite:draw group target))))
      (is (= 90 (px.color:r (px.surface:get-at target '(0 0))))))))

(test get-sprite-uses-layered-draw-order-and-validates-indices
  (let* ((low (px:make-sprite :layer -1))
         (high (px:make-sprite :layer 4))
         (middle (px:make-sprite :layer 2))
         (group (px.sprite:make-layered-group high low middle)))
    (is (eq low (px.sprite:get-sprite group 0)))
    (is (eq middle (px.sprite:get-sprite group 1)))
    (is (eq high (px.sprite:get-sprite group 2)))
    (is (eq high (px.sprite:get-sprite group -1)))
    (is (eq low (px.sprite:get-sprite group -3)))
    (signals error (px.sprite:get-sprite group 3))
    (signals error (px.sprite:get-sprite group -4))
    (signals type-error (px.sprite:get-sprite group 1.5))))
