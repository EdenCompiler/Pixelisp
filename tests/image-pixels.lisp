;;;; Test byte layouts directly: palette entries can share RGB colors, rows can
;;;; have padding, and a shared surface must never free the caller's allocation.
(in-package #:pixelisp.tests)
(in-suite pixelisp)

(test indexed-image-bytes-copy-indices-and-separate-the-palette
  (let ((bytes (make-array 6 :element-type '(unsigned-byte 8) :initial-contents '(1 2 3 4 5 6))))
    (px:with-resource (surface (px.image:from-bytes bytes '(3 2) :p))
      (is (= 8 (px.surface:get-bitsize surface)))
      (is (= 256 (length (px.surface:get-palette surface))))
      (is (equal '(255 255 255 255) (px.color:to-list (px.surface:get-palette-at surface 1))))
      (setf (aref bytes 0) 99)
      (is (= 1 (px.surface:get-at-mapped surface '(0 0))))
      (px.surface:set-palette-at surface 1 '(70 80 90))
      (px.surface:set-palette-at surface 2 '(70 80 90))
      (px.surface:set-colorkey surface 2)
      (px.surface:set-alpha surface 17)
      (px.surface:set-clip surface '(0 0 0 0))
      (is (equalp #(1 2 3 4 5 6) (px.image:to-bytes surface "p")))
      (is (equalp #(4 5 6 1 2 3) (px.image:to-string surface :p t)))
      (is-false (px.surface:locked-p surface)))
    (px:with-resource (flipped (px.image:from-string bytes '(3 2) "P" t))
      (is (equalp #(4 5 6 99 2 3) (px.image:to-bytes flipped :p))))))

(test indexed-image-export-omits-parent-pixels-and-native-row-padding
  (px.surface:with-surface (parent '(5 3) :depth 8)
    (loop for y below 3 do
      (loop for x below 5 do (px.surface:set-at-mapped parent (list x y) (+ x (* 10 y)))))
    (px:with-resource (crop (px.surface:subsurface parent '(1 1 3 2)))
      (is (equalp #(11 12 13 21 22 23) (px.image:to-bytes crop :p)))
      (is (equalp #(21 22 23 11 12 13) (px.image:to-bytes crop :p t))))))

(test shared-image-imports-preserve-tight-8-and-24-bit-layouts
  (dolist (format '(:p :rgb :bgr))
    (let* ((channels (length (string format))) (count (* 6 channels))
           (owner (list :foreign-allocation)))
      (cffi:with-foreign-object (pixels :uint8 count)
        (dotimes (i count) (setf (cffi:mem-aref pixels :uint8 i) (1+ i)))
        (px:with-resource (surface (px.image:from-buffer pixels '(3 2) format :owner owner :byte-count count))
          (is (eq owner (px.surface::parent surface)))
          (is (= (* channels 8) (px.surface:get-bitsize surface)))
          (is (= (* 3 channels) (px.surface:get-pitch surface)))
          (setf (cffi:mem-aref pixels :uint8 (* 3 channels)) 55)
          (if (eq format :p)
              (progn
                (is (= 55 (px.surface:get-at-mapped surface '(0 1))))
                (is (equal '(255 255 255 255) (px.color:to-list (px.surface:get-at surface '(0 1)))))
                (px.surface:set-at-mapped surface '(1 1) 78)
                (is (= 78 (cffi:mem-aref pixels :uint8 4))))
              (progn
                (is (= 55 (if (eq format :rgb)
                              (px:color-r (px.surface:get-at surface '(0 1)))
                              (px:color-b (px.surface:get-at surface '(0 1))))))
                (px.surface:set-at surface '(1 1) '(70 80 90))
                (is (equal (if (eq format :rgb) '(70 80 90) '(90 80 70))
                           (loop for i from (* 4 channels) below (* 5 channels)
                                 collect (cffi:mem-aref pixels :uint8 i)))))))
        ;; Disposal frees SDL metadata only. The CFFI allocation remains usable.
        (setf (cffi:mem-aref pixels :uint8 0) 123)
        (is (= 123 (cffi:mem-aref pixels :uint8 0)))))))

(test shared-32-bit-channel-orders-and-unused-alpha
  (dolist (format '(:rgba :argb :bgra :rgbx))
    (cffi:with-foreign-object (pixels :uint8 4)
      (loop for value in '(10 20 30 40) for i from 0 do (setf (cffi:mem-aref pixels :uint8 i) value))
      (px:with-resource (surface (px.image:from-buffer pixels '(1 1) format :byte-count 4))
        (is (equal (case format (:rgba '(10 20 30 40)) (:argb '(20 30 40 10))
                                 (:bgra '(30 20 10 40)) (:rgbx '(10 20 30 255)))
                   (px.color:to-list (px.surface:get-at surface '(0 0)))))
        (is (eq (not (eq format :rgbx)) (px.surface:alpha-p surface)))))))

(test image-byte-transfers-reject-invalid-input-and-closed-owners
  (let ((data (make-array 4 :element-type '(unsigned-byte 8) :initial-element 0)))
    (signals px:error (px.image:from-bytes data '(3 2) :p))
    (signals type-error (px.image:from-bytes data '(0 4) :p))
    (signals type-error (px.image:from-bytes data '(1 4) 12)))
  (signals type-error (px.image:to-bytes nil :p))
  (px.surface:with-surface (truecolor '(1 1))
    (signals px:unsupported-feature (px.image:to-bytes truecolor :p))
    (is-false (px.surface:locked-p truecolor)))
  (let ((closed (px.image:from-bytes (make-array 1 :element-type '(unsigned-byte 8)) '(1 1) :p)))
    (px:dispose closed)
    (signals px:disposed-resource (px.image:to-bytes closed :p)))
  (cffi:with-foreign-object (pixels :uint8 6)
    (signals px:error (px.image:from-buffer pixels '(3 2) :rgb :byte-count 6))
    (signals type-error (px.image:from-buffer pixels '(3 2) :p :byte-count -1))
    (let ((owner (px.buffer:make-view :owner nil :dimensions '(1) :reader (lambda (i) (declare (ignore i)) 0))))
      (px:with-resource (surface (px.image:from-buffer pixels '(3 2) :p :owner owner :byte-count 6))
        (px.buffer:close owner)
        (signals px:disposed-resource (px.surface:get-at surface '(0 0)))
        (signals px:disposed-resource (px.image:from-buffer pixels '(3 2) :p :owner owner :byte-count 6))))))
