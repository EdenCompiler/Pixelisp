(in-package #:pixelisp.tests)
(in-suite pixelisp)

(defmacro with-sprite-test-surfaces (bindings &body body)
  "Dispose each native surface even when a focused sprite assertion fails."
  (if bindings
      `(px:with-resource ,(first bindings)
         (with-sprite-test-surfaces ,(rest bindings) ,@body))
      `(progn ,@body)))

(test group-single-membership-and-replacement
  (let* ((first (px:make-sprite))
         (second (px:make-sprite))
         (third (px:make-sprite))
         (single (px.sprite:make-group-single first second)))
    (is (eq second (px.sprite:single-sprite single)))
    (is (not (px.sprite:has-p single first)))
    (is (equal (list single) (px.sprite:groups second)))
    (px.sprite:add single (list first third))
    (is (eq third (px.sprite:single-sprite single)))
    (is (not (px.sprite:alive-p second)))
    (is (equal (list single) (px.sprite:groups third)))
    (setf (px.sprite:single-sprite single) first)
    (is (eq first (px.sprite:single-sprite single)))
    (setf (px.sprite:single-sprite single) nil)
    (is (null (px.sprite:single-sprite single)))
    (is (not (px.sprite:alive-p first)))
    (px.sprite:add third single)
    (is (eq third (px.sprite:single-sprite single)))
    ;; Invalid input is rejected while flattening, before the old member is
    ;; removed, so a failed replacement leaves both sides of membership intact.
    (signals type-error (px.sprite:add single first :not-a-sprite))
    (is (eq third (px.sprite:single-sprite single)))
    (signals type-error (setf (px.sprite:single-sprite single) :not-a-sprite))
    (is (eq third (px.sprite:single-sprite single)))
    (is (equal (list single) (px.sprite:groups third)))
    (let ((copy (px.sprite:copy-group single)))
      (is (eq third (px.sprite:single-sprite copy)))
      (px.sprite:kill third)
      (is (null (px.sprite:single-sprite single)))
      (is (null (px.sprite:single-sprite copy))))))

(test layered-top-and-bottom-sprites-follow-draw-order
  (let* ((low (px:make-sprite :layer -2))
         (high (px:make-sprite :layer 4))
         (middle (px:make-sprite :layer 1))
         (group (px.sprite:make-layered-group high low middle)))
    (is (eq low (px.sprite:get-bottom-sprite group)))
    (is (eq high (px.sprite:get-top-sprite group)))
    (px.sprite:change-layer group high -3)
    (is (eq high (px.sprite:get-bottom-sprite group)))
    (is (eq middle (px.sprite:get-top-sprite group)))))

(test sprite-blend-flags-reach-normal-and-dirty-drawing
  (with-sprite-test-surfaces ((source (px.surface:make-surface '(1 1) :alpha t))
                              (target (px.surface:make-surface '(1 1) :alpha t)))
    (px.surface:fill source '(100 0 0))
    (px.surface:fill target '(20 0 0))
    (let* ((sprite (px:make-sprite :image source :blend-flags :blend-rgb-add))
           (group (px.sprite:make-group sprite)))
      (px.sprite:draw group target)
      (is (= 120 (px.color:r (px.surface:get-at target '(0 0))))))
    (px.surface:fill target '(20 0 0))
    (let* ((sprite (px:make-sprite :image source :blend-flags :blend-rgb-add))
           (group (px.sprite:make-layered-dirty-group sprite)))
      (px.sprite:draw group target)
      (is (= 120 (px.color:r (px.surface:get-at target '(0 0))))))))

(test changing-blend-flags-redraws-a-clean-dirty-sprite
  (with-sprite-test-surfaces ((source (px.surface:make-surface '(1 1) :alpha t))
                              (background (px.surface:make-surface '(1 1)))
                              (target (px.surface:make-surface '(1 1))))
    (px.surface:fill source '(100 0 0))
    (px.surface:fill background '(20 0 0))
    (let* ((sprite (px:make-sprite :image source))
           (group (px.sprite:make-layered-dirty-group sprite)))
      (px.sprite:draw group target background)
      (is (zerop (px.sprite:dirty sprite)))
      (is (= 100 (px.color:r (px.surface:get-at target '(0 0)))))
      (setf (px.sprite:blend-flags sprite) :blend-rgb-add)
      (is (= 1 (px.sprite:dirty sprite)))
      (px.sprite:draw group target)
      (is (zerop (px.sprite:dirty sprite)))
      (is (= 120 (px.color:r (px.surface:get-at target '(0 0))))))))
