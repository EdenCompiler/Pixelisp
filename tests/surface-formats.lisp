;;;; Native formats must keep pixel addressing, palettes and owners consistent.
(in-package #:pixelisp.tests)
(in-suite pixelisp)

(test surface-native-depths-respect-row-padding-and-clips
  (dolist (depth '(8 12 15 16 24 32))
    (px.surface:with-surface (surface '(3 2) :depth depth)
      (is (= depth (px.surface:get-bitsize surface)))
      (is (= (ceiling depth 8) (px.surface:get-bytesize surface)))
      (is (>= (px.surface:get-pitch surface) (* 3 (ceiling depth 8))))
      (let ((red (px.surface:map-rgb surface '(255 0 0))))
        (px.surface:set-at-mapped surface '(2 1) red)
        (is (= red (px.surface:get-at-mapped surface '(2 1))))
        (is (= 0 (px.surface:get-at-mapped surface '(1 1))))
        (is (equal '(255 0 0 255)
                   (px.color:to-list (px.surface:get-at surface '(2 1)))))
        (px.surface:set-clip surface '(0 0 1 1))
        (px.surface:set-at-mapped surface '(2 1) 0)
        (is (= red (px.surface:get-at-mapped surface '(2 1))))
        (signals type-error
          (px.surface:set-at-mapped surface '(0 0) (ash 1 (* 8 (ceiling depth 8))))))
      (is (not (px.surface:locked-p surface))))))

(test palette-values-are-independent-and-replacements-are-validated-first
  (px.surface:with-surface (surface '(2 1) :depth 8)
    (is (= 256 (length (px.surface:get-palette surface))))
    (px.surface:set-palette surface #((10 20 30) (40 50 60)))
    (let ((color (px.surface:get-palette-at surface 1)))
      (setf (px:color-r color) 200)
      (is (= 40 (px:color-r (px.surface:get-palette-at surface 1)))))
    (let ((before (mapcar #'px.color:to-list (px.surface:get-palette surface))))
      (signals error (px.surface:set-palette surface '((1 2 3) (4 5 300))))
      (signals px:unsupported-feature
        (px.surface:set-palette-at surface 1 '(1 2 3 20)))
      (signals type-error (px.surface:set-palette-at surface 256 '(1 2 3)))
      (is (equal before (mapcar #'px.color:to-list (px.surface:get-palette surface))))))
  (px.surface:with-surface (surface '(1 1))
    (signals px:unsupported-feature (px.surface:get-palette surface))
    (signals px:unsupported-feature
      (px.surface:set-palette surface '((1 2 3))))))

(test indexed-subsurfaces-share-pixels-and-retain-independent-palettes
  (px.surface:with-surface (surface '(4 2) :depth 8)
    (px.surface:set-palette-at surface 7 '(21 42 63))
    (px.surface:set-at-mapped surface '(3 1) 7)
    (px:with-resource (child (px.surface:subsurface surface '(2 1 2 1)))
      (is (= (px.surface:get-pitch surface) (px.surface:get-pitch child)))
      (is (= 7 (px.surface:get-at-mapped child '(1 0))))
      (px.surface:set-palette-at child 7 '(200 100 50))
      (is (equal '(21 42 63 255)
                 (px.color:to-list (px.surface:get-at surface '(3 1)))))
      (px:with-resource (copy (px.surface:copy child))
        (is (= 8 (px.surface:get-bitsize copy)))
        (is (= 7 (px.surface:get-at-mapped copy '(1 0))))
        (px.surface:set-palette-at surface 7 '(9 8 7))
        (is (= 200 (px:color-r (px.surface:get-at copy '(1 0)))))
        (is (= 200 (px:color-r (px.surface:get-at child '(1 0))))))
      (px.buffer:with-view (pixels (px.surface:get-view child #\2))
        (signals px:resource-in-use (px:dispose surface))
        (setf (px.buffer:view-ref pixels 0 0) 7)
        (is (= 7 (px.surface:get-at-mapped surface '(2 1))))))))

(test duplicate-palette-colors-keep-distinct-transparent-indices
  (px.surface:with-surface (source '(2 1) :depth 8)
    (px.surface:set-palette-at source 1 '(20 30 40))
    (px.surface:set-palette-at source 2 '(20 30 40))
    (px.surface:set-at-mapped source '(0 0) 1)
    (px.surface:set-at-mapped source '(1 0) 2)
    (px.surface:set-colorkey source 2)
    (px.surface:with-surface (target '(2 1))
      (px.surface:fill target '(1 2 3))
      (px.surface:blit target source '(0 0))
      (is (= 20 (px:color-r (px.surface:get-at target '(0 0)))))
      (is (= 1 (px:color-r (px.surface:get-at target '(1 0))))))
    (is (equalp #2A((255) (0)) (px.surfarray:array-colorkey source)))
    (is (= 1 (px.mask:count (px.mask:from-surface source))))
    (is (= 1 (px.rect:width (px.surface:get-bounding-rect source))))
    (px:with-resource (copy (px.surface:copy source))
      (is (= 2 (px.surface::%native-colorkey copy)))
      (is (= 2 (px.surface:get-at-mapped copy '(1 0)))))
    (px:with-resource (converted (px.surface:convert source source))
      (is (= 1 (px.surface:get-at-mapped converted '(0 0))))
      (is (= 2 (px.surface:get-at-mapped converted '(1 0))))
      (is (= 2 (px.surface::%native-colorkey converted))))
    (px.surface:set-palette-at source 2 '(99 88 77))
    (is (equal '(99 88 77 255)
               (px.color:to-list (px.surface:get-colorkey source))))))

(test native-format-copies-conversions-and-alpha
  (px.surface:with-surface (source '(2 1) :depth 24 :masks '(#xff0000 #xff00 #xff 0))
    (px.surface:set-at source '(0 0) '(120 60 30))
    (px.surface:set-at source '(1 0) '(255 0 0))
    (px.surface:set-colorkey source '(120 60 30))
    (px.surface:set-alpha source 91)
    (px.surface:set-clip source '(0 0 1 1))
    (px:with-resource (copy (px.surface:copy source))
      (is (= 24 (px.surface:get-bitsize copy)))
      (is (equal (px.surface:get-masks source) (px.surface:get-masks copy)))
      (is (= 255 (px:color-r (px.surface:get-at copy '(1 0))))))
    (px:with-resource (converted (px.surface:convert source 16))
      (is (= 16 (px.surface:get-bitsize converted)))
      (is (= 91 (px.surface:get-alpha converted)))
      (is (= 255 (px:color-r (px.surface:get-at converted '(1 0))))))
    (px:with-resource (converted (px.surface:convert-alpha source))
      (is (= 32 (px.surface:get-bitsize converted)))
      (is (= 91 (px.surface:get-alpha converted)))
      (is (null (px.surface:get-colorkey converted)))
      (is (= 0 (px:color-a (px.surface:get-at converted '(0 0)))))
      (is (= 255 (px:color-a (px.surface:get-at converted '(1 0)))))))
  (px.surface:with-surface (surface '(1 1) :depth 16 :alpha t)
    (px.surface:set-at surface '(0 0) '(255 0 255 136))
    (is (equal '(255 0 255 136)
               (px.color:to-list (px.surface:get-at surface '(0 0)))))))

(test alpha16-blits-and-opaque-template-conversion
  (px.surface:with-surface (source '(2 1) :depth 16 :alpha t)
    (px.surface:with-surface (target '(2 1))
      (px.surface:fill target '(0 0 255))
      (px.surface:set-at source '(0 0) '(255 0 0 0))
      (px.surface:set-at source '(1 0) '(0 255 0 255))
      (px.surface:blit target source '(0 0))
      (is (equal '(0 0 255 255) (px.color:to-list (px.surface:get-at target '(0 0)))))
      (is (equal '(0 255 0 255) (px.color:to-list (px.surface:get-at target '(1 0))))))
    (px:with-resource (opaque (px.surface:convert source source))
      (is (= 12 (px.surface:get-bitsize opaque)))
      (is (not (px.surface:alpha-p opaque))))))

(test format-validation-and-closed-palettes-fail-before-native-use
  (signals px:unsupported-feature (px.surface:make-surface '(1 1) :depth 7))
  (signals px:unsupported-feature (px.surface:make-surface '(1 1) :depth 8 :alpha t))
  (signals error (px.surface:make-surface '(1 1) :depth 16 :masks '(#xf800 #xf800 #x1f 0)))
  (signals error (px.surface:make-surface '(1 1) :masks '(#x55 #xff00 #xff0000 0)))
  (signals error (px.surface:make-surface '(1 1) :depth 16 :masks '(#x10000 #x7e0 #x1f 0)))
  (signals type-error (px.surface:get-palette :not-a-surface))
  (px.surface:with-surface (indexed '(1 1) :depth 8)
    (signals type-error (px.surface:unmap-rgb indexed 256))
    (signals type-error (px.surface:unmap-rgb indexed -1)))
  (let ((surface (px.surface:make-surface '(1 1) :depth 8)))
    (px:dispose surface)
    (signals px:disposed-resource (px.surface:get-palette surface))))
