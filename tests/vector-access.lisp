(in-package #:pixelisp.tests)
(in-suite pixelisp)

(test vector-component-indexing
  (let ((value (px.math:make-vector2 11/3 22/5)))
    (is (= 11/3 (px.math:component value 0)))
    (is (= 22/5 (px.math:component value 1)))
    (is (= 22/5 (px.math:component value -1)))
    (is (= 11/3 (px.math:component value -2)))
    (is (= 7/9 (setf (px.math:component value -2) 7/9)))
    (is (= 7/9 (px.math:x value)))
    (is (= 3/8 (setf (px.math:component value 1) 3/8)))
    (is (= 3/8 (px.math:y value)))
    (signals error (px.math:component value 2))
    (signals error (px.math:component value -3))
    (signals error (setf (px.math:component value 2) 90))
    (signals error (setf (px.math:component value 0) 'not-a-number))
    (is (equal '(7/9 3/8) (px.math:components value))))
  (let ((value (px.math:make-vector3 4 5 6)))
    (is (= 6 (px.math:component value -1)))
    (is (= 5 (setf (px.math:component value -2) 5)))
    (is (= 5 (px.math:y value)))))

(test vector-swizzle-read
  (let ((two (px.math:make-vector2 2 7))
        (three (px.math:make-vector3 2 7 9)))
    (is (= 7 (px.math:swizzle two "y")))
    (is (equal '(7 2) (px.math:swizzle two "yx")))
    (is (equal '(2 7 2) (px.math:swizzle two "xyx")))
    (is (equal '(2 7 0 1) (px.math:swizzle two "xy01")))
    (is (equal '(9 2 7) (px.math:swizzle three "zxy")))
    (signals error (px.math:swizzle two "z"))
    (signals error (px.math:swizzle three "xq"))
    (signals error (px.math:swizzle two ""))
    (signals error (px.math:swizzle two "0"))
    (signals error (px.math:swizzle two "01"))))

(test vector-swizzle-write-is-atomic
  (let ((value (px.math:make-vector3 1 2 3)))
    (is (equal '(8 9) (setf (px.math:swizzle value "yx") '(8 9))))
    (is (equal '(9 8 3) (px.math:components value)))
    (is (= 5 (setf (px.math:swizzle value "z") 5)))
    (is (equal '(9 8 5) (px.math:components value)))
    (signals error (setf (px.math:swizzle value "xx") '(4 6)))
    (signals error (setf (px.math:swizzle value "xy") '(4)))
    (signals error (setf (px.math:swizzle value "xy") '(4 bad)))
    (signals error (setf (px.math:swizzle value "xz") '(4 5 6)))
    (signals error (setf (px.math:swizzle value "x0") '(4 5)))
    (signals error (setf (px.math:swizzle value "q") '(4)))
    (is (equal '(9 8 5) (px.math:components value)))))
