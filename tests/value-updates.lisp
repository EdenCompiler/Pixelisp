(in-package #:pixelisp.tests)
(in-suite pixelisp)
(in-suite pixelisp)

(test math-lerp-accepts-scalars-and-keeps-vector-interpolation
  (is (= 15 (px.math:lerp 10 20 1/2)))
  (is (= 10 (px.math:lerp 10 20 0)))
  (is (= 20.0 (px.math:lerp 10.0 20.0 1)))
  (let* ((first (px.math:make-vector2 1 4))
         (second (px.math:make-vector2 5 8))
         (middle (px.math:lerp first second 1/2)))
    (is (equal '(3 6) (px.math:components middle)))
    (is (not (eq first middle)))
    (is (equal '(1 4) (px.math:components first))))
  (signals error (px.math:lerp 0 1 -0.01))
  (signals error (px.math:lerp 0 1 1.01)))

(test math-round-vector-uses-away-ties-and-returns-a-copy
  (let* ((value (px.math:make-vector2 2.5d0 -3.5d0))
         (rounded (px.math:round-vector value)))
    (is (equal '(3.0d0 -4.0d0) (px.math:components rounded)))
    (is (not (eq value rounded)))
    (setf (px.math:x value) 9)
    (is (equal '(3.0d0 -4.0d0) (px.math:components rounded))))
  (is (equal '(30.0d0 -40.0d0)
             (px.math:components (px.math:round-vector '(25 -35) -1))))
  (is (equal '(1.3d0 1.4d0)
             (px.math:components (px.math:round-vector #(1.25d0 1.35d0) 1))))
  (is (equal '(2.68d0 -2.68d0)
             (px.math:components (px.math:round-vector '(2.675d0 -2.675d0) 2))))
  (let ((rounded (px.math:round-vector (px.math:make-vector3 1.5d0 -2.5d0 3.5d0))))
    (is (px.math:vector3-p rounded))
    (is (equal '(2.0d0 -3.0d0 4.0d0) (px.math:components rounded))))
  (signals type-error (px.math:round-vector '(1 2) 1/2)))

(test rectangle-update-accepts-supported-shapes-and-truncates
  (let ((r (px:make-rect 0 0 1 1)))
    (is (eq r (px.rect:update-rect r 1.9 -2.9 3.9 4.9)))
    (is (equal '(1 -2 3 4) (list (px.rect:x r) (px.rect:y r)
                                  (px.rect:width r) (px.rect:height r))))
    (px.rect:update-rect r '(5.9 6.9 7.9 8.9))
    (is (equal '(5 6 7 8) (list (px.rect:x r) (px.rect:y r)
                                  (px.rect:width r) (px.rect:height r))))
    (px.rect:update-rect r #(9 10 11 12))
    (is (equal '(9 10 11 12) (list (px.rect:x r) (px.rect:y r)
                                    (px.rect:width r) (px.rect:height r))))
    (px.rect:update-rect r #(13.9 14.9) #(15.9 16.9))
    (is (equal '(13 14 15 16) (list (px.rect:x r) (px.rect:y r)
                                    (px.rect:width r) (px.rect:height r))))
    (let ((source (px:make-rect 20 21 22 23)))
      (px.rect:update-rect r source)
      (setf (px.rect:x source) 99)
      (is (equal '(20 21 22 23) (list (px.rect:x r) (px.rect:y r)
                                      (px.rect:width r) (px.rect:height r)))))))

(test rectangle-update-validates-before-changing-any-slot
  (let ((r (px:make-rect 1 2 3 4)))
    (signals error (px.rect:update-rect r 10 20 "bad" 40))
    (is (equal '(1 2 3 4) (list (px.rect:x r) (px.rect:y r)
                                (px.rect:width r) (px.rect:height r))))
    (signals error (px.rect:update-rect r '(10 20 30)))
    (is (equal '(1 2 3 4) (list (px.rect:x r) (px.rect:y r)
                                (px.rect:width r) (px.rect:height r))))
    (signals error (px.rect:update-rect r '(10 "bad") '(30 40)))
    (is (equal '(1 2 3 4) (list (px.rect:x r) (px.rect:y r)
                                (px.rect:width r) (px.rect:height r))))))
