(in-package #:pixelisp.tests)
(in-suite pixelisp)

(defun %renderer-blit-rect-values (rect)
  (list (px.rect:x rect) (px.rect:y rect) (px.rect:width rect) (px.rect:height rect)))

(test renderer-blit-crops-scales-and-returns-requested-rectangles
  (px:with-init (:video t)
    (px.sdl2.video:with-window (window :size '(8 4) :hidden t)
      (px.sdl2.video:with-renderer (renderer window)
        (px.surface:with-surface (surface '(4 1) :alpha t)
          (loop for red in '(10 20 30 40) for x from 0
                do (px.surface:set-at surface (list x 0) (list red 0 0 255)))
          (px:with-resource (texture (px.sdl2.video:texture-from-surface renderer surface))
            (px.sdl2.video:clear renderer '(0 0 0 255))
            (let* ((requested (px:make-rect 2 1 4 1))
                   (result (px.sdl2.video:blit renderer texture requested
                                             :area #(1 0 2 1) :special-flags 42)))
              (is (equal '(2 1 4 1) (%renderer-blit-rect-values result)))
              (is (not (eq requested result)))
              (px:with-resource (pixels (px.sdl2.video:to-surface renderer))
                (is (equal '(0 0 20 20 30 30 0 0)
                           (loop for x below 8 collect (px:color-r (px.surface:get-at pixels (list x 1))))))))
            ;; Offscreen drawing is clipped by SDL; the returned Rect is not.
            (px.sdl2.video:clear renderer '(0 0 0 255))
            (is (equal '(-1 0 4 1)
                       (%renderer-blit-rect-values (px.sdl2.video:blit renderer texture #(-1 0)))))
            (px:with-resource (pixels (px.sdl2.video:to-surface renderer))
              (is (equal '(20 30 40 0)
                         (loop for x below 4 collect (px:color-r (px.surface:get-at pixels (list x 0)))))))
            (is (equal '(0 0 8 4)
                       (%renderer-blit-rect-values (px.sdl2.video:blit renderer texture '(2 1 0 1)))))
            (setf (px.sdl2.video:viewport renderer) '(1 1 4 2))
            (is (equal '(1 1 4 2)
                       (%renderer-blit-rect-values (px.sdl2.video:blit renderer texture))))))))))

(test renderer-blit-images-use-local-crops-and-restore-texture-state
  (px:with-init (:video t)
    (px.sdl2.video:with-window (window :size '(6 3) :hidden t)
      (px.sdl2.video:with-renderer (renderer window)
        (px.surface:with-surface (surface '(4 1) :alpha t)
          (loop for color in '((200 20 20) (20 180 20) (20 20 200) (150 100 50))
                for x from 0 do (px.surface:set-at surface (list x 0) color))
          (px:with-resource (texture (px.sdl2.video:texture-from-surface renderer surface))
            (let* ((parent (px.sdl2.video:make-image texture '(1 0 3 1)))
                   (image (px.sdl2.video:make-image parent '(1 0 2 1))))
              (setf (px.sdl2.video:texture-color texture) '(200 200 200)
                    (px.sdl2.video:texture-alpha texture) 190
                    (px.sdl2.video:image-color image) '(128 255 255))
              (px.sdl2.video:clear renderer '(0 0 0 255))
              (is (equal '(2 1 2 1)
                         (%renderer-blit-rect-values
                          (px.sdl2.video:blit renderer image '(2 1) :area '(0 0 1 1)))))
              (px:with-resource (pixels (px.sdl2.video:to-surface renderer))
                (is (equal '(10 20 200 255) (px.color:to-list (px.surface:get-at pixels '(2 1)))))
                (is (equal '(10 20 200 255) (px.color:to-list (px.surface:get-at pixels '(3 1))))))
              (is (equal '(200 200 200) (px.sdl2.video:texture-color texture)))
              (is (= 190 (px.sdl2.video:texture-alpha texture)))
              ;; Empty crops draw nothing; invalid crops do not alter modifiers.
              (px.sdl2.video:blit renderer image '(0 0) :area '(2 0 0 1))
              (signals error (px.sdl2.video:blit renderer image '(0 0) :area '(2 0 1 1)))
              (signals error (px.sdl2.video:blit renderer image '(0 0 1)))
              (signals type-error (px.sdl2.video:blit renderer image '(0 0) :special-flags :add))
              (is (equal '(200 200 200) (px.sdl2.video:texture-color texture)))
              (is (= 190 (px.sdl2.video:texture-alpha texture))))))))))

(test renderer-blit-validates-ownership-types-and-lifetimes
  (px:with-init (:video t)
    (px.sdl2.video:with-window (window-a :size '(2 2) :hidden t)
      (px.sdl2.video:with-window (window-b :size '(2 2) :hidden t)
        (px.sdl2.video:with-renderer (renderer-a window-a)
          (px.sdl2.video:with-renderer (renderer-b window-b)
            (px:with-resource (texture (px.sdl2.video:make-texture renderer-a '(1 1)))
              (signals type-error (px.sdl2.video:blit window-a texture))
              (signals type-error (px.sdl2.video:blit renderer-a window-a))
              (signals px:error (px.sdl2.video:blit renderer-b texture '(0 0)))
              (let ((image (px.sdl2.video:make-image texture)))
                (signals px:error (px.sdl2.video:blit renderer-b image '(0 0)))
                (px:dispose texture)
                (signals px:disposed-resource (px.sdl2.video:blit renderer-a texture))
                (signals px:disposed-resource (px.sdl2.video:blit renderer-a image))))))))))
