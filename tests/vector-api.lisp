(in-package #:pixelisp.tests)
(in-suite pixelisp)

(defun vector-components-near-p (value expected &optional (epsilon 1d-9))
  "Compare vector components numerically, allowing float rounding."
  (and (= (cl:length expected) (cl:length (px.math:components value)))
       (every (lambda (actual target) (< (abs (- actual target)) epsilon))
              (px.math:components value) expected)))

(test vector-scale-to-length
  (let ((value (px.math:make-vector2 3 4)))
    (is (eq value (px.math:scale-to-length value 10)))
    (is (vector-components-near-p value '(6 8)))
    (px.math:scale-to-length value -5)
    (is (vector-components-near-p value '(-3 -4)))
    (px.math:scale-to-length value 0)
    (is (vector-components-near-p value '(0 0)))
    (signals error (px.math:scale-to-length value 2))
    (is (vector-components-near-p value '(0 0))))
  (let ((value (px.math:make-vector3 0 0 2)))
    (px.math:scale-to-length value 3)
    (is (vector-components-near-p value '(0 0 3)))))

(test vector-update
  (let ((value (px.math:make-vector2 1 2)))
    (is (eq value (px.math:update-vector value 3 4)))
    (is (equal '(3 4) (px.math:components value)))
    (px.math:update-vector value '(5 6))
    (is (equal '(5 6) (px.math:components value)))
    (px.math:update-vector value (px.math:make-vector2 7 8))
    (is (equal '(7 8) (px.math:components value)))
    (px.math:update-vector value 9)
    (is (equal '(9 9) (px.math:components value)))
    (signals error (px.math:update-vector value '(1 2 3)))
    (signals error (px.math:update-vector value 1 2 3))
    (is (equal '(9 9) (px.math:components value))))
  (let ((value (px.math:make-vector3 1 2 3)))
    (px.math:update-vector value #(4 5 6))
    (is (equal '(4 5 6) (px.math:components value)))
    (signals error (px.math:update-vector value '(8 9)))
    (is (equal '(4 5 6) (px.math:components value)))))

(test vector-radian-rotations
  (let ((value (px.math:rotate-rad (px.math:make-vector2 1 0) (/ pi 2))))
    (is (< (abs (px.math:x value)) 1d-9))
    (is (< (abs (- 1 (px.math:y value))) 1d-9)))
  (let ((value (px.math:make-vector2 1 0)))
    (is (eq value (px.math:rotate-rad-ip value (/ pi 2))))
    (is (< (abs (- 1 (px.math:y value))) 1d-9)))
  (let ((value (px.math:rotate-x-rad (px.math:make-vector3 0 1 0) (/ pi 2))))
    (is (< (abs (px.math:y value)) 1d-9))
    (is (< (abs (- 1 (px.math:z value))) 1d-9)))
  (let ((value (px.math:make-vector3 0 1 0)))
    (is (eq value (px.math:rotate-x-rad-ip value (/ pi 2))))
    (is (< (abs (- 1 (px.math:z value))) 1d-9)))
  (let ((value (px.math:rotate-y-rad (px.math:make-vector3 0 0 1) (/ pi 2))))
    (is (< (abs (- 1 (px.math:x value))) 1d-9))
    (is (< (abs (px.math:z value)) 1d-9)))
  (let ((value (px.math:make-vector3 0 0 1)))
    (is (eq value (px.math:rotate-y-rad-ip value (/ pi 2))))
    (is (< (abs (- 1 (px.math:x value))) 1d-9))
    (is (< (abs (px.math:z value)) 1d-9)))
  (let ((value (px.math:rotate-z-rad (px.math:make-vector3 1 0 0) (/ pi 2))))
    (is (< (abs (- 1 (px.math:y value))) 1d-9)))
  (let ((value (px.math:make-vector3 1 0 0)))
    (is (eq value (px.math:rotate-z-rad-ip value (/ pi 2))))
    (is (< (abs (- 1 (px.math:y value))) 1d-9))))

(test vector-axis-degree-ip-rotations
  (let ((value (px.math:make-vector3 0 1 0)))
    (is (eq value (px.math:rotate-x-ip value 90)))
    (is (< (abs (- 1 (px.math:z value))) 1d-9)))
  (let ((value (px.math:make-vector3 0 0 1)))
    (is (eq value (px.math:rotate-y-ip value 90)))
    (is (< (abs (- 1 (px.math:x value))) 1d-9)))
  (let ((value (px.math:make-vector3 1 0 0)))
    (is (eq value (px.math:rotate-z-ip value 90)))
    (is (< (abs (- 1 (px.math:y value))) 1d-9))))

(test scalar-clamp
  (is (= 2 (px.math:clamp 3 0 2)))
  (is (= 3 (px.math:clamp 2 3 0)))
  (is (= 0 (px.math:clamp 3 3 0)))
  (is (= 0 (px.math:clamp 4 3 0)))
  (is (= 1 (px.math:clamp 1 0 2)))
  (signals error (px.math:clamp 1 0 "2")))
