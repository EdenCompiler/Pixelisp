(in-package #:pixelisp.tests)
(in-suite pixelisp)

(defmacro with-render-updates-surfaces (bindings &body body)
  (if bindings
      `(px:with-resource ,(first bindings)
         (with-render-updates-surfaces ,(rest bindings) ,@body))
      `(progn ,@body)))

(test render-updates-reports-new-and-unioned-old-bounds-in-order
  (with-render-updates-surfaces ((image (px.surface:make-surface '(2 1)))
                                 (target (px.surface:make-surface '(9 1))))
    (px.surface:fill image '(120 0 0))
    (let* ((first (px:make-sprite :image image :rect (px.rect:make-rect 0 0 2 1)))
           (second (px:make-sprite :image image :rect (px.rect:make-rect 5 0 2 1)))
           (group (px.sprite:make-render-updates-group first second)))
      (is (equal '((0 0 2 1) (5 0 2 1))
                 (mapcar (lambda (area) (list (px.rect:x area) (px.rect:y area)
                                               (px.rect:width area) (px.rect:height area)))
                         (px.sprite:draw group target))))
      (setf (px.sprite:rect first) (px.rect:make-rect 1 0 2 1)
            (px.sprite:rect second) (px.rect:make-rect 7 0 2 1))
      (is (equal '((0 0 3 1) (7 0 2 1) (5 0 2 1))
                 (mapcar (lambda (area) (list (px.rect:x area) (px.rect:y area)
                                               (px.rect:width area) (px.rect:height area)))
                         (px.sprite:draw group target))))
      ;; RenderUpdates reports each current blit even when its bounds are stable.
      (is (equal '((1 0 2 1) (7 0 2 1))
                 (mapcar (lambda (area) (list (px.rect:x area) (px.rect:y area)
                                               (px.rect:width area) (px.rect:height area)))
                         (px.sprite:draw group target))))
      (px.sprite:remove group first)
      (is (equal '((1 0 2 1) (7 0 2 1))
                 (mapcar (lambda (area) (list (px.rect:x area) (px.rect:y area)
                                               (px.rect:width area) (px.rect:height area)))
                         (px.sprite:draw group target)))))))

(test render-updates-reports-hidden-bounds-and-preserves-group-copy-order
  (with-render-updates-surfaces ((image (px.surface:make-surface '(1 1)))
                                 (target (px.surface:make-surface '(2 1))))
    (px.surface:fill image '(90 0 0))
    (let* ((first (px:make-sprite :image image))
           (second (px:make-sprite :image image :rect (px.rect:make-rect 1 0 1 1)))
           (group (px.sprite:make-render-updates-group first second))
           (copy (px.sprite:copy-group group)))
      (is (equal (list first second) (px.sprite:sprites copy)))
      (is (typep copy 'px.sprite:render-updates-group))
      (px.sprite:draw group target)
      (setf (px.sprite:visible-p second) nil)
      (is (equal '((0 0 1 1) (1 0 1 1))
                 (mapcar (lambda (area) (list (px.rect:x area) (px.rect:y area)
                                               (px.rect:width area) (px.rect:height area)))
                         (px.sprite:draw group target)))))))

(test render-updates-keeps-removed-damage-when-draw-also-clears-background
  (with-render-updates-surfaces ((image (px.surface:make-surface '(1 1)))
                                 (background (px.surface:make-surface '(3 1)))
                                 (target (px.surface:make-surface '(3 1))))
    (px.surface:fill image '(90 0 0))
    (px.surface:fill background '(10 0 0))
    (let* ((sprite (px:make-sprite :image image :rect (px.rect:make-rect 1 0 1 1)))
           (group (px.sprite:make-render-updates-group sprite)))
      (px.sprite:draw group target)
      (px.sprite:remove group sprite)
      (px.sprite:clear group target background)
      (is (= 10 (px.color:r (px.surface:get-at target '(1 0)))))
      (is (equal '((1 0 1 1))
                 (mapcar (lambda (area) (list (px.rect:x area) (px.rect:y area)
                                               (px.rect:width area) (px.rect:height area)))
                         (px.sprite:draw group target)))))))

(test render-updates-preserves-lost-and-painted-bounds-after-blit-error
  (with-render-updates-surfaces ((image (px.surface:make-surface '(1 1)))
                                 (target (px.surface:make-surface '(3 1))))
    (px.surface:fill image '(90 0 0))
    (let* ((removed (px:make-sprite :image image))
           (remaining (px:make-sprite :image image
                                     :rect (px.rect:make-rect 1 0 1 1)))
           (group (px.sprite:make-render-updates-group removed remaining)))
      (px.sprite:draw group target)
      (px.sprite:remove group removed)
      (setf (px.sprite:image remaining) :invalid-surface)
      (signals error (px.sprite:draw group target))
      (setf (px.sprite:image remaining) image)
      (is (equal '((0 0 1 1) (1 0 1 1))
                 (mapcar (lambda (area) (list (px.rect:x area) (px.rect:y area)
                                               (px.rect:width area) (px.rect:height area)))
                         (px.sprite:draw group target)))))))

(test render-updates-reports-partial-draw-after-later-blit-error
  (with-render-updates-surfaces ((image (px.surface:make-surface '(1 1)))
                                 (background (px.surface:make-surface '(6 1)))
                                 (target (px.surface:make-surface '(6 1))))
    (px.surface:fill image '(90 0 0))
    (px.surface:fill background '(10 0 0))
    (let* ((first (px:make-sprite :image image))
           (second (px:make-sprite :image image
                                   :rect (px.rect:make-rect 2 0 1 1)))
           (group (px.sprite:make-render-updates-group first second)))
      (px.sprite:draw group target background)
      (setf (px.sprite:rect first) (px.rect:make-rect 1 0 1 1)
            (px.sprite:image second) :invalid-surface)
      (signals error (px.sprite:draw group target))
      ;; The first blit painted x=1 before the second sprite failed.
      (is (= 90 (px.color:r (px.surface:get-at target '(1 0)))))
      (setf (px.sprite:rect first) (px.rect:make-rect 4 0 1 1)
            (px.sprite:image second) image)
      (let ((damage (px.sprite:draw group target background)))
        (is (equal '((1 0 1 1) (4 0 1 1) (0 0 1 1) (2 0 1 1))
                   (mapcar (lambda (area) (list (px.rect:x area) (px.rect:y area)
                                                 (px.rect:width area) (px.rect:height area)))
                           damage)))
        (is (= 10 (px.color:r (px.surface:get-at target '(1 0)))))))))
