(in-package #:pixelisp.examples.tests)
(in-suite examples)

(test orbit-patrol-weapon-and-objective-state
  (let ((state (px.examples::%orbit-patrol-new-state)))
    (is (px.examples::%orbit-patrol-fire state))
    (is (= 1 (length (px.examples::%orbit-patrol-state-bullets state))))
    (is (not (px.examples::%orbit-patrol-fire state)))
    (is (= 0 (getf (px.examples::%orbit-patrol-snapshot state) :score)))
    (let ((target (first (px.examples::%orbit-patrol-state-targets state))))
      (px.examples::%orbit-patrol-remove-target state target)
      (is (not (member target (px.examples::%orbit-patrol-state-targets state) :test #'eq)))
      (is (= 100 (px.examples::%orbit-patrol-state-score state))))
    (dotimes (index 11) (declare (ignore index)) (px.examples::%orbit-patrol-hit state))
    (let ((snapshot (px.examples::%orbit-patrol-snapshot state)))
      (is (eq :won (getf snapshot :status)))
      (is (= 12 (getf snapshot :kills)))
      (is (= 1200 (getf snapshot :score)))
      (is (= 0 (getf snapshot :remaining))))))

(test orbit-patrol-fired-bolts-and-steering-share-heading
  (let ((state (px.examples::%orbit-patrol-new-state)))
    (px.examples::%orbit-patrol-fire state)
    (let ((bolt (first (px.examples::%orbit-patrol-state-bullets state))))
      (is (< (abs (px.examples::%orbit-actor-vx bolt)) 1d-8))
      (is (< (px.examples::%orbit-actor-vy bolt) 0d0)))
    (let ((right-facing (px.examples::%orbit-patrol-new-state)))
      (setf (px.examples::%orbit-patrol-state-angle right-facing) 90d0)
      (px.examples::%orbit-patrol-fire right-facing)
      (let ((bolt (first (px.examples::%orbit-patrol-state-bullets right-facing))))
        (is (> (px.examples::%orbit-actor-vx bolt) 0d0))
        (is (< (abs (px.examples::%orbit-actor-vy bolt)) 1d-8)))
      (px.examples::%orbit-patrol-steer right-facing (/ 1d0 60d0) 0 t)
      (is (> (px.examples::%orbit-patrol-state-vx right-facing) 0d0))
      (is (< (abs (px.examples::%orbit-patrol-state-vy right-facing)) 1d-8)))))

(test orbit-patrol-shot-resolution-and-time-based-drag
  (let* ((state (px.examples::%orbit-patrol-new-state))
         (target (first (px.examples::%orbit-patrol-state-targets state)))
         (shot (px.examples::%make-orbit-actor
                :kind :bolt :x (px.examples::%orbit-actor-x target)
                :y (px.examples::%orbit-actor-y target))))
    (setf (px.examples::%orbit-patrol-state-targets state) (list target)
          (px.examples::%orbit-patrol-state-bullets state) (list shot))
    (is (= 1 (px.examples::%orbit-patrol-resolve-shots
              state (lambda (&rest actors) (declare (ignore actors)) t))))
    (is (null (px.examples::%orbit-patrol-state-targets state)))
    (is (null (px.examples::%orbit-patrol-state-bullets state)))
    (is (= 100 (px.examples::%orbit-patrol-state-score state))))
  (let ((one-frame (px.examples::%orbit-patrol-new-state))
        (two-half-frames (px.examples::%orbit-patrol-new-state)))
    (setf (px.examples::%orbit-patrol-state-vx one-frame) 100d0
          (px.examples::%orbit-patrol-state-vx two-half-frames) 100d0)
    (px.examples::%orbit-patrol-steer one-frame (/ 1d0 60d0) 0 nil)
    (dotimes (index 2)
      (declare (ignore index))
      (px.examples::%orbit-patrol-steer two-half-frames (/ 1d0 120d0) 0 nil))
    (is (< (abs (- (px.examples::%orbit-patrol-state-vx one-frame)
                   (px.examples::%orbit-patrol-state-vx two-half-frames))) 1d-8))))

(test orbit-patrol-shield-loss-and-reset
  (let ((state (px.examples::%orbit-patrol-new-state)))
    (px.examples::%orbit-patrol-damage state)
    (is (= 2 (px.examples::%orbit-patrol-state-lives state)))
    (is (> (px.examples::%orbit-patrol-state-invulnerable state) 0))
    ;; Repeated contact inside the shield window cannot remove another life.
    (px.examples::%orbit-patrol-damage state)
    (is (= 2 (px.examples::%orbit-patrol-state-lives state)))
    (setf (px.examples::%orbit-patrol-state-invulnerable state) 0d0)
    (px.examples::%orbit-patrol-damage state)
    (setf (px.examples::%orbit-patrol-state-invulnerable state) 0d0)
    (px.examples::%orbit-patrol-damage state)
    (is (eq :lost (px.examples::%orbit-patrol-state-status state)))
    (let* ((fresh (px.examples::%orbit-patrol-reset-state))
           (snapshot (px.examples::%orbit-patrol-snapshot fresh)))
      (is (eq :playing (getf snapshot :status)))
      (is (= 3 (getf snapshot :lives)))
      (is (= 0 (getf snapshot :score)))
      (is (= 0 (getf snapshot :kills)))
      (is (= 4 (length (px.examples::%orbit-patrol-state-targets fresh)))))))
