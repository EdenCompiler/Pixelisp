;;;; Surface queries expose ordinary Lisp values while respecting native owners.
(in-package #:pixelisp.tests)
(in-suite pixelisp)

(test subsurface-coordinate-and-parent-queries
  (px.surface:with-surface (root '(12 8) :alpha t)
    (px:with-resource (child (px.surface:subsurface root '(3 2 6 5)))
      (px:with-resource (grandchild (px.surface:subsurface child '(1 2 2 2)))
        (is (null (px.surface:get-parent root)))
        (is (eq root (px.surface:get-abs-parent root)))
        (is (eq child (px.surface:get-parent grandchild)))
        (is (eq root (px.surface:get-abs-parent grandchild)))
        (is (equal '(1 2) (px.surface:get-offset grandchild)))
        (is (equal '(4 4) (px.surface:get-abs-offset grandchild)))
        (is (equal '(0 0) (px.surface:get-offset root)))
        (is (= (px.surface:get-pitch root) (px.surface:get-pitch grandchild)))
        (setf (first (px.surface:get-offset child)) 999)
        (is (equal '(3 2) (px.surface:get-offset child)))
        (px:dispose root)
        (signals px:disposed-resource (px.surface:get-abs-offset grandchild))))))

(test mapped-pixel-format-and-color-roundtrips
  (px.surface:with-surface (image '(2 2) :alpha t)
    (is (= 32 (px.surface:get-bitsize image)))
    (is (= 4 (px.surface:get-bytesize image)))
    (is (equal '(255 65280 16711680 4278190080) (px.surface:get-masks image)))
    (px.surface:set-at image '(1 1) '(17 34 51 68))
    (px.surface:set-clip image '(0 0 1 1))
    (let ((pixel (px.surface:map-rgb image #(17 34 51 68))))
      (is (= pixel (px.surface:get-at-mapped image '(1 1))))
      (is (equal '(17 34 51 68) (px.color:to-list (px.surface:unmap-rgb image pixel)))))
    (is (equal '(255 255 255 255) (px.color:to-list (px.surface:unmap-rgb image -1))))
    (signals error (px.surface:get-at-mapped image '(2 0)))
    (is (not (px.surface:locked-p image))))
  (px.surface:with-surface (image '(1 1))
    (is (= 0 (fourth (px.surface:get-masks image))))
    (is (= 255 (px:color-a (px.surface:unmap-rgb image (px.surface:map-rgb image '(1 2 3 4))))))))

(test imported-pixels-use-the-actual-layout
  (cffi:with-foreign-object (bytes :uint8 16)
    (dotimes (index 16) (setf (cffi:mem-aref bytes :uint8 index) 0))
    (px:with-resource (image (px.image:from-buffer bytes '(2 2) :bgra :byte-count 16))
      (px.surface:set-at image '(0 0) '(1 2 3 4))
      (is (equal '(16711680 65280 255 4278190080) (px.surface:get-masks image)))
      (is (= #x04010203 (px.surface:get-at-mapped image '(0 0))))
      (is (equal '(1 2 3 4)
                 (px.color:to-list (px.surface:unmap-rgb image #x04010203))))
      (is (null (px.surface:get-parent image)))
      (is (equal '(0 0) (px.surface:get-abs-offset image))))))
