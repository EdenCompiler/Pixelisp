(in-package #:pixelisp.tests)
(in-suite pixelisp)

(test scaled-readback-uses-physical-pixels-and-preserves-renderer-state
  (px:with-init ()
    (px.sdl2.video:with-window (window :size '(16 12) :hidden t)
      (px.sdl2.video:with-renderer (renderer window)
        ;; An 8x8 logical scene fits at scale 1.5, with two physical pixels
        ;; of letterboxing on either side. SDL reads the physical viewport.
        (setf (px.sdl2.video:logical-size renderer) '(8 8))
        (px.sdl2.video:clear renderer '(10 20 30 255))
        (setf (px.sdl2.video:draw-color renderer) '(40 180 90 255))
        (px.sdl2.video:fill-rect renderer '(0 0 8 8))
        (flet ((pixel (surface position)
                 (px.color:to-list (px.surface:get-at surface position))))
          (let ((before-viewport (px.sdl2.video:viewport renderer))
                (before-scale (px.sdl2.video:renderer-scale renderer)))
            (px:with-resource (capture (px.sdl2.video:to-surface renderer))
              (is (equal '(16 12) (px.surface:size capture)))
              (is (equal '(40 180 90 255) (pixel capture '(2 0))))
              (is (equal '(40 180 90 255) (pixel capture '(13 11))))
              (is (equal '(0 0 0 0) (pixel capture '(0 5)))))
            (px.surface:with-surface (destination '(16 12) :alpha t)
              (px.surface:fill destination '(7 8 9 123))
              (px.sdl2.video:to-surface renderer :surface destination)
              (is (equal '(7 8 9 123) (pixel destination '(15 5))))
              (is (equal '(40 180 90 255) (pixel destination '(2 5)))))
            (px:with-resource (crop (px.sdl2.video:to-surface renderer :area '(4 1 3 2)))
              (is (equal '(3 2) (px.surface:size crop)))
              (is (equal '(40 180 90 255) (pixel crop '(2 1)))))
            (is (equal before-viewport (px.sdl2.video:viewport renderer)))
            (is (equal before-scale (px.sdl2.video:renderer-scale renderer)))
            (is (equal '(8 8) (px.sdl2.video:logical-size renderer)))))))))

(test renderer-readback-respects-native-format-padding-and-locks
  (px:with-init ()
    (px.sdl2.video:with-window (window :size '(4 4) :hidden t)
      (px.sdl2.video:with-renderer (renderer window)
        (px.sdl2.video:clear renderer '(11 72 203 255))
        (cffi:with-foreign-object (bytes :uint8 64)
          (dotimes (index 64) (setf (cffi:mem-aref bytes :uint8 index) 0))
          (px:with-resource (parent (px.image:from-buffer bytes '(4 4) :bgra :byte-count 64))
            (px:with-resource (child (px.surface:subsurface parent '(1 1 2 2)))
              ;; Readback is a pixel copy, so the drawing clip does not hide data.
              (px.surface:set-clip child '(0 0 1 1))
              (is (eq child (px.sdl2.video:to-surface renderer :area '(0 0 2 2) :surface child)))
              (is (equal '(11 72 203 255) (px.color:to-list (px.surface:get-at parent '(2 2)))))
              (is (equal '(0 0 0 0) (px.color:to-list (px.surface:get-at parent '(0 0)))))
              ;; The output format is BGRA, not the renderer's canonical RGBA.
              (is (= 203 (cffi:mem-aref bytes :uint8 20)))
              (px.buffer:with-view (alpha (px.surface:get-view child "A"))
                (signals error
                  (px.sdl2.video:to-surface renderer :area '(0 0 2 2) :surface child))
                (is (= 255 (px.buffer:view-ref alpha 1 1))))
              (is (not (px.surface:locked-p child))))))
        (signals type-error (px.sdl2.video:to-surface window))
        (signals type-error (px.sdl2.video:target window))))))

(test renderer-controls-and-target-readback
  (px:with-init (:video t)
    (pixelisp.sdl2.video:with-window (window :size '(24 20) :hidden t)
      (pixelisp.sdl2.video:with-renderer (renderer window)
        (progn
          (setf (pixelisp.sdl2.video:draw-blend-mode renderer) :none
                (pixelisp.sdl2.video:logical-size renderer) '(12 10)
                (pixelisp.sdl2.video:renderer-scale renderer) '(1.0 1.0)
                (pixelisp.sdl2.video:viewport renderer) '(0 0 12 10))
          (is (eq :none (pixelisp.sdl2.video:draw-blend-mode renderer)))
          (is (equal '(12 10) (pixelisp.sdl2.video:logical-size renderer)))
          (is (equal '(1.0 1.0) (pixelisp.sdl2.video:renderer-scale renderer)))
          (is (equal '(0 0 12 10) (pixelisp.sdl2.video:viewport renderer)))
          (setf (pixelisp.sdl2.video:logical-size renderer) '(0 0)
                (pixelisp.sdl2.video:viewport renderer) nil)
          (signals type-error (setf (pixelisp.sdl2.video:renderer-scale renderer) '(0 1)))
          (signals type-error (setf (pixelisp.sdl2.video:logical-size renderer) '(0 4)))
          (is (equal '(1.0 1.0) (pixelisp.sdl2.video:renderer-scale renderer)))
          (setf (pixelisp.sdl2.video:draw-color renderer) '(0 0 0 255))
          (pixelisp.sdl2.video:clear renderer)
          (setf (pixelisp.sdl2.video:draw-color renderer) '(240 20 10 255))
          (pixelisp.sdl2.video:draw-rect renderer '(2 2 3 3))
          (let ((copy (pixelisp.sdl2.video:to-surface renderer :area '(2 2 3 3))))
            (unwind-protect
                 (progn
                   (is (equal '(240 20 10 255) (px.color:to-list (pixelisp.surface:get-at copy '(0 0)))))
                   (is (equal '(0 0 0 255) (px.color:to-list (pixelisp.surface:get-at copy '(1 1)))))
                   (let* ((parent (pixelisp.surface:make-surface '(4 4) :alpha t))
                          (borrowed (pixelisp.surface:subsurface parent '(1 1 2 2))))
                     (unwind-protect
                          (progn
                            (pixelisp.sdl2.video:to-surface renderer :area '(2 2 2 2) :surface borrowed)
                            (is (equal '(240 20 10 255) (px.color:to-list (pixelisp.surface:get-at parent '(1 1))))))
                       (pixelisp.surface:dispose borrowed)
                       (pixelisp.surface:dispose parent)))
                   (signals error (pixelisp.sdl2.video:to-surface renderer :area '(23 19 2 2))))
              (pixelisp.surface:dispose copy)))
          (when (pixelisp.sdl2.video:target-supported-p renderer)
            (let ((outer (pixelisp.sdl2.video:make-texture renderer '(4 4) :access :target))
                  (inner (pixelisp.sdl2.video:make-texture renderer '(2 2) :access :target)))
              (unwind-protect
                   (progn
                     (pixelisp.sdl2.video:with-render-target (renderer outer)
                       (is (eq outer (pixelisp.sdl2.video:target renderer)))
                       (setf (pixelisp.sdl2.video:draw-color renderer) '(240 20 10 255))
                       (pixelisp.sdl2.video:clear renderer)
                       (setf (pixelisp.sdl2.video:target renderer) nil)
                       (is (null (pixelisp.sdl2.video:target renderer)))
                       (setf (pixelisp.sdl2.video:draw-color renderer) '(0 40 0 255))
                       (pixelisp.sdl2.video:clear renderer)
                       (let ((window-copy (pixelisp.sdl2.video:to-surface renderer)))
                         (unwind-protect
                              (is (equal '(0 40 0 255) (px.color:to-list (pixelisp.surface:get-at window-copy '(0 0)))))
                           (pixelisp.surface:dispose window-copy)))
                       (setf (pixelisp.sdl2.video:target renderer) outer)
                       (setf (pixelisp.sdl2.video:draw-color renderer) '(240 20 10 255))
                       (signals error
                         (pixelisp.sdl2.video:with-render-target (renderer inner)
                           (error "exercise target restoration")))
                     (is (eq outer (pixelisp.sdl2.video:target renderer)))
                       (let ((values (multiple-value-list
                                      (pixelisp.sdl2.video:with-render-target (renderer inner) (values :one :two)))))
                         (is (equal '(:one :two) values)))
                       (let ((copy (pixelisp.sdl2.video:to-surface renderer)))
                         (unwind-protect
                              (is (equal '(240 20 10 255) (px.color:to-list (pixelisp.surface:get-at copy '(0 0)))))
                           (pixelisp.surface:dispose copy))))
                     (is (null (pixelisp.sdl2.video:target renderer)))
                     (signals error (setf (pixelisp.sdl2.video:target renderer)
                                          (pixelisp.sdl2.video:make-texture renderer '(1 1))))
                     (pixelisp.sdl2.video:with-window (other-window :size '(8 8) :hidden t)
                       (pixelisp.sdl2.video:with-renderer (other-renderer other-window)
                         (let ((foreign (pixelisp.sdl2.video:make-texture other-renderer '(2 2) :access :target)))
                           (unwind-protect
                                (signals pixelisp:error (setf (pixelisp.sdl2.video:target renderer) foreign))
                             (pixelisp.sdl2.video:close foreign)))))
                     (let ((disposed (pixelisp.sdl2.video:make-texture renderer '(2 2) :access :target)))
                       (pixelisp.sdl2.video:with-render-target (renderer disposed)
                         (pixelisp.sdl2.video:close disposed))
                       (is (null (pixelisp.sdl2.video:target renderer))))
                     (let ((closed (pixelisp.sdl2.video:make-texture renderer '(2 2) :access :target)))
                       (pixelisp.sdl2.video:close closed)
                       (signals pixelisp:disposed-resource
                         (setf (pixelisp.sdl2.video:target renderer) closed)))
                (pixelisp.sdl2.video:close inner)
                (pixelisp.sdl2.video:close outer))))))))))
