(in-package #:pixelisp.tests)
(in-suite pixelisp)

(test rectangle-scalar-centers-truncate-and-preserve-odd-size
  (let ((r (px:make-rect 4 7 5 3)))
    (is (= 6 (px.rect:center-x r)))
    (is (= 8 (px.rect:center-y r)))
    (setf (px.rect:center-x r) 12.9
          (px.rect:center-y r) -3.9)
    (is (equal '(10 -4 5 3) (list (px.rect:x r) (px.rect:y r)
                                  (px.rect:width r) (px.rect:height r))))
    (signals type-error (setf (px.rect:center-x r) 'bad))
    (is (= 10 (px.rect:x r)))))

(test rectangle-clamp-and-union-in-place
  (let ((bounds (px:make-rect 0 0 10 8))
        (r (px:make-rect 20 -5 3 5)))
    (is (eq r (px.rect:clamp-ip r bounds)))
    (is (equal '(7 0 3 5) (list (px.rect:x r) (px.rect:y r)
                                 (px.rect:width r) (px.rect:height r))))
    (is (eq r (px.rect:union-ip r (px:make-rect -3 2 12 9))))
    (is (equal '(-3 0 13 11) (list (px.rect:x r) (px.rect:y r)
                                    (px.rect:width r) (px.rect:height r))))
    (is (eq r (px.rect:union-all-ip r (list (px:make-rect 20 20 2 2)))))
    (is (equal '(-3 0 25 22) (list (px.rect:x r) (px.rect:y r)
                                    (px.rect:width r) (px.rect:height r))))
    (signals type-error (px.rect:union-all-ip r (list (px:make-rect 0 0 1 1) :bad)))
    (is (equal '(-3 0 25 22) (list (px.rect:x r) (px.rect:y r)
                                    (px.rect:width r) (px.rect:height r))))))

(test rectangle-scale-by-center-rounding-and-atomic-validation
  (let* ((r (px:make-rect 5 8 5 3))
         (scaled (px.rect:scale-by r 2 0.5))
         (paired (px.rect:scale-by r #(2 0.5))))
    ;; Match pygame's integer half-size convention and truncated dimensions.
    (is (equal '(2 8 10 1) (list (px.rect:x scaled) (px.rect:y scaled)
                                  (px.rect:width scaled) (px.rect:height scaled))))
    (is (equal '(2 8 10 1) (list (px.rect:x paired) (px.rect:y paired)
                                  (px.rect:width paired) (px.rect:height paired))))
    ;; pygame treats a zero second factor as the first factor.
    (is (equal '(4 7 5 3)
               (let ((same (px.rect:scale-by r 1 0)))
                 (list (px.rect:x same) (px.rect:y same)
                       (px.rect:width same) (px.rect:height same)))))
    (is (equal '(5 8 5 3) (list (px.rect:x r) (px.rect:y r)
                                 (px.rect:width r) (px.rect:height r))))
    (is (eq r (px.rect:scale-by-ip r -2)))
    (is (equal '(2 6 10 6) (list (px.rect:x r) (px.rect:y r)
                                  (px.rect:width r) (px.rect:height r))))
    (signals type-error (px.rect:scale-by-ip r 2 'bad))
    (is (equal '(2 6 10 6) (list (px.rect:x r) (px.rect:y r)
                                  (px.rect:width r) (px.rect:height r))))
    (is (equal '(7 9 0 0) (let ((zero (px.rect:scale-by r 0)))
                             (list (px.rect:x zero) (px.rect:y zero)
                                   (px.rect:width zero) (px.rect:height zero)))))))

(test rectangle-collide-objects-accepts-list-vector-and-key
  (let* ((r (px:make-rect 0 0 10 10))
         (objects (list (cons :miss (px:make-rect 10 0 1 1))
                        (cons :hit (px:make-rect 2 2 1 1))
                        (cons :also (px:make-rect 9 9 2 2)))))
    (is (eq (second objects)
            (px.rect:collide-objects r objects :key #'cdr)))
    (is (equal (rest objects)
               (px.rect:collide-objects-all r (coerce objects 'vector) :key #'cdr)))
    (is (null (px.rect:collide-objects r nil)))))

(test rectangle-collide-dict-returns-entries-and-selects-key-or-value
  (let* ((r (px:make-rect 0 0 10 10))
         (table (make-hash-table :test #'eq))
         (miss (px:make-rect 10 0 1 1))
         (hit (px:make-rect 1 1 2 2))
         (value-hit (px:make-rect 8 8 2 2))
         (value-miss (px:make-rect 10 0 1 1)))
    (setf (gethash miss table) value-hit
          (gethash hit table) value-miss)
    (is (equal (cons hit value-miss) (px.rect:collide-dict r table)))
    (is (equal (list (cons hit value-miss)) (px.rect:collide-dict-all r table)))
    (is (equal (cons miss value-hit) (px.rect:collide-dict r table :use-values t)))
    (is (equal (list (cons miss value-hit))
               (px.rect:collide-dict-all r table :use-values t)))
    (signals type-error (px.rect:collide-dict r (list :not-a-table)))))
