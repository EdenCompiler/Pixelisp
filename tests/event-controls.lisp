(in-package #:pixelisp.tests)
(in-suite pixelisp)

(test event-blocking-queries-handle-single-and-sequence-types
  (let ((pixelisp.event::*blocked* (make-hash-table))
        (pixelisp.event::*allowed* (make-hash-table))
        (pixelisp.event::*all-blocked* nil)
        (pixelisp.event::*queue* nil))
    (is (null (px.event:get-blocked :custom-a)))
    (is (null (px.event:get-blocked nil)))
    (is (null (px.event:get-blocked #())))
    (px.event:set-blocked #())
    (is (null (px.event:get-blocked :custom-a)))
    (px.event:set-blocked :custom-a)
    (is (px.event:get-blocked :custom-a))
    (is (px.event:get-blocked #(:custom-b :custom-a)))
    (is (px.event:get-blocked '(:custom-b :custom-a)))
    (px.event:post (px.event:make-event :custom-a))
    (px.event:post (px.event:make-event :custom-b))
    (is (equal '(:custom-b) (mapcar #'px.event:type pixelisp.event::*queue*)))
    (px.event:set-allowed #(:custom-a))
    (is (null (px.event:get-blocked '(:custom-a :custom-b))))
    (px.event:set-blocked '(101 102))
    (is (px.event:get-blocked '(999 102)))
    (px.event:set-allowed 102)
    (is (null (px.event:get-blocked 102)))
    (px.event:set-blocked nil)
    (is (px.event:get-blocked :everything))
    (is (null pixelisp.event::*queue*))
    (px.event:set-allowed :special)
    (is (px.event:get-blocked :ordinary))
    (is (null (px.event:get-blocked :special)))
    (px.event:post (px.event:make-event :special))
    (px.event:post (px.event:make-event :ordinary))
    (is (equal '(:special) (mapcar #'px.event:type pixelisp.event::*queue*)))
    (px.event:set-allowed nil)
    (is (null (px.event:get-blocked :ordinary)))
    ;; Reject a whole invalid request before changing an earlier valid type.
    (signals error (px.event:set-blocked '(:custom-a "bad")))
    (is (not (px.event:get-blocked :custom-a)))
    (px.event:post (px.event:make-event :custom-a))
    (px.event:set-blocked :custom-a)
    (is (not (find :custom-a pixelisp.event::*queue* :key #'px.event:type)))))

(test event-names-are-readable-and-stable
  (is (string= "KeyDown" (px.event:event-name :key-down)))
  (is (string= "KeyDown" (px.event:event-name 768)))
  (is (string= "WindowEvent" (px.event:event-name :window-event)))
  (is (string= "MouseWheel" (px.event:event-name :mouse-wheel)))
  (is (string= "JoyAxisMotion" (px.event:event-name :joy-axis-motion)))
  (is (string= "JoyDeviceAdded" (px.event:event-name :joydeviceadded)))
  (is (string= "ControllerTouchpadDown" (px.event:event-name :controllertouchpaddown)))
  (is (string= "AudioDeviceAdded" (px.event:event-name :audiodeviceadded)))
  (is (string= "DropFile" (px.event:event-name :dropfile)))
  (let ((name (px.event:event-name :quit)))
    (setf (char name 0) #\X)
    (is (string= "Quit" (px.event:event-name :quit))))
  (is (string= "UserEvent (32769)" (px.event:event-name #x8001)))
  (is (search "UserEvent" (px.event:event-name (px.event:custom-type))))
  (is (string= "Unknown (999)" (px.event:event-name 999)))
  (is (string= "Unknown (:MY-APP-EVENT)" (px.event:event-name :my-app-event))))

(test window-grabs-require-video-and-a-current-display
  (let ((pixelisp.internal:*initialized* nil)
        (pixelisp.internal:*video-thread* nil)
        (px.display::*window* nil))
    (signals px:initialization-error (px.event:get-grab))
    (signals px:initialization-error (px.event:set-grab t))
    (signals px:initialization-error (px.event:get-keyboard-grab))
    (signals px:initialization-error (px.event:set-keyboard-grab t)))
  (let ((pixelisp.internal:*initialized* t)
        (pixelisp.internal:*video-thread* (gensym "NON-OWNER-THREAD")))
    (signals px:initialization-error (px.event:get-grab)))
  (px:with-init ()
    (signals px:initialization-error (px.event:get-grab))
    (signals px:initialization-error (px.event:get-keyboard-grab))))

(test window-grabs-release-and-capability-errors
  (px:with-init ()
    (unwind-protect
         (progn
           (px.display:set-mode '(32 24))
           (px.event:set-grab t)
           (px.event:set-grab nil)
           (is (not (px.event:get-grab)))
           (if (cffi:foreign-symbol-pointer "SDL_SetWindowKeyboardGrab")
               (progn
                 (px.event:set-keyboard-grab t)
                 (px.event:set-keyboard-grab nil)
                 (is (not (px.event:get-keyboard-grab))))
               (signals px:unsupported-feature (px.event:set-keyboard-grab t)))
           (signals px:unsupported-feature
             (px.event::%native-grab-call '("SDL_Pixelisp_Missing_Grab") :void t)))
      (when px.display::*window*
        (ignore-errors (px.event:set-grab nil))
        (ignore-errors (px.event:set-keyboard-grab nil))
        (px.display:quit)))))

(test opt-in-x11-window-grabs-are-independent
  (if (not (equal "1" (uiop:getenv "PIXELISP_TEST_X11")))
      (skip "Set PIXELISP_TEST_X11=1 under Xvfb to check active window grabs.")
      (px:with-init ()
        (px.display:set-mode '(64 48))
        (let ((window (pixelisp.internal:%ptr (px.display:get-window))))
          ;; Focus an isolated Xvfb window, then let SDL observe the X11 events.
          ;; The loop is bounded so a backend/focus failure cannot hang the runner.
          (cffi:foreign-funcall "SDL_RaiseWindow" :pointer window :void)
          (cffi:foreign-funcall "SDL_SetWindowInputFocus" :pointer window :int)
          (loop repeat 50 until (px.key:get-focused) do
            (px.event:pump)
            (px.time:delay 5))
          (is (px.key:get-focused))
          (unwind-protect
               (progn
                 (px.event:set-keyboard-grab t)
                 (is (px.event:get-keyboard-grab))
                 (is (not (px.event:get-grab)))
                 (px.event:set-grab t)
                 (is (px.event:get-grab))
                 (is (px.event:get-keyboard-grab))
                 (px.event:set-grab nil)
                 (is (px.event:get-keyboard-grab)))
            (px.event:set-grab nil)
            (px.event:set-keyboard-grab nil))))))
