;;;; Surface metadata and batched blits against real SDL software surfaces.
(in-package #:pixelisp.tests)
(in-suite pixelisp)

(test surface-channel-layout-and-native-blend-queries
  (cffi:with-foreign-object (bytes :uint8 24)
    (dotimes (index 24) (setf (cffi:mem-aref bytes :uint8 index) 0))
    (px:with-resource (bgra (px.image:from-buffer bytes '(2 3) :bgra :byte-count 24))
      (is (equal '(16 8 0 24) (px.surface:get-shifts bgra)))
      (is (equal '(0 0 0 0) (px.surface:get-losses bgra)))
      ;; The child is only one pixel wide but retains the parent's 8-byte pitch.
      (px:with-resource (child (px.surface:subsurface bgra '(1 0 1 3)))
        (is (= 8 (px.surface:get-pitch child)))
        (is (equal '(16 8 0 24) (px.surface:get-shifts child)))
        (px.surface:set-at child '(0 1) '(11 22 33 44))
        (is (equal '(11 22 33 44) (px.color:to-list (px.surface:get-at bgra '(1 1)))))
        (is (equal '(0 0 0 0) (px.color:to-list (px.surface:get-at bgra '(0 1)))))))
  (px.surface:with-surface (opaque '(1 1))
    (is (equal '(0 8 16 0) (px.surface:get-shifts opaque)))
    (is (equal '(0 0 0 8) (px.surface:get-losses opaque)))
    (is (eq :none (px.surface:get-blendmode opaque)))
    (px.surface:set-alpha opaque 128)
    (is (eq :blend (px.surface:get-blendmode opaque)))
    (px.surface:set-alpha opaque nil)
    (is (eq :none (px.surface:get-blendmode opaque))))
  (let ((dead (px.surface:make-surface '(1 1) :alpha t)))
    (px:dispose dead)
    (signals px:disposed-resource (px.surface:get-shifts dead))
    (signals px:disposed-resource (px.surface:get-losses dead))
    (signals px:disposed-resource (px.surface:get-blendmode dead))
    (signals px:disposed-resource (px.surface:blits dead nil)))))

(test get-rect-supports-every-rect-anchor
  (px.surface:with-surface (image '(7 5))
    (dolist (fixture '((:topright (10 20) (3 20))
                       (:bottomleft (10 20) (10 15))
                       (:bottomright (10 20) (3 15))
                       (:mid-top (10 20) (7 20))
                       (:midleft (10 20) (10 18))
                       (:midbottom (10 20) (7 15))
                       (:midright (10 20) (3 18))))
      (let* ((key (first fixture)) (anchor (second fixture))
             (rect (funcall #'px.surface:get-rect image key anchor)))
        (is (equal (third fixture) (px.rect:top-left rect)))))
    (is (equal '(10 20) (px.rect:top-left (px.surface:get-rect image :topleft '(10 20)))))
    (let ((rect (px.surface:get-rect image :center '(10 20))))
      (is (equal '(10 20) (px.rect:center rect)))
      (is (equal '(7 18) (px.rect:top-left rect))))
    (let ((rect (px.surface:get-rect image :x 10.9 :center-y 4.9)))
      (is (= 10 (px.rect:x rect)))
      (is (= 2 (px.rect:y rect))))
    (is (= 3 (px.rect:left (px.surface:get-rect image :centerx 20 :left 3))))
    (signals type-error (px.surface:get-rect image :topright '(1 "bad")))))

(test batched-blits-accept-positional-keyword-and-vector-entries
  (px.surface:with-surface (target '(4 1) :alpha t)
    (px.surface:with-surface (source '(2 1) :alpha t)
      (px.surface:set-at source '(0 0) '(10 0 0 255))
      (px.surface:set-at source '(1 0) '(20 0 0 255))
      (px.surface:fill target '(5 0 0 255))
      (px.surface:set-clip target '(1 0 1 1))
      (let ((damage (px.surface:blits
                     target (vector (vector source #(0 0) #(0 0 2 1))
                                    (list source '(1 0) :area '(0 0 1 1)
                                          :special-flags :blend-add)))))
        (is (= 2 (length damage)))
        (is (equal '((1 0 1 1) (1 0 1 1))
                   (mapcar (lambda (r) (list (px.rect:x r) (px.rect:y r)
                                             (px.rect:width r) (px.rect:height r))) damage)))
        ;; First entry writes 20; the next entry applies channel addition at
        ;; the same clipped pixel, proving input order and positional parsing.
        (is (equal '(30 0 0 255) (px.color:to-list (px.surface:get-at target '(1 0))))))
      (px.surface:fill target '(5 0 0 255))
      (is (null (px.surface:blits target (list (vector source '(1 0) '(1 0 1 1))
                                                (list source '(1 0) '(0 0 1 1)))
                                  :return-rects nil)))
      (is (equal '(10 0 0 255) (px.color:to-list (px.surface:get-at target '(1 0))))))))
