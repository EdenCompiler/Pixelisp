;;;; Emit a small JSON fixture for the optional pygame differential check.
;;;; This is test tooling; the library has no Python dependency.
(load (merge-pathnames "bootstrap.lisp" *load-truename*))
(ql:quickload '("pixelisp" "pixelisp/freetype") :silent t)

(defun fixture-rect-values (rect)
  (list (px.rect:x rect) (px.rect:y rect) (px.rect:width rect) (px.rect:height rect)))
(defun fixture-red-values (surface)
  (loop for y below (px.surface:height surface) append
    (loop for x below (px.surface:width surface)
          collect (px:color-r (px.surface:get-at surface (list x y))))))
(defun fixture-zero-radius-circle ()
  (px.surface:with-surface (surface '(3 3) :alpha t)
    (px.surface:fill surface '(1 2 3 4))
    (let ((damage (px.draw:circle surface '(255 255 0) '(1 1) 0)))
      (list (px.rect:width damage) (px.rect:height damage)
            (px.color:to-list (px.surface:get-at surface '(1 1)))))))

(defun fixture-channel-blends ()
  (px.surface:with-surface (source '(1 1) :alpha t)
    (px.surface:with-surface (target '(1 1) :alpha t)
      (px.surface:fill source '(200 50 128 40))
      (px.surface:set-alpha source 3)
      (px.surface:set-colorkey source '(200 50 128))
      (loop for flag in '(:blend-rgb-add :blend-rgb-sub :blend-rgb-mult :blend-rgb-min :blend-rgb-max
                         :blend-rgba-add :blend-rgba-sub :blend-rgba-mult :blend-rgba-min :blend-rgba-max)
            collect (progn
                      (px.surface:fill target '(100 80 60 120))
                      (px.surface:blit target source '(0 0) :special-flags flag)
                      (px.color:to-list (px.surface:get-at target '(0 0))))))))

(defun fixture-premultiplied-alpha ()
  (px.surface:with-surface (source '(3 1) :alpha t)
    (loop for x below 3 for alpha in '(0 128 255)
          do (px.surface:set-at source (list x 0) (list 200 50 128 alpha)))
    (px:with-resource (converted (px.surface:premul-alpha source))
      (px.surface:with-surface (target '(3 1) :alpha t)
        (px.surface:fill target '(100 80 60 120))
        (px.surface:blit target converted '(0 0) :special-flags :blend-premultiplied)
        (list (loop for x below 3 collect (px.color:to-list (px.surface:get-at converted (list x 0))))
              (loop for x below 3 collect (px.color:to-list (px.surface:get-at target (list x 0)))))))))

(defun fixture-fitted-rectangles ()
  (loop for dimensions in '((3 2) (2 3) (-5 3) (5 -3) (0 5))
        collect (fixture-rect-values
                 (px.rect:fit (apply #'px:make-rect 0 0 dimensions) (px:make-rect 1 1 8 8)))))

(defun fixture-clipped-lines ()
  (list (px.rect:clipline (px:make-rect 0 0 10 10) '(-3.9 -1.9 3.9 8.9))
        (px.rect:clipline (px:make-rect 0 0 10 10) '(3.9 -1.9 -3.9 8.9))
        (px.rect:clipline (px:make-rect 5 5 -10 10) '(-10 7 10 7))
        (px.rect:clipline (px:make-rect 0 0 10 10) '(10 0 10 10))))

(defun fixture-vector-movement ()
  (let ((start (px:make-vector2 0 0)))
    (loop for distance in '(5 -5 100)
          collect (mapcar #'round (px.math:components (px.math:move-towards start '(3 4) distance))))))

(defun fixture-color-conversions ()
  (let ((color (px:make-color 128 64 32 99)))
    (list (progn (setf (px.color:hsva color) '(120 50 50 50)) (px.color:to-list color))
          (progn (setf (px.color:hsla color) '(210 33.3 45.5 99.9)) (px.color:to-list color))
          (progn (setf (px.color:cmy color) '(0.5 0.125 0.875)) (px.color:to-list color))
          (px.color:to-list (px.color:correct-gamma (px:make-color 128 64 32 99) 0.5)))))

(defun fixture-pixel-colors (surface)
  (loop for y below (px.surface:height surface) append
    (loop for x below (px.surface:width surface)
          collect (px.color:to-list (px.surface:get-at surface (list x y))))))

(defun fixture-surface-details ()
  (px.surface:with-surface (root '(12 8) :alpha t)
    (px:with-resource (child (px.surface:subsurface root '(3 2 6 5)))
      (px:with-resource (grandchild (px.surface:subsurface child '(1 2 2 2)))
        (list (px.surface:get-offset grandchild) (px.surface:get-abs-offset grandchild)
              (px.surface:get-pitch grandchild) (px.surface:get-bitsize grandchild)
              (px.surface:get-bytesize grandchild)
              (px.color:to-list (px.surface:unmap-rgb root (px.surface:map-rgb root '(17 34 51 68)))))))))

(defun fixture-mask-painting ()
  (let ((mask (px.mask:make-mask '(3 2))))
    (dolist (point '((0 0) (2 0) (1 1))) (px.mask:set-at mask point))
    (px.surface:with-surface (target '(4 3) :alpha t)
      (px.surface:with-surface (plane '(1 1) :alpha t)
        (px.surface:fill target '(8 16 24 32))
        (px.surface:fill plane '(17 29 41 0))
        (px.surface:set-clip target '(1 1 3 2))
        (px.mask:to-surface mask :surface target :set-surface plane :dest '(1 1)
                            :set-color '(90 80 70 60) :unset-color nil)
        (fixture-pixel-colors target)))))

(defun fixture-mask-rect-anchors ()
  ;; Match pygame 2.6.1 Mask.get_rect forwarding anchor keywords to Rect.
  (let ((odd (px.mask:make-mask '(5 3))))
    (flet ((values-of (rect)
             (list (px.rect:x rect) (px.rect:y rect)
                   (px.rect:width rect) (px.rect:height rect))))
      (list (values-of (px.mask:get-rect odd :center #(10 5)))
            (values-of (px.mask:get-rect odd :topleft '(2 4)))
            (values-of (px.mask:get-rect odd :right 10 :bottom 9))
            (values-of (px.mask:get-rect odd :x 1 :left 7))
            (values-of (px.mask:get-rect (px.mask:make-mask '(0 0)) :center '(10 5)))
            (values-of (px.mask:get-rect (px.mask:make-mask '(0 3)) :midbottom '(5 8)))))))

(defun fixture-custom-blend-modes ()
  ;; Factor and operation values here are SDL's stable public enum integers.
  ;; Mix keywords and integers to cover both supported Lisp input forms.
  (list (pixelisp.sdl2.video:compose-custom-blend-mode '(:one :zero :add)
                                                       '(:one :zero :add))
        (pixelisp.sdl2.video:compose-custom-blend-mode
         '(:src-alpha :one-minus-src-alpha :add) '(:one :one-minus-src-alpha :add))
        (pixelisp.sdl2.video:compose-custom-blend-mode #(1 2 1) #(1 2 1))
        (pixelisp.sdl2.video:compose-custom-blend-mode
         '(3 4 :subtract) '(5 6 :rev-subtract))
        (pixelisp.sdl2.video:compose-custom-blend-mode
         #(:one-minus-dst-alpha :dst-alpha :maximum)
         #(:dst-color :one-minus-dst-color :minimum))
        (pixelisp.sdl2.video:compose-custom-blend-mode '(1 10 2) '(10 1 5))))

(defun fixture-freetype-face-information ()
  (px.freetype:init)
  (labels ((truth-value (value) (if value 1 0))
           (face-info (font size)
             (list (truth-value (px.freetype:scalable-p font))
                   (truth-value (px.freetype:fixed-width-p font))
                   (px.freetype:fixed-sizes font)
                   (px.freetype:height font)
                   (px.freetype:ascender font)
                   (px.freetype:descender font)
                   (px.freetype:get-sized-glyph-height font size)
                   (mapcar (lambda (record)
                             (list (first record) (second record) (third record)
                                   (round (fourth record)) (round (fifth record))))
                           (px.freetype:get-sizes font)))))
    (px:with-resource
        (outline (px.freetype:make-font
                  (asdf:system-relative-pathname "pixelisp" "assets/fonts/DejaVuSans.ttf") 20))
      (px:with-resource
          (bitmap (px.freetype:make-font
                   (asdf:system-relative-pathname "pixelisp/tests"
                                                  "tests/fixtures/tiny-mono.bdf") 8))
        (list (face-info outline 20) (face-info bitmap 8))))))

(defun fixture-laplacian ()
  (px.surface:with-surface (source '(3 3) :alpha t)
    (px.surface:set-at source '(1 1) '(20 30 40 50))
    (px:with-resource (edges (px.transform:laplacian source))
      (px.surface:fill source '(255 255 255 255))
      (px:with-resource (flat (px.transform:laplacian source))
        ;; The local reference leaves some corner samples undefined. Compare
        ;; interior responses; the Lisp tests separately verify white padding.
        (list (px.color:to-list (px.surface:get-at edges '(1 1)))
              (px.color:to-list (px.surface:get-at flat '(1 1))))))))

(defun fixture-single-group ()
  (let* ((first (px:make-sprite)) (second (px:make-sprite))
         (group (px.sprite:make-group-single first)))
    (px.sprite:add group second)
    (list (if (eq second (px.sprite:single-sprite group)) 1 0)
          (if (px.sprite:alive-p first) 1 0)
          (progn (setf (px.sprite:single-sprite group) first)
                 (if (px.sprite:alive-p second) 1 0))
          (progn (px.sprite:kill first) (px.sprite:group-size group)))))

(defun fixture-named-palette ()
  (mapcar (lambda (name) (px.color:to-list (px:make-color name))) (px.colordict:color-names)))

(defun fixture-color-inputs ()
  (mapcar (lambda (value) (px.color:to-list (px:make-color value)))
          '("Dark Slate Gray" "grey42" "#102030" "0x10203040" #x01020304 #(1 2 3))))

(defun fixture-color-operations ()
  (let ((color (px:make-color 200 50 128 128)))
    (list (px.color:to-list (px.color:grayscale color))
          (px.color:to-list (px.color:premul-alpha color))
          (progn (px.color:update-color color 1 2 3) (px.color:to-list color))
          (progn (px.color:update-color color '(4 5 6)) (px.color:to-list color))
          (px.color:to-integer "#10203040"))))

(defun fixture-rect-tools ()
  (let ((rect (px:make-rect 5 8 5 3)))
    (list (fixture-rect-values (px.rect:scale-by rect 2 1/2))
          (fixture-rect-values (px.rect:scale-by rect -2))
          (fixture-rect-values (px.rect:scale-by rect 1 0))
          (progn (setf (px.rect:center-x rect) 20 (px.rect:center-y rect) -5)
                 (fixture-rect-values rect))
          (fixture-rect-values (px.rect:clamp-ip rect (px:make-rect 0 0 30 30))))))

(defun fixture-object-collisions ()
  (let* ((bounds (px:make-rect 0 0 10 10))
         (objects (list (cons 1 (px:make-rect 2 2 1 1))
                        (cons 2 (px:make-rect 10 0 1 1))
                        (cons 3 (px:make-rect 9 9 2 2))))
         (table (make-hash-table)))
    (dolist (entry objects) (setf (gethash (car entry) table) (cdr entry)))
    (list (car (px.rect:collide-objects bounds objects :key #'cdr))
          (mapcar #'car (px.rect:collide-objects-all bounds (coerce objects 'vector) :key #'cdr))
          (sort (mapcar #'car (px.rect:collide-dict-all bounds table :use-values t)) #'<))))

(defun fixture-vector-api ()
  (let ((vector (px:make-vector2 3 4)))
    (list (mapcar #'round (px.math:components (px.math:scale-to-length vector 10)))
          (mapcar #'round (px.math:components (px.math:rotate-rad vector (/ pi 2))))
          (px.math:components (px.math:update-vector vector #(7 8)))
          (mapcar #'round (px.math:components (px.math:rotate-y-rad (px:make-vector3 0 0 1) (/ pi 2))))
          (px.math:clamp 5 10 0))))

(defun fixture-audio-completions ()
  (px:with-init (:video nil)
    (px.mixer:init :frequency 22050 :size -16 :channels 1 :buffer 256)
    (px:with-resource (sound (px.mixer:make-sound nil :buffer
                              (make-array 4410 :element-type '(unsigned-byte 8) :initial-element 0)))
      (let ((channel (px.mixer:make-channel 0)) (type (px.event:custom-type)))
        (px.mixer:set-endevent channel type)
        (dotimes (index 2) (px.mixer:play sound :channel channel) (px.mixer:stop channel))
        (px.mixer:set-endevent channel 0)
        (let ((events (px.event:get :types type)))
          (list (length events) (mapcar (lambda (event) (px.event:attribute event :code)) events)))))))

(defun fixture-color-arithmetic ()
  (let ((left (px:make-color 250 10 80 200)) (right (px:make-color 20 30 40 100)))
    (mapcar #'px.color:to-list
            (list (px.color:add left right) (px.color:subtract left right)
                  (px.color:multiply left right) (px.color:invert left)
                  (px.color:floor-divide left '(0 3 7 0))
                  (px.color:modulo left '(0 3 7 0))))))

(defun fixture-i1i2i3 ()
  (let ((color (px:make-color 128 64 32 77)))
    (list (mapcar (lambda (component) (round (* component 1000000))) (px.color:i1i2i3 color))
          (progn (setf (px.color:i1i2i3 color) '(1/2 1/4 0)) (px.color:to-list color)))))

(defun fixture-event-filtering ()
  (px:with-init ()
    (let ((first (px.event:custom-type)) (second (px.event:custom-type)))
      (px.event:clear)
      (unwind-protect
           (progn
             (px.event:post (px.event:make-event first))
             (px.event:set-blocked first)
             (list (if (px.event:get-blocked first) 1 0)
                   (if (px.event:get-blocked (vector first second)) 1 0)
                   (if (px.event:post (px.event:make-event first)) 1 0)
                   (if (px.event:post (px.event:make-event second)) 1 0)
                   (length (px.event:get :types (list first second)))))
        (px.event:set-allowed (list first second))))))

(defun fixture-event-selection ()
  (px:with-init (:video t)
    (let ((first (px.event:custom-type))
          (excluded (px.event:custom-type))
          (third (px.event:custom-type)))
      (labels ((post-records (records)
                 (dolist (record records)
                   (px.event:post (px.event:make-event (first record) :code (second record)))))
               (collect-codes (events)
                 (mapcar (lambda (event) (px.event:attribute event :code)) events)))
        (unwind-protect
             (progn
               (px.event:clear nil :pump nil)
               (post-records (list (list first 11) (list excluded 21) (list first 12)
                                   (list third 31) (list excluded 22)))
               (let ((without-excluded (collect-codes
                                        (px.event:get :exclude excluded :pump nil)))
                     (excluded-remaining (collect-codes
                                          (px.event:get :types excluded :pump nil))))
                 (px.event:clear nil :pump nil)
                 (post-records (list (list first 11) (list first 12) (list third 31)
                                     (list excluded 21) (list excluded 22)))
                 (let ((included (collect-codes
                                 (px.event:get :types (list first third) :pump nil)))
                       (include-remaining (collect-codes (px.event:get :pump nil))))
                   (px.event:clear nil :pump nil)
                   (post-records (list (list first 41) (list excluded 42) (list first 43)))
                   (let ((conflict
                           (handler-case
                               (progn (px.event:get :types first :exclude excluded :pump nil) 0)
                             (error () 1)))
                         (conflict-preserved
                           (collect-codes
                            (px.event:get :types (list first excluded third) :pump nil))))
                     (list without-excluded excluded-remaining included include-remaining
                           conflict conflict-preserved)))))
          (px.event:clear nil :pump nil))))))

(defun fixture-pixel-distance ()
  (px.surface:with-surface (surface '(4 1) :alpha t)
    (loop for x from 0 for color in '((100 100 100 255) (120 100 100 0)
                                      (100 120 100 255) (100 100 120 128))
          do (px.surface:set-at surface (list x 0) color))
    (let ((selected nil))
      (px.pixelarray:with-pixel-array (pixels surface)
        (setf selected
              (loop for weights in '((1 0 0) (0 1 0) (0 0 1))
                    collect (let ((bits (px.pixelarray:extract pixels '(100 100 100 255)
                                                              :distance 0.05 :weights weights)))
                              (loop for x below 4 collect (aref bits x 0)))))
        (px.pixelarray:replace pixels '(100 100 100 255) "gold" :distance 0.05 :weights '(10 0 0)))
      (list selected (fixture-pixel-colors surface)))))

(defun fixture-pixel-transpose ()
  (px.surface:with-surface (surface '(3 2) :alpha t)
    (dotimes (y 2)
      (dotimes (x 3) (px.surface:set-at surface (list x y) (list (+ 1 x (* y 3)) 0 0 255))))
    (px.pixelarray:with-pixel-array (pixels surface)
      (px.buffer:with-view (turned (px.pixelarray:transpose pixels))
        (px:with-resource (copy (px.pixelarray:make-surface turned))
          (list (px.buffer:dimensions turned) (px.buffer:strides turned)
                (fixture-red-values copy)))))))

(defun fixture-surface-batch ()
  (px.surface:with-surface (target '(4 1) :alpha t)
    (px.surface:with-surface (source '(2 1) :alpha t)
      (px.surface:set-at source '(0 0) '(10 0 0 255))
      (px.surface:set-at source '(1 0) '(20 0 0 255))
      (px.surface:fill target '(5 0 0 255))
      (px.surface:set-clip target '(1 0 1 1))
      (let ((damage (px.surface:blits target
                      (vector (vector source '(0 0) '(0 0 2 1))
                              (list source '(1 0) :area '(0 0 1 1) :special-flags :blend-rgb-add)))))
        (list (mapcar #'fixture-rect-values damage) (fixture-pixel-colors target)
              (px.surface:get-shifts source) (px.surface:get-losses source)
              (fixture-rect-values (px.surface:get-rect source :mid-top '(10 20))))))))

