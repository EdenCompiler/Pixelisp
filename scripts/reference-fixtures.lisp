(defun fixture-screensaver-controls ()
  (px:with-init (:video t)
    (let ((initial (px.display:get-allow-screensaver)))
      (unwind-protect
           (loop for allow in '(nil t nil)
                 collect (progn
                           (px.display:set-allow-screensaver allow)
