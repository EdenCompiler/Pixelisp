(defun %normalize-name (name)
  (check-type name string)
  (remove #\Space (string-downcase name)))

(defun lookup (name)
  "Return a fresh RGBA list for NAME, or NIL when it is unknown."
  (let ((pixel (gethash (%normalize-name name) *named-colors*)))
    (when pixel
      (loop for shift in '(24 16 8 0) collect (ldb (byte 8 shift) pixel)))))

(defun color-names ()
  "Return a sorted list of fresh strings naming the built-in palette."
  (sort (loop for name being the hash-keys of *named-colors* collect (copy-seq name))
        #'string<))

(defun the-colors ()
  "Return an independent name-to-RGBA hash table for the built-in palette."
  (let ((table (make-hash-table :test #'equal)))
    (maphash (lambda (name pixel)
               (setf (gethash (copy-seq name) table)
                     (loop for shift in '(24 16 8 0) collect (ldb (byte 8 shift) pixel))))
             *named-colors*)
    table))
