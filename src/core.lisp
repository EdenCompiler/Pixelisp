;;;; Native-independent value types and resource lifecycle.
;;;; Geometry can be used by tools and tests without loading SDL. Resource owners
;;;; register with one cleanup protocol shared by every native adapter.
(in-package #:pixelisp)

(define-condition error (cl:error)
  ((operation :initarg :operation :initform nil :reader operation)
   (message :initarg :message :initform "Pixelisp operation failed" :reader message))
  (:report (lambda (c s) (format s "~@[~A: ~]~A" (operation c) (message c)))))
(define-condition initialization-error (error) ())
(define-condition dependency-error (error) ())
(define-condition unsupported-feature (error) ())
(define-condition disposed-resource (error) ())
(define-condition resource-in-use (error) ())

(defstruct (color (:constructor %color (r g b a)))
  (r 0 :type (unsigned-byte 8)) (g 0 :type (unsigned-byte 8))
  (b 0 :type (unsigned-byte 8)) (a 255 :type (unsigned-byte 8)))
(defun make-color (red &optional (green nil green-p) (blue nil blue-p) (alpha 255))
  "Construct a Color from RGB(A) octets, or one color/name/hex/sequence/integer value."
  (cond ((and green-p blue-p)
         (dolist (value (list red green blue alpha)) (check-type value (unsigned-byte 8)))
         (%color red green blue alpha))
        ((or green-p blue-p) (cl:error "Provide three or four color channels, or one color value."))
        ;; The richer parser lives with the color utilities; ordinary numeric
        ;; construction above stays available while portable core files load.
        (t (pixelisp.color:parse red))))
(defstruct (rect (:constructor %rect (x y width height)))
  (x 0 :type integer) (y 0 :type integer) (width 0 :type integer) (height 0 :type integer))
(defun make-rect (x y width height)
  "Construct an integer rectangle. Right and bottom edges are exclusive."
  (%rect (truncate x) (truncate y) (truncate width) (truncate height)))

(in-package #:pixelisp.internal)
(defvar *resources* nil)
(defvar *initialized* nil)
(defvar *video-thread* nil)
(defvar *shutdown-hooks* nil)
(defvar *pump-hooks* nil)
(defmacro with-native-context (&body body)
  "Temporarily mask floating-point traps expected by C multimedia libraries.
SBCL normally enables traps that graphics drivers do not expect. Restore the
caller's floating-point environment when BODY finishes, including on errors."
  #+sbcl `(sb-int:with-float-traps-masked (:invalid :divide-by-zero :underflow :overflow :inexact)
            ,@body)
  #-sbcl `(progn ,@body))
(defclass resource ()
  ((handle :initarg :handle :initform nil :accessor handle)
   (disposed-p :initarg :disposed-p :initform nil :accessor resource-disposed-p)))
(defgeneric dispose (resource))
(defmethod dispose :around ((object resource))
  (unless (resource-disposed-p object) (call-next-method)))
(defmethod dispose ((object resource)) nil)
(defmethod dispose :after ((object resource))
  (setf (resource-disposed-p object) t
        *resources* (delete object *resources* :test #'eq)))
(defgeneric ensure-live (object)
  (:documentation "Check that OBJECT and its owners are still usable; return OBJECT."))
(defmethod ensure-live ((object resource))
  (when (resource-disposed-p object)
    (error 'pixelisp:disposed-resource :operation 'ensure-live :message "Resource has been disposed.")) object)
(defun register-resource (object)
  "Keep a resource alive until explicit disposal or the next Pixelisp QUIT."
  (push object *resources*) object)
(setf (fdefinition 'pixelisp:dispose) #'dispose)
(defmacro pixelisp:with-resource ((name expression) &body body)
  `(let ((,name ,expression)) (unwind-protect (progn ,@body) (dispose ,name))))
(defgeneric pair (value)
  (:documentation "Return two coordinate values from a sequence or geometric value."))
(defmethod pair ((value sequence))
  (unless (= (length value) 2)
    (error 'type-error :datum value :expected-type '(or (cons real (cons real null)) (vector real 2))))
  (values (elt value 0) (elt value 1)))
(defmethod pair ((value pixelisp:rect))
  (values (pixelisp:rect-x value) (pixelisp:rect-y value)))
(defun rgba (value)
  (etypecase value
    (pixelisp:color (values (pixelisp:color-r value) (pixelisp:color-g value)
                            (pixelisp:color-b value) (pixelisp:color-a value)))
    (string (rgba (pixelisp.color:parse value)))
    (sequence
     (unless (<= 3 (length value) 4) (error "Expected RGB or RGBA color, got ~S" value))
     (let ((r (elt value 0)) (g (elt value 1)) (b (elt value 2))
           (a (if (= (length value) 4) (elt value 3) 255)))
       (dolist (x (list r g b a)) (check-type x (unsigned-byte 8))) (values r g b a)))))
(defun as-rect (value)
  (etypecase value
    (pixelisp:rect value)
    (sequence (unless (= (length value) 4) (error "Expected (x y width height)."))
              (apply #'pixelisp:make-rect (coerce value 'list)))))
(defun check-video-thread ()
  (when (and *video-thread* (not (eq *video-thread* (bt:current-thread))))
    (error 'pixelisp:initialization-error :operation 'check-video-thread
           :message "Video operations must run on the initializing thread.")))

(in-package #:pixelisp.rect)
(setf (fdefinition 'make-rect) #'pixelisp:make-rect)
(macrolet ((alias (new old)
             `(progn (setf (fdefinition ',new) (fdefinition ',old))
                     (setf (fdefinition '(setf ,new)) (fdefinition '(setf ,old))))))
  (alias x pixelisp:rect-x) (alias y pixelisp:rect-y)
  (alias width pixelisp:rect-width) (alias height pixelisp:rect-height)
  (alias left pixelisp:rect-x) (alias top pixelisp:rect-y))
(defun right (r) (+ (x r) (width r)))
(defun (setf right) (v r) (setf (x r) (- v (width r))) v)
(defun bottom (r) (+ (y r) (height r)))
(defun (setf bottom) (v r) (setf (y r) (- v (height r))) v)
(defun top-left (r) (list (left r) (top r)))
(defun (setf top-left) (value r)
  (multiple-value-bind (a b) (pixelisp.internal:pair value)
    (let ((new-left (truncate a)) (new-top (truncate b)))
      (setf (left r) new-left (top r) new-top))) value)
(defun top-right (r) (list (right r) (top r)))
(defun (setf top-right) (value r)
  (multiple-value-bind (a b) (pixelisp.internal:pair value)
    (let ((new-right (truncate a)) (new-top (truncate b)))
      (setf (right r) new-right (top r) new-top))) value)
(defun bottom-left (r) (list (left r) (bottom r)))
(defun (setf bottom-left) (value r)
  (multiple-value-bind (a b) (pixelisp.internal:pair value)
    (let ((new-left (truncate a)) (new-bottom (truncate b)))
      (setf (left r) new-left (bottom r) new-bottom))) value)
(defun bottom-right (r) (list (right r) (bottom r)))
(defun (setf bottom-right) (value r)
  (multiple-value-bind (a b) (pixelisp.internal:pair value)
    (let ((new-right (truncate a)) (new-bottom (truncate b)))
      (setf (right r) new-right (bottom r) new-bottom))) value)
(defun mid-top (r) (list (+ (left r) (floor (width r) 2)) (top r)))
(defun (setf mid-top) (value r)
  (multiple-value-bind (a b) (pixelisp.internal:pair value)
    (let ((new-x (- (truncate a) (floor (width r) 2))) (new-top (truncate b)))
      (setf (x r) new-x (top r) new-top))) value)
(defun mid-left (r) (list (left r) (+ (top r) (floor (height r) 2))))
(defun (setf mid-left) (value r)
  (multiple-value-bind (a b) (pixelisp.internal:pair value)
    (let ((new-left (truncate a)) (new-y (- (truncate b) (floor (height r) 2))))
      (setf (left r) new-left (y r) new-y))) value)
(defun mid-bottom (r) (list (+ (left r) (floor (width r) 2)) (bottom r)))
(defun (setf mid-bottom) (value r)
  (multiple-value-bind (a b) (pixelisp.internal:pair value)
    (let ((new-x (- (truncate a) (floor (width r) 2))) (new-bottom (truncate b)))
      (setf (x r) new-x (bottom r) new-bottom))) value)
(defun mid-right (r) (list (right r) (+ (top r) (floor (height r) 2))))
(defun (setf mid-right) (value r)
  (multiple-value-bind (a b) (pixelisp.internal:pair value)
    (let ((new-right (truncate a)) (new-y (- (truncate b) (floor (height r) 2))))
      (setf (right r) new-right (y r) new-y))) value)
(defun center (r) (list (+ (x r) (floor (width r) 2)) (+ (y r) (floor (height r) 2))))
(defun (setf center) (v r)
  (multiple-value-bind (a b) (pixelisp.internal:pair v)
    (setf (x r) (- (truncate a) (floor (width r) 2))
          (y r) (- (truncate b) (floor (height r) 2)))) v)
(defun size (r) (list (width r) (height r)))
(defun (setf size) (v r)
  (multiple-value-bind (w h) (pixelisp.internal:pair v)
    (setf (width r) (truncate w) (height r) (truncate h))) v)
(defun copy (r) (make-rect (x r) (y r) (width r) (height r)))
(defun normalize (r)
  (when (minusp (width r)) (incf (x r) (width r)) (setf (width r) (- (width r))))
  (when (minusp (height r)) (incf (y r) (height r)) (setf (height r) (- (height r)))) r)
(defun move-ip (r dx dy) (incf (x r) (truncate dx)) (incf (y r) (truncate dy)) r)
(defun move (r dx dy) (move-ip (copy r) dx dy))
(defun inflate-ip (r dx dy)
  (decf (x r) (floor dx 2)) (decf (y r) (floor dy 2))
  (incf (width r) (truncate dx)) (incf (height r) (truncate dy)) r)
(defun inflate (r dx dy) (inflate-ip (copy r) dx dy))
(defun collide-point (r point)
  (multiple-value-bind (px py) (pixelisp.internal:pair point)
    (and (<= (left r) px) (< px (right r)) (<= (top r) py) (< py (bottom r)))))
(defun collide-rect (a b)
  (and (plusp (width a)) (plusp (height a)) (plusp (width b)) (plusp (height b))
       (< (left a) (right b)) (< (left b) (right a))
       (< (top a) (bottom b)) (< (top b) (bottom a))))
(defun collide-list (r rectangles) (position-if (lambda (other) (collide-rect r other)) rectangles))
(defun collide-list-all (r rectangles)
  "Return the indices of every rectangle in RECTANGLES that overlaps R."
  (loop for other in rectangles for index from 0
        when (collide-rect r other) collect index))
(defun contains (a b)
  (and (<= (left a) (left b)) (<= (top a) (top b))
       (>= (right a) (right b)) (>= (bottom a) (bottom b))))
(defun clip (a b)
  (let ((l (max (left a) (left b))) (u (max (top a) (top b))))
    (if (collide-rect a b)
        (make-rect l u (- (min (right a) (right b)) l) (- (min (bottom a) (bottom b)) u))
        (make-rect (x a) (y a) 0 0))))
(defun union (a b)
  (let ((l (min (left a) (left b))) (u (min (top a) (top b))))
    (make-rect l u (- (max (right a) (right b)) l) (- (max (bottom a) (bottom b)) u))))
(defun union-all (r rectangles) (reduce #'union rectangles :initial-value (copy r)))
(defun clamp (r outer)
  (let ((result (copy r)))
    (setf (x result) (if (>= (width r) (width outer))
                        (- (first (center outer)) (floor (width r) 2))
                        (max (left outer) (min (x r) (- (right outer) (width r))))))
    (setf (y result) (if (>= (height r) (height outer))
                        (- (second (center outer)) (floor (height r) 2))
                        (max (top outer) (min (y r) (- (bottom outer) (height r)))))) result))

(defun fit (r outer)
  "Return a copy of R scaled to fit inside OUTER, centered in OUTER."
  (let* ((ow (width outer)) (oh (height outer))
         (rw (width r)) (rh (height r))
         (w 0) (h 0))
    ;; Decide which dimension limits the fit by cross multiplication. This
    ;; also matches pygame's signed-size behavior: the selected dimension gets
    ;; the target's size and the other dimension keeps the source's sign.
    (cond ((and (zerop rw) (zerop rh)) nil)
          ((zerop rw) (setf h (if (zerop rh) 0 (truncate (* rh (/ oh rh))))))
          ((zerop rh) (setf w (if (zerop rw) 0 (truncate (* rw (/ ow rw))))))
          ((> (* rw oh) (* rh ow))
           (setf w ow h (truncate (* rh ow) rw)))
          (t
           (setf h oh w (truncate (* rw oh) rh))))
    (make-rect (+ (left outer) (floor (- ow w) 2))
               (+ (top outer) (floor (- oh h) 2)) w h)))

(defun clipline (r line &optional p2)
  "Clip LINE to R, returning two integer endpoint lists or NIL.
LINE may be four coordinates, two coordinate pairs, or be supplied as two
  separate coordinate pairs. Rectangle edges are treated as exclusive."
  (multiple-value-bind (x1 y1 x2 y2)
      (cond (p2 (multiple-value-bind (ax ay) (pixelisp.internal:pair line)
                  (multiple-value-bind (bx by) (pixelisp.internal:pair p2)
                    (values ax ay bx by))))
            ((and (typep line 'sequence) (= (length line) 4))
             (values (elt line 0) (elt line 1) (elt line 2) (elt line 3)))
            (t (multiple-value-bind (a b) (pixelisp.internal:pair line)
                 (multiple-value-bind (ax ay) (pixelisp.internal:pair a)
                   (multiple-value-bind (bx by) (pixelisp.internal:pair b)
                     (values ax ay bx by))))))
    ;; pygame converts every endpoint to an integer before doing any clipping.
    (let ((x1 (truncate x1)) (y1 (truncate y1))
          (x2 (truncate x2)) (y2 (truncate y2))
          (bounds (normalize (copy r))))
    ;; Cohen-Sutherland clipping keeps the cases explicit and converges by
    ;; replacing an outside endpoint with its intersection with one edge.
    (let ((xmin (left bounds)) (xmax (1- (right bounds)))
          (ymin (top bounds)) (ymax (1- (bottom bounds))))
      (when (or (zerop (width bounds)) (zerop (height bounds)))
        (return-from clipline nil))
      (labels ((outcode (x y)
                 (logior (if (< x xmin) 1 (if (> x xmax) 2 0))
                         (if (< y ymin) 4 (if (> y ymax) 8 0))))
               (intersect-at (code x1 y1 x2 y2)
                 (cond ((logbitp 2 code)
                        (values (+ x1 (truncate (* (- x2 x1) (- ymin y1)) (- y2 y1))) ymin))
                       ((logbitp 3 code)
                        (values (+ x1 (truncate (* (- x2 x1) (- ymax y1)) (- y2 y1))) ymax))
                       ((logbitp 0 code)
                        (values xmin (+ y1 (truncate (* (- y2 y1) (- xmin x1)) (- x2 x1)))))
                       (t
                        (values xmax (+ y1 (truncate (* (- y2 y1) (- xmax x1)) (- x2 x1))))))))
        (loop repeat 16
              do (let ((c1 (outcode x1 y1)) (c2 (outcode x2 y2)))
                   (cond ((zerop (logior c1 c2))
                          (return (list (list (truncate x1) (truncate y1))
                                        (list (truncate x2) (truncate y2)))))
                         ((not (zerop (logand c1 c2))) (return nil))
                         (t (let ((code (if (zerop c1) c2 c1)))
                              (multiple-value-bind (ix iy) (intersect-at code x1 y1 x2 y2)
                                (if (= code c1) (setf x1 ix y1 iy) (setf x2 ix y2 iy)))))))
              finally (return nil)))))))

(in-package #:pixelisp.color)
(setf (fdefinition 'make-color) #'pixelisp:make-color)
(macrolet ((alias (new old) `(progn (setf (fdefinition ',new) (fdefinition ',old))
                                   (setf (fdefinition '(setf ,new)) (fdefinition '(setf ,old))))))
  (alias r pixelisp:color-r) (alias g pixelisp:color-g)
  (alias b pixelisp:color-b) (alias a pixelisp:color-a))
(defun to-list (c) (multiple-value-list (pixelisp.internal:rgba c)))
(defun normalize (c) (mapcar (lambda (n) (/ n 255.0)) (to-list c)))
(defun lerp (a b amount)
  (check-type amount (real 0 1))
  (apply #'make-color (mapcar (lambda (x y) (round (+ x (* amount (- y x))))) (to-list a) (to-list b))))
