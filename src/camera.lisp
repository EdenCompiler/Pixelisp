;;;; Linux camera capture uses libv4l2's RGB24 conversion and mmap streaming.
;;;;
;;;; A CAMERA is a reusable configuration. START opens the device and allocates
;;;; native buffers; STOP releases them and allows another START. DISPOSE closes
;;;; it permanently. A per-camera lock serializes capture, control, and shutdown.
(defpackage #:pixelisp.camera
  (:nicknames #:px.camera) (:use #:cl)
  (:export #:camera #:available-p #:get-backends #:init #:quit #:get-init #:list-cameras
           #:make-camera #:start #:stop #:get-size #:query-image #:get-image #:get-raw
           #:control-info #:get-control #:set-control #:get-controls #:set-controls
           #:colorspace #:with-camera))
(in-package #:pixelisp.camera)
(cffi:defcfun ("px_camera_available" %available) :int)
(cffi:defcfun ("px_camera_probe" %probe) :int (path :string))
(cffi:defcfun ("px_camera_open" %open) :pointer (path :string) (width :int) (height :int))
(cffi:defcfun ("px_camera_close" %close) :void (camera :pointer))
(cffi:defcfun ("px_camera_width" %width) :int (camera :pointer))
(cffi:defcfun ("px_camera_height" %height) :int (camera :pointer))
(cffi:defcfun ("px_camera_ready" %ready) :int (camera :pointer) (timeout :int))
(cffi:defcfun ("px_camera_frame" %frame) :int (camera :pointer) (output :pointer) (capacity :size) (timeout :int))
(cffi:defcfun ("px_camera_control_info" %control-info) :int (camera :pointer) (id :int) (minimum :pointer) (maximum :pointer) (step :pointer) (default :pointer))
(cffi:defcfun ("px_camera_get_control" %control-get) :int (camera :pointer) (id :int) (value :pointer))
(cffi:defcfun ("px_camera_set_control" %control-set) :int (camera :pointer) (id :int) (value :int))
(defvar *initialized* nil)
(defvar *cameras* nil)
(defclass camera (pixelisp.internal:resource)
  ((path :initarg :path :reader %path)
   (size :initarg :size :accessor %size)
   (format :initarg :format :reader %format)
   (lock :initform (bordeaux-threads:make-lock "camera capture") :reader %lock)))
(defun %failure (operation)
  (error 'pixelisp:error :operation operation :message (pixelisp.native:last-error)))
(defun available-p ()
  "Report whether the Linux capture adapter and libv4l2 can be loaded."
  (and (pixelisp.native:available-p) (plusp (%available))))
(defun get-backends () (when (available-p) '(:v4l2)))
(defun init (&optional (backend :v4l2))
  "Initialize V4L2 support without opening or starting a camera."
  (unless (eq backend :v4l2)
    (error 'pixelisp:unsupported-feature :operation 'camera-init :message "The implemented Linux camera backend is :V4L2."))
  (pixelisp.native:ensure-loaded)
  (unless (plusp (%available))
    (error 'pixelisp:dependency-error :operation 'camera-init :message (pixelisp.native:last-error)))
  (setf *initialized* t))
(defun get-init () *initialized*)
(defun quit ()
  (dolist (camera (copy-list *cameras*)) (stop camera))
  (setf *initialized* nil) nil)
(pushnew #'quit pixelisp.internal:*shutdown-hooks*)
(defun list-cameras ()
  "Return accessible V4L2 streaming capture paths, excluding metadata nodes."
  (unless *initialized* (init))
  (loop for path in (sort (directory #p"/dev/video*") #'string< :key #'namestring)
        when (plusp (%probe (namestring path))) collect (namestring path)))
(defun make-camera (path &key (size '(640 480)) (format :rgb))
  "Create a stopped camera. SIZE is requested; GET-SIZE returns negotiated dimensions after START."
  (check-type path string) (check-type format (member :rgb :hsv :yuv))
  (destructuring-bind (w h) size
    (check-type w (integer 1 16384)) (check-type h (integer 1 16384)))
  (let ((camera (pixelisp.internal:register-resource
                 (make-instance 'camera :path path :size (copy-list size) :format format))))
    (push camera *cameras*) camera))
(defun start (camera)
  "Open and begin capture. Failures preserve the stopped configuration."
  (pixelisp.internal:ensure-live camera)
  (unless *initialized* (init))
  (bordeaux-threads:with-lock-held ((%lock camera))
    (unless (pixelisp.internal:handle camera)
      (let ((pointer (%open (%path camera) (first (%size camera)) (second (%size camera)))))
        (when (cffi:null-pointer-p pointer) (%failure 'start-camera))
        (setf (pixelisp.internal:handle camera) pointer
              (%size camera) (list (%width pointer) (%height pointer)))))) camera)
(defun stop (camera)
  "Release native capture buffers. The camera can subsequently be restarted."
  (bordeaux-threads:with-lock-held ((%lock camera))
    (when (pixelisp.internal:handle camera)
      (%close (pixelisp.internal:handle camera))
      (setf (pixelisp.internal:handle camera) nil))) camera)
(defmethod pixelisp.internal:dispose ((camera camera))
  (stop camera) (setf *cameras* (delete camera *cameras*)))
(defun %pointer (camera)
  (pixelisp.internal:ensure-live camera)
  (or (pixelisp.internal:handle camera)
      (error 'pixelisp:initialization-error :operation 'camera :message "Call START before capturing or accessing controls.")))
(defun get-size (camera) (pixelisp.internal:ensure-live camera) (copy-list (%size camera)))
(defun query-image (camera)
  "Return true when a frame can be read immediately; signal device I/O failures."
  (bordeaux-threads:with-lock-held ((%lock camera))
    (let ((result (%ready (%pointer camera) 0)))
      (when (minusp result) (%failure 'query-image)) (plusp result))))
(defun get-raw (camera &key (timeout 1000))
  "Copy a frame to packed RGB24 octets, or return NIL after TIMEOUT milliseconds."
  (check-type timeout (integer 0 2147483647))
  (bordeaux-threads:with-lock-held ((%lock camera))
    (let* ((pointer (%pointer camera))
           (bytes (make-array (* 3 (first (%size camera)) (second (%size camera))) :element-type '(unsigned-byte 8))))
      (cffi:with-pointer-to-vector-data (output bytes)
        (let ((result (%frame pointer output (length bytes) timeout)))
          (when (minusp result) (%failure 'get-raw))
          (when (plusp result) bytes))))))
(defun get-image (camera &key destination (timeout 1000))
  "Capture into DESTINATION or a new surface; return NIL when no frame arrives."
  (let ((bytes (get-raw camera :timeout timeout)))
    (when bytes
      (destructuring-bind (w h) (get-size camera)
        (let ((surface (or destination (px.surface:make-surface (list w h)))))
          (unless (and (= w (px.surface:width surface)) (= h (px.surface:height surface)))
            (error 'pixelisp:error :operation 'get-image :message "Destination dimensions differ from the negotiated camera size."))
          (dotimes (y h)
            (dotimes (x w)
              (let ((offset (* 3 (+ x (* y w)))))
                (px.surface:set-at surface (list x y) (list (aref bytes offset) (aref bytes (+ offset 1)) (aref bytes (+ offset 2)))))))
          (if (eq (%format camera) :rgb) surface (colorspace surface (%format camera) surface)))))))
(defparameter *controls* '((:brightness . 0) (:hflip . 1) (:vflip . 2) (:contrast . 3) (:saturation . 4) (:hue . 5) (:gain . 6)))
(defun %control-id (control)
  (if (integerp control) control
      (or (cdr (assoc control *controls*))
          (error 'type-error :datum control :expected-type `(member ,@(mapcar #'car *controls*))))))
(defun control-info (camera control)
  "Return range/default metadata, or NIL if the device does not offer CONTROL."
  (bordeaux-threads:with-lock-held ((%lock camera))
    (cffi:with-foreign-objects ((minimum :int) (maximum :int) (step :int) (default :int))
      (when (plusp (%control-info (%pointer camera) (%control-id control) minimum maximum step default))
        (list :minimum (cffi:mem-ref minimum :int) :maximum (cffi:mem-ref maximum :int)
              :step (cffi:mem-ref step :int) :default (cffi:mem-ref default :int))))))
(defun get-control (camera control)
  (unless (control-info camera control)
    (error 'pixelisp:unsupported-feature :operation 'get-control :message (format nil "Camera does not offer ~S." control)))
  (bordeaux-threads:with-lock-held ((%lock camera))
    (cffi:with-foreign-object (value :int)
      (when (minusp (%control-get (%pointer camera) (%control-id control) value)) (%failure 'get-control))
      (cffi:mem-ref value :int))))
(defun set-control (camera control value)
  "Set a control in its native device range; reject unsupported or invalid settings."
  (let ((info (control-info camera control)))
    (unless info (error 'pixelisp:unsupported-feature :operation 'set-control :message (format nil "Camera does not offer ~S." control)))
    (when (member control '(:hflip :vflip)) (setf value (if value (if (eql value 0) 0 1) 0)))
    (unless (and (integerp value) (<= (getf info :minimum) value (getf info :maximum))
                 (zerop (mod (- value (getf info :minimum)) (max 1 (getf info :step)))))
      (error 'pixelisp:error :operation 'set-control :message "Control value lies outside its supported range/step."))
    (bordeaux-threads:with-lock-held ((%lock camera))
      (when (minusp (%control-set (%pointer camera) (%control-id control) value)) (%failure 'set-control)))) value)
(defun get-controls (camera)
  (loop for (key . id) in *controls* when (control-info camera id) append (list key (get-control camera id))))
(defun set-controls (camera &key (hflip nil hflip-p) (vflip nil vflip-p) (brightness nil brightness-p))
  (when hflip-p (set-control camera :hflip hflip))
  (when vflip-p (set-control camera :vflip vflip))
  (when brightness-p (set-control camera :brightness brightness)) (get-controls camera))
(defun %channel (n) (max 0 (min 255 (round n))))
(defun %convert-color (r g b format)
  (ecase format
    (:rgb (list r g b))
    (:yuv (list (%channel (+ (* .299 r) (* .587 g) (* .114 b)))
                (%channel (+ 128 (* -.168736 r) (* -.331264 g) (* .5 b)))
                (%channel (+ 128 (* .5 r) (* -.418688 g) (* -.081312 b)))))
    (:hsv
     (let* ((maximum (max r g b)) (minimum (min r g b)) (delta (- maximum minimum))
            (hue (cond ((zerop delta) 0)
                       ((= maximum r) (mod (/ (- g b) delta) 6))
                       ((= maximum g) (+ 2 (/ (- b r) delta)))
                       (t (+ 4 (/ (- r g) delta))))))
       (list (%channel (* hue (/ 255 6))) (if (zerop maximum) 0 (%channel (* 255 (/ delta maximum)))) maximum)))))
(defun colorspace (source format &optional destination)
  "Encode RGB pixels as :RGB, :HSV or :YUV channels in an equally sized surface."
  (check-type format (member :rgb :hsv :yuv))
  (let ((destination (or destination (px.surface:make-surface (px.surface:size source)))))
    (unless (equal (px.surface:size source) (px.surface:size destination))
      (error 'pixelisp:error :operation 'colorspace :message "Source and destination sizes must match."))
    (dotimes (y (px.surface:height source))
      (dotimes (x (px.surface:width source))
        (multiple-value-bind (r g b) (pixelisp.internal:rgba (px.surface:get-at source (list x y)))
          (px.surface:set-at destination (list x y) (%convert-color r g b format))))) destination))
(defmacro with-camera ((variable path &rest options) &body body)
  `(pixelisp:with-resource (,variable (make-camera ,path ,@options))
     (start ,variable) ,@body))
