;;;; Scoped access to foreign or otherwise non-array storage.
;;;; A view owns a release action and retains its backing owner. Dependent slices
;;;; pin their parent view until closed, just as surface views pin pixel storage.
(in-package #:pixelisp.buffer)
(defclass buffer-view (pixelisp.internal:resource)
  ((owner :initarg :owner :reader owner)
   (dimensions :initarg :dimensions :reader %dimensions)
   (strides :initarg :strides :reader %strides)
   (byte-offset :initarg :byte-offset :initform 0 :reader byte-offset)
   (element-type :initarg :element-type :reader element-type)
   (reader :initarg :reader :reader view-reader)
   (writer :initarg :writer :reader view-writer)
   (releaser :initarg :releaser :reader view-releaser)
   ;; Private provenance used by PixelArray validation. Public MAKE-VIEW never
   ;; accepts this flag; only packed surface factories and their derivatives do.
   (packed-view-p :initform nil :accessor %packed-view-p)
   (dependents :initform 0 :accessor dependent-count)))
(defun dimensions (view)
  "Return a copy of the shape, so callers cannot alter the bounds checks."
  (copy-list (%dimensions view)))
(defun strides (view)
  "Return a copy of the byte strides, including any negative slice strides."
  (copy-list (%strides view)))
(defun callable-p (value)
  (or (functionp value) (and (symbolp value) (fboundp value))))
(defun make-view (&key owner dimensions strides (byte-offset 0)
                      (element-type '(unsigned-byte 8)) reader writer releaser)
  "Construct a view with index-based READER/WRITER callbacks and one release action."
  (check-type dimensions sequence)
  (check-type byte-offset integer)
  (unless (and (callable-p reader) (or (null writer) (callable-p writer))
               (or (null releaser) (callable-p releaser))
               (every (lambda (dimension) (typep dimension '(integer 0 *))) dimensions))
    (error "A view needs callable accessors and nonnegative dimensions."))
  (when strides
    (unless (and (typep strides 'sequence) (= (length strides) (length dimensions))
                 (every #'integerp strides))
      (error "Byte strides must be integers matching the view's rank.")))
  (when (typep owner 'pixelisp.internal:resource) (pixelisp.internal:ensure-live owner))
  (let ((view (make-instance 'buffer-view :owner owner
                             :dimensions (copy-seq (coerce dimensions 'list))
                             :strides (copy-seq (coerce strides 'list)) :byte-offset byte-offset
                             :element-type element-type :reader reader :writer writer :releaser releaser)))
    ;; Validate and construct first: failed construction must not pin its owner.
    (when (typep owner 'buffer-view) (incf (dependent-count owner)))
    (pixelisp.internal:register-resource view)))
(defun %make-packed-view (&rest arguments)
  "Construct a trusted native packed-pixel view for PixelArray operations."
  (let ((view (apply #'make-view arguments)))
    (setf (%packed-view-p view) t)
    view))
(defmethod pixelisp.internal:ensure-live :before ((view buffer-view))
  (when (typep (owner view) 'pixelisp.internal:resource)
    (pixelisp.internal:ensure-live (owner view))))
(defun closed-p (view) (pixelisp.internal:resource-disposed-p view))
(defun check-view (view indices)
  (pixelisp.internal:ensure-live view)
  (unless (and (= (length indices) (length (%dimensions view)))
               (every (lambda (i d) (and (integerp i) (<= 0 i) (< i d))) indices (%dimensions view)))
    (error 'type-error :datum indices :expected-type 'list)))
(defun view-ref (view &rest indices)
  (check-view view indices) (apply (view-reader view) indices))
(defun (setf view-ref) (value view &rest indices)
  (check-view view indices)
  (unless (view-writer view) (error "This view is read-only."))
  (apply (view-writer view) value indices) value)
(defmethod pixelisp.internal:dispose ((view buffer-view))
  (when (plusp (dependent-count view))
    (error 'pixelisp:resource-in-use :operation 'close :message "Close dependent slices before closing their parent view."))
  (when (view-releaser view) (funcall (view-releaser view)))
  (when (typep (owner view) 'buffer-view) (decf (dependent-count (owner view)))))
(defun close (view) (pixelisp.internal:dispose view))
(defmacro with-view ((name expression) &body body)
  `(let ((,name ,expression)) (unwind-protect (progn ,@body) (close ,name))))
(defun to-array (view)
  (pixelisp.internal:ensure-live view)
  (let ((array (make-array (dimensions view) :element-type (element-type view))))
    (labels ((walk (dims prefix)
               (if (null dims) (setf (apply #'aref array prefix) (apply #'view-ref view prefix))
                   (dotimes (i (first dims)) (walk (rest dims) (append prefix (list i)))))))
      (walk (dimensions view) nil)) array))
(defun slice (view starts sizes &optional steps)
  "Create a dependent view; STEPS may be negative. Close it before its parent."
  (pixelisp.internal:ensure-live view)
  (let* ((starts (coerce starts 'list))
         (sizes (coerce sizes 'list))
         (steps (if steps (coerce steps 'list) (make-list (length starts) :initial-element 1))))
    (unless (= (length starts) (length sizes) (length steps) (length (dimensions view)))
      (error "Slice rank mismatch."))
    (loop for start in starts for size in sizes for step in steps for dim in (dimensions view)
          do (unless (and (integerp size) (>= size 0) (integerp step) (/= step 0)
                          (integerp start)
                          (if (zerop size) (<= 0 start dim)
                              (and (<= 0 start) (< start dim)
                                               (<= 0 (+ start (* (1- size) step)))
                                               (< (+ start (* (1- size) step)) dim))))
               (error "Slice outside its parent.")))
    (flet ((translate (indices) (mapcar (lambda (a b c) (+ a (* b c))) starts indices steps)))
      (funcall (if (%packed-view-p view) #'%make-packed-view #'make-view)
               :owner view :dimensions sizes :element-type (element-type view)
               :strides (when (strides view) (mapcar #'* (strides view) steps))
               :byte-offset (+ (byte-offset view)
                               (if (%strides view) (reduce #'+ (mapcar #'* starts (%strides view))) 0))
               :reader (lambda (&rest indices) (apply #'view-ref view (translate indices)))
               :writer (when (view-writer view)
                         (lambda (value &rest indices)
                           (setf (apply #'view-ref view (translate indices)) value)))))))
