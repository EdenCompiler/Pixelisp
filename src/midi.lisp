;;;; Optional real PortMidi input/output. No devices are opened on load.
(defpackage #:pixelisp.midi
  (:nicknames #:px.midi) (:use #:cl) (:shadow #:close #:read #:write #:time)
  (:export #:available-p #:init #:quit #:get-init #:get-count #:get-device-info
           #:get-default-input-id #:get-default-output-id #:input #:output #:make-input #:make-output
           #:close #:poll #:read #:write #:write-short #:write-sysex #:abort-output #:set-filter #:set-channel-mask
           #:note-on #:note-off #:set-instrument #:pitch-bend #:time #:midis-to-events
           #:frequency-to-note #:note-to-frequency #:note-to-name #:with-input #:with-output))
(in-package #:pixelisp.midi)
(cffi:define-foreign-library portmidi (:unix (:or "libportmidi.so.0" "libportmidi.so")) (t (:default "portmidi")))
(defvar *library* nil)
(defvar *initialized* nil)
(defvar *streams* nil)
(defvar *lock* (bordeaux-threads:make-lock "PortMidi lifecycle"))
(cffi:defcstruct device-info (version :int) (interface :pointer) (name :pointer) (input :int) (output :int) (opened :int))
(cffi:defcstruct midi-event (message :int32) (timestamp :int32))
(cffi:defcfun ("Pm_Initialize" %init) :int)
(cffi:defcfun ("Pm_Terminate" %quit) :int)
(cffi:defcfun ("Pm_CountDevices" %count) :int)
(cffi:defcfun ("Pm_GetDeviceInfo" %info) :pointer (id :int))
(cffi:defcfun ("Pm_GetDefaultInputDeviceID" %default-input) :int)
(cffi:defcfun ("Pm_GetDefaultOutputDeviceID" %default-output) :int)
(cffi:defcfun ("Pm_GetErrorText" %error-text) :string (code :int))
(cffi:defcfun ("Pm_OpenInput" %open-input) :int (stream :pointer) (id :int) (driver :pointer) (size :int32) (clock :pointer) (clock-data :pointer))
(cffi:defcfun ("Pm_OpenOutput" %open-output) :int (stream :pointer) (id :int) (driver :pointer) (size :int32) (clock :pointer) (clock-data :pointer) (latency :int32))
(cffi:defcfun ("Pm_Close" %close) :int (stream :pointer))
(cffi:defcfun ("Pm_Abort" %abort) :int (stream :pointer))
(cffi:defcfun ("Pm_Poll" %poll) :int (stream :pointer))
(cffi:defcfun ("Pm_Read" %read) :int (stream :pointer) (events :pointer) (length :int32))
(cffi:defcfun ("Pm_Write" %write) :int (stream :pointer) (events :pointer) (length :int32))
(cffi:defcfun ("Pm_WriteShort" %short) :int (stream :pointer) (timestamp :int32) (message :int32))
(cffi:defcfun ("Pm_WriteSysEx" %sysex) :int (stream :pointer) (timestamp :int32) (message :pointer))
(cffi:defcfun ("Pm_SetFilter" %filter) :int (stream :pointer) (filters :int32))
(cffi:defcfun ("Pm_SetChannelMask" %mask) :int (stream :pointer) (mask :int))
(cffi:defcfun ("Pt_Start" %clock-start) :int (resolution :int) (callback :pointer) (data :pointer))
(cffi:defcfun ("Pt_Stop" %clock-stop) :int)
(cffi:defcfun ("Pt_Time" %time) :int32)
(defun available-p ()
  (or *library* (handler-case (setf *library* (cffi:load-foreign-library 'portmidi)) (error () nil))))
(defun %check (code operation)
  (when (minusp code) (error 'pixelisp:error :operation operation :message (%error-text code))) code)
(defun init ()
  (bordeaux-threads:with-lock-held (*lock*)
    (unless *initialized*
      (unless (available-p) (error 'pixelisp:dependency-error :operation 'midi-init :message "PortMidi is unavailable; install libportmidi."))
      (%check (%init) 'midi-init)
      (let ((result (%clock-start 1 (cffi:null-pointer) (cffi:null-pointer))))
        (unless (member result '(0 -10000)) ; ptAlreadyStarted is harmless.
          (%quit) (error 'pixelisp:initialization-error :operation 'midi-init :message (format nil "PortTime initialization failed (~D)." result))))
      (setf *initialized* t))) t)
(defun get-init () *initialized*)
(defun %ready () (unless *initialized* (init)))
(defclass midi-stream (pixelisp.internal:resource) ((lock :initform (bordeaux-threads:make-lock "MIDI stream") :reader %lock)))
(defclass input (midi-stream) ())
(defclass output (midi-stream) ())
(defun %ptr (stream) (unless *initialized* (error 'pixelisp:initialization-error :operation 'midi :message "MIDI subsystem is closed.")) (pixelisp.internal:ensure-live stream) (pixelisp.internal:handle stream))
(defmethod pixelisp.internal:dispose ((stream midi-stream))
  (bordeaux-threads:with-lock-held ((%lock stream))
    ;; A second concurrent close may already have passed the generic :AROUND
    ;; check before it acquired this lock. Recheck here before touching C.
    (unless (pixelisp.internal:resource-disposed-p stream)
      (%check (%close (pixelisp.internal:handle stream)) 'close-midi)
      (setf (pixelisp.internal:resource-disposed-p stream) t)))
  (setf *streams* (delete stream *streams*)))
(defun close (stream) (pixelisp.internal:dispose stream))
(defun quit ()
  (bordeaux-threads:with-lock-held (*lock*)
    (when *initialized*
      (dolist (stream (copy-list *streams*)) (close stream))
      (%clock-stop) (%check (%quit) 'midi-quit) (setf *initialized* nil))) nil)
(defun get-count () (%ready) (%count))
(defun get-device-info (id)
  (%ready)
  (let ((p (%info id)))
    (unless (cffi:null-pointer-p p)
      (cffi:with-foreign-slots ((interface name input output opened) p (:struct device-info))
        (list :id id :interface (cffi:foreign-string-to-lisp interface) :name (cffi:foreign-string-to-lisp name)
              :input (plusp input) :output (plusp output) :opened (plusp opened))))))
(defun get-default-input-id () (%ready) (let ((id (%default-input))) (unless (minusp id) id)))
(defun get-default-output-id () (%ready) (let ((id (%default-output))) (unless (minusp id) id)))
(defun %new (class id size latency)
  (%ready) (check-type id (integer 0 *)) (check-type size (integer 1 1048576))
  (cffi:with-foreign-object (ptr :pointer)
    (%check (if (eq class 'input)
                (%open-input ptr id (cffi:null-pointer) size (cffi:null-pointer) (cffi:null-pointer))
                (%open-output ptr id (cffi:null-pointer) size (cffi:null-pointer) (cffi:null-pointer) latency)) 'open-midi)
    (let ((stream (pixelisp.internal:register-resource (make-instance class :handle (cffi:mem-ref ptr :pointer)))))
      (push stream *streams*) stream)))
(defun make-input (id &key (buffer-size 1024)) (%new 'input id buffer-size 0))
(defun make-output (id &key (buffer-size 1024) (latency 0))
  (check-type latency (integer 0 2147483647)) (%new 'output id buffer-size latency))
(defun poll (stream) (check-type stream input) (bordeaux-threads:with-lock-held ((%lock stream)) (plusp (%check (%poll (%ptr stream)) 'midi-poll))))
(defun read (stream &optional (count 1024))
  (check-type stream input) (check-type count (integer 1 1048576))
  (bordeaux-threads:with-lock-held ((%lock stream))
    (cffi:with-foreign-object (events '(:struct midi-event) count)
      (let ((n (%check (%read (%ptr stream) events count) 'midi-read)))
        (loop for i below n for p = (cffi:mem-aptr events '(:struct midi-event) i) collect
          (cffi:with-foreign-slots ((message timestamp) p (:struct midi-event))
            (list (loop for shift from 0 below 32 by 8 collect (ldb (byte 8 shift) message)) timestamp)))))))
(defun %message (bytes)
  (unless (<= 1 (length bytes) 4) (error 'pixelisp:error :operation 'midi-message :message "MIDI messages contain one to four bytes."))
  (loop for b in bytes for shift from 0 by 8 do (check-type b (unsigned-byte 8)) sum (ash b shift)))
(defun %signed32 (n) (let ((u (logand n #xffffffff))) (if (logbitp 31 u) (- u #x100000000) u)))
(defun write (stream events)
  (check-type stream output)
  (bordeaux-threads:with-lock-held ((%lock stream))
    (cffi:with-foreign-object (buffer '(:struct midi-event) (max 1 (length events)))
      (loop for (bytes timestamp) in events for i from 0 for p = (cffi:mem-aptr buffer '(:struct midi-event) i) do
        (setf (cffi:foreign-slot-value p '(:struct midi-event) 'message) (%signed32 (%message bytes))
              (cffi:foreign-slot-value p '(:struct midi-event) 'timestamp) (%signed32 timestamp)))
      (%check (%write (%ptr stream) buffer (length events)) 'midi-write))) t)
(defun time () (%ready) (%time))
(defun write-short (stream status data1 data2 &key (timestamp 0))
  (check-type stream output) (check-type status (integer 128 255)) (check-type data1 (integer 0 127)) (check-type data2 (integer 0 127))
  (bordeaux-threads:with-lock-held ((%lock stream))
    (%check (%short (%ptr stream) (%signed32 timestamp) (%message (list status data1 data2))) 'midi-write-short)) t)
(defun write-sysex (stream bytes &key (timestamp 0))
  (check-type stream output)
  (unless (and (>= (length bytes) 2) (= (elt bytes 0) #xf0) (= (elt bytes (1- (length bytes))) #xf7)
               (every (lambda (x) (typep x '(unsigned-byte 8))) bytes))
    (error 'pixelisp:error :operation 'write-sysex :message "SysEx must contain bytes beginning F0 and ending F7."))
  (bordeaux-threads:with-lock-held ((%lock stream))
    (cffi:with-foreign-object (p :uint8 (length bytes))
      (dotimes (i (length bytes)) (setf (cffi:mem-aref p :uint8 i) (elt bytes i)))
      (%check (%sysex (%ptr stream) (%signed32 timestamp) p) 'midi-write-sysex))) t)
(defun abort-output (stream) (check-type stream output) (bordeaux-threads:with-lock-held ((%lock stream)) (%check (%abort (%ptr stream)) 'midi-abort)))
(defun set-filter (stream filter)
  (check-type stream input)
  (bordeaux-threads:with-lock-held ((%lock stream))
    (%check (%filter (%ptr stream) filter) 'midi-filter)))
(defun set-channel-mask (stream mask)
  (check-type stream input) (check-type mask (unsigned-byte 16))
  (bordeaux-threads:with-lock-held ((%lock stream))
    (%check (%mask (%ptr stream) mask) 'midi-channel-mask)))
(defun %channel (channel) (check-type channel (integer 0 15)) channel)
(defun note-on (stream note &optional (velocity 127) (channel 0)) (write-short stream (+ #x90 (%channel channel)) note velocity))
(defun note-off (stream note &optional (velocity 0) (channel 0)) (write-short stream (+ #x80 (%channel channel)) note velocity))
(defun set-instrument (stream instrument &optional (channel 0)) (write-short stream (+ #xc0 (%channel channel)) instrument 0))
(defun pitch-bend (stream value &optional (channel 0))
  (check-type value (integer -8192 8191)) (let ((v (+ value 8192))) (write-short stream (+ #xe0 (%channel channel)) (logand v 127) (ash v -7))))
(defun midis-to-events (events device-id)
  (loop for (bytes timestamp) in events collect
    (px.event:make-event :midi-in :status (first bytes) :data1 (second bytes) :data2 (third bytes) :data3 (fourth bytes) :timestamp timestamp :device-id device-id)))
(defun note-to-frequency (note) (* 440d0 (expt 2d0 (/ (- note 69) 12d0))))
(defun frequency-to-note (frequency) (check-type frequency (real (0) *)) (round (+ 69 (* 12 (log (/ frequency 440d0) 2d0)))))
(defun note-to-name (note)
  (check-type note (integer 0 127)) (format nil "~A~D" (nth (mod note 12) '("C" "C#" "D" "D#" "E" "F" "F#" "G" "G#" "A" "A#" "B")) (1- (floor note 12))))
(defmacro with-input ((var &rest args) &body body) `(let ((,var (make-input ,@args))) (unwind-protect (progn ,@body) (close ,var))))
(defmacro with-output ((var &rest args) &body body) `(let ((,var (make-output ,@args))) (unwind-protect (progn ,@body) (close ,var))))

;; Root shutdown closes all stream resources before terminating PortMidi.
(pushnew #'quit pixelisp.internal:*shutdown-hooks*)
