;;;; Native pixel memory is strided and foreign, so portable Lisp arrays are
;;;; copies. BUFFER-VIEW is the explicit, scoped alternative for shared access.
(defpackage #:pixelisp.surfarray
  (:use #:cl) (:nicknames #:px.surfarray)
  (:export #:array2d #:array3d #:array-alpha #:array-red #:array-green #:array-blue
           #:array-colorkey #:pixels2d #:pixels3d #:pixels-alpha #:pixels-red
           #:pixels-green #:pixels-blue #:make-surface #:blit-array #:map-array
           #:get-arraytype #:get-arraytypes #:use-arraytype))
(defpackage #:pixelisp.pixelcopy
  (:use #:cl) (:nicknames #:px.pixelcopy)
  (:export #:surface-to-array #:array-to-surface #:map-array #:make-surface))
(defpackage #:pixelisp.pixelarray
  (:use #:cl) (:nicknames #:px.pixelarray) (:shadow #:close #:replace)
  (:export #:make-pixel-array #:pixel-array #:ref #:close #:slice #:make-surface
           #:replace #:extract #:compare #:transpose #:row #:column
           #:surface #:itemsize #:ndim #:shape #:strides #:with-pixel-array))

(in-package #:pixelisp.surfarray)
(defun %packed-ref (surface x y)
  (px.surface::%read-packed-pixel surface x y))
(defun %set-packed (surface x y value)
  (let* ((bits (* 8 (px.surface:get-bytesize surface))) (maximum (1- (ash 1 bits))))
    (unless (and (integerp value) (<= 0 value maximum))
      (error 'type-error :datum value :expected-type `(integer 0 ,maximum)))
    (px.surface::%write-packed-pixel surface x y value)))
(defun %channel-byte-offset (surface channel)
  "Find the channel byte in its actual native format, including host byte order."
  ;; SURFACE-VIEWS loads after this file; neither module opens a view at load
  ;; time. Share its format check so palette indices never become RGB planes.
  (px.surface::%view-channel-offset surface channel))
(defun %pixel-view (surface channel &key (allow-24-packed nil))
  "Hold one surface lock until the returned view is closed."
  (px.surface:lock surface)
  (handler-case
      (let* ((width (px.surface:width surface)) (height (px.surface:height surface))
             (rgb (eq channel :rgb)) (packed (eq channel :packed))
             (bits (px.surface:get-bitsize surface))
             (bytes (px.surface:get-bytesize surface))
             (offsets (unless packed
                        (mapcar (lambda (component) (%channel-byte-offset surface component))
                                (if rgb '(:red :green :blue) (list channel)))))
             (pitch (sdl2:surface-pitch (pixelisp.internal:surface-handle surface)))
             (component-stride (when (and rgb (not (some #'null offsets)))
                                 (- (second offsets) (first offsets)))))
        (when (and packed (= bits 24) (not allow-24-packed))
          (error 'pixelisp:unsupported-feature :operation 'pixels2d
                 :message "A live packed view is unavailable for 24-bit surfaces."))
        (when (and (not packed) (not (member bits '(24 32))))
          (error 'pixelisp:unsupported-feature :operation 'pixels
                 :message "Live channel views require 24-bit or 32-bit surfaces."))
        (when (or (and (not packed) (some #'null offsets))
                  (and rgb (/= component-stride (- (third offsets) (second offsets)))))
          (error 'pixelisp:unsupported-feature :operation 'pixels
                 :message "This surface has no shared byte channel for the requested view."))
        (funcall (if packed #'px.buffer::%make-packed-view #'px.buffer:make-view)
         :owner surface :dimensions (if rgb (list width height 3) (list width height))
         :strides (if rgb (list bytes pitch component-stride) (list bytes pitch))
         :byte-offset (if packed 0 (first offsets))
         :element-type (if packed `(unsigned-byte ,(* 8 bytes)) '(unsigned-byte 8))
         :reader (lambda (x y &optional component)
                   (if packed (%packed-ref surface x y)
                       (cffi:mem-ref (cffi:inc-pointer (px.surface::pixel-pointer surface x y)
                                                       (nth (if rgb component 0) offsets)) :uint8)))
         :writer (lambda (value x y &optional component)
                   (if packed (%set-packed surface x y value)
                       (progn
                         (check-type value (unsigned-byte 8))
                         ;; Shared array access addresses storage directly. A
                         ;; surface's drawing clip must not suppress raw writes.
                         (setf (cffi:mem-ref (cffi:inc-pointer (px.surface::pixel-pointer surface x y)
                                                              (nth (if rgb component 0) offsets)) :uint8)
                               value))))
         :releaser (lambda () (px.surface:unlock surface))))
    (error (condition) (px.surface:unlock surface) (error condition))))
(defun pixels2d (surface) "Share packed pixels in X/Y order (except 24-bit surfaces)." (%pixel-view surface :packed))
(defun pixels3d (surface) "Share RGB channels in X/Y/channel order." (%pixel-view surface :rgb))
(defun pixels-alpha (surface) (%pixel-view surface :alpha))
(defun pixels-red (surface) (%pixel-view surface :red))
(defun pixels-green (surface) (%pixel-view surface :green))
(defun pixels-blue (surface) (%pixel-view surface :blue))
(defun %copy-view (view)
  (unwind-protect (px.buffer:to-array view) (px.buffer:close view)))
(defun %copy-packed (surface)
  (pixelisp.internal:ensure-live surface)
  (let* ((width (px.surface:width surface)) (height (px.surface:height surface))
         (bits (px.surface:get-bitsize surface))
         (type `(unsigned-byte ,(if (<= bits 8) 8 (if (<= bits 16) 16 32))))
         (result (make-array (list width height) :element-type type)))
    (px.surface:lock surface)
    (unwind-protect
         (dotimes (x width result)
           (dotimes (y height) (setf (aref result x y) (%packed-ref surface x y))))
      (px.surface:unlock surface))))
(defun %copy-channels (surface channels)
  (pixelisp.internal:ensure-live surface)
  (let* ((width (px.surface:width surface)) (height (px.surface:height surface))
         (result (make-array (append (list width height) (when (> (length channels) 1) (list (length channels))))
                             :element-type '(unsigned-byte 8))))
    (px.surface:lock surface)
    (unwind-protect
         (dotimes (x width result)
           (dotimes (y height)
             (let ((rgba (px.color:to-list (px.surface:unmap-rgb surface (%packed-ref surface x y)))))
               (if (= (length channels) 1)
                   (setf (aref result x y) (nth (first channels) rgba))
                   (dotimes (c (length channels)) (setf (aref result x y c) (nth (nth c channels) rgba)))))))
      (px.surface:unlock surface))))
(defun array2d (surface) "Copy packed pixels into an integer array, including 24-bit formats." (%copy-packed surface))
(defun array3d (surface) "Copy decoded RGB channels from any surface format." (%copy-channels surface '(0 1 2)))
(defun array-alpha (surface)
  "Copy alpha values, returning 255 throughout an opaque surface."
  (px.surface::check-surface surface)
  (if (px.surface:alpha-p surface) (%copy-channels surface '(3))
      (make-array (px.surface:size surface) :element-type '(unsigned-byte 8)
                                          :initial-element 255)))
(defun array-red (surface) (%copy-channels surface '(0)))
(defun array-green (surface) (%copy-channels surface '(1)))
(defun array-blue (surface) (%copy-channels surface '(2)))
(defun array-colorkey (surface)
  (let* ((width (px.surface:width surface)) (height (px.surface:height surface))
         (result (make-array (list width height) :element-type '(unsigned-byte 8)))
         (key (px.surface::%native-colorkey surface)))
    (dotimes (x width result)
      (dotimes (y height)
        (setf (aref result x y)
              (if (and key (px.surface::%colorkey-pixel-p
                             surface (px.surface:get-at-mapped surface (list x y)) key)) 0 255))))))
(defun blit-array (surface array)
  "Copy packed pixels or RGB(A) channel arrays into SURFACE.

An input dimension of one broadcasts across the matching Surface axis."
  (px.surface::check-surface surface)
  (unless (and (arrayp array) (member (array-rank array) '(2 3)))
    (error 'type-error :datum array :expected-type '(array * (* *))))
  (let* ((array-width (array-dimension array 0))
         (array-height (array-dimension array 1))
         (width (px.surface:width surface))
         (height (px.surface:height surface))
         (rank (array-rank array)))
    (unless (and (or (= array-width width) (= array-width 1))
                 (or (= array-height height) (= array-height 1))
                 (or (= rank 2) (member (array-dimension array 2) '(3 4))))
      (error "Expected (width height [3 or 4]) matching SURFACE, with singleton spatial axes allowed."))
    ;; Validate every element before locking or mutating the destination.
    (let ((maximum (1- (ash 1 (* 8 (px.surface:get-bytesize surface))))))
      (dotimes (x array-width)
        (dotimes (y array-height)
          (if (= rank 2)
              (unless (and (integerp (aref array x y)) (<= 0 (aref array x y) maximum))
                (error 'type-error :datum (aref array x y) :expected-type `(integer 0 ,maximum)))
              (dotimes (c (array-dimension array 2))
                (unless (typep (aref array x y c) '(unsigned-byte 8))
                  (error 'type-error :datum (aref array x y c) :expected-type '(unsigned-byte 8))))))))
    (px.surface:lock surface)
    (unwind-protect
         (dotimes (x width)
           (dotimes (y height)
             (let ((source-x (if (= array-width 1) 0 x))
                   (source-y (if (= array-height 1) 0 y)))
               (if (= rank 2)
                   (%set-packed surface x y (aref array source-x source-y))
                   (pixelisp.internal:write-surface-pixel surface (list x y)
                     (loop for c below (array-dimension array 2)
                           collect (aref array source-x source-y c)))))))
      (px.surface:unlock surface))
    surface))
(defun make-surface (array)
  "Make a surface by copying a (width height [channels]) array."
  (unless (member (array-rank array) '(2 3)) (error "Expected a rank-2 or rank-3 pixel array."))
  (let ((surface (px.surface:make-surface (list (array-dimension array 0) (array-dimension array 1))
                                        :alpha (and (= (array-rank array) 3) (= (array-dimension array 2) 4)))))
    (handler-case (blit-array surface array)
      (error (condition) (pixelisp:dispose surface) (error condition)))))
(defun %array-element-accepts-p (array value)
  (typep value (array-element-type array)))

(defun %check-array-target (array dimensions)
  (unless (and (arrayp array) (equal (array-dimensions array) dimensions))
    (error "Destination array dimensions do not match ~S." dimensions)))

(defun %pixelcopy-kind (kind)
  (let ((code (cond ((member kind '(:pixels :pixel :packed :rgb) :test #'eq) #\p)
                    ((eq kind :red) #\r) ((eq kind :green) #\g)
                    ((eq kind :blue) #\b) ((eq kind :alpha) #\a)
                    ((member kind '(:colorkey :color-key) :test #'eq) #\c)
                    ((characterp kind) (char-downcase kind))
                    ((and (stringp kind) (= (length kind) 1))
                     (char-downcase (char kind 0)))
                    (t (error 'type-error :datum kind
                              :expected-type '(or keyword character (string 1)))))))
    (unless (find code "prgbac")
      (error "Unknown pixelcopy kind ~S; expected P, R, G, B, A, or C." kind))
    code))

(defun %pixelcopy-blend-enabled-p (surface)
  "Report SDL's active blend mode, which controls pixelcopy kind A."
  (cffi:with-foreign-object (mode :int)
    (unless (zerop
            (pixelisp.internal::%get-blend
             (pixelisp.internal:%ptr (pixelisp.internal:handle surface)) mode))
      (pixelisp.internal:native-error 'surface-to-array))
    (not (zerop (cffi:mem-ref mode :int)))))

(defun %pixelcopy-source-array (surface array kind opaque clear)
  (case kind
    (#\p (if (= (array-rank array) 3)
              (px.surfarray:array3d surface)
              (px.surfarray:array2d surface)))
    (#\r (px.surfarray:array-red surface))
    (#\g (px.surfarray:array-green surface))
    (#\b (px.surfarray:array-blue surface))
    (#\a (if (%pixelcopy-blend-enabled-p surface)
              (px.surfarray:array-alpha surface)
              (make-array (px.surface:size surface) :element-type '(unsigned-byte 8)
                                                    :initial-element opaque)))
    (#\c (let* ((width (px.surface:width surface))
                 (height (px.surface:height surface))
                 (result (make-array (list width height)
                                     :element-type '(unsigned-byte 8)))
                 (key (px.surface::%native-colorkey surface)))
           (dotimes (x width result)
             (dotimes (y height)
               (setf (aref result x y)
                     ;; pygame.pixelcopy's native implementation compares the
                     ;; complete mapped pixel integer, including alpha bits.
                     (if (and key (= (px.surface:get-at-mapped surface (list x y)) key))
                         clear opaque))))))))

(defun surface-to-array (array surface &key (kind :pixels) (opaque 255) (clear 0))
  "Copy pixels into an existing array; KIND is P/R/G/B/A/C or a keyword.

KIND P copies packed pixels to rank 2 or RGB channels to rank 3. KIND C writes
CLEAR for exact mapped-pixel matches, including alpha bits, and OPAQUE otherwise.
KIND A reads native pixel alpha when SDL blending is enabled, or OPAQUE otherwise."
  (px.surface::check-surface surface)
  (check-type opaque (unsigned-byte 8))
  (check-type clear (unsigned-byte 8))
  (let* ((kind (%pixelcopy-kind kind))
         (rank (and (arrayp array) (array-rank array))))
    (unless (member rank '(2 3))
      (error 'type-error :datum array :expected-type '(array * (* *))))
    (when (and (= rank 3)
               (or (not (char= kind #\p)) (/= (array-dimension array 2) 3)))
      (error "Only kind P supports a rank-3 RGB destination."))
    (let* ((dimensions
             (if (= rank 3)
                 (list (px.surface:width surface) (px.surface:height surface) 3)
                 (list (px.surface:width surface) (px.surface:height surface)))))
      (%check-array-target array dimensions)
      (let ((source (%pixelcopy-source-array surface array kind opaque clear)))
        (unless (equal (array-dimensions source) dimensions)
          (error "Source pixel data has unexpected dimensions."))
        ;; Validate every store before changing ARRAY, including specialized type.
        (dotimes (index (array-total-size array))
          (let ((value (row-major-aref source index)))
            (unless (%array-element-accepts-p array value)
              (error 'type-error :datum value
                     :expected-type (array-element-type array)))))
        (dotimes (index (array-total-size array) array)
          (setf (row-major-aref array index) (row-major-aref source index)))))))

(defun %validate-map-source (destination source)
  (unless (and (arrayp destination) (= (array-rank destination) 2))
    (error "Expected a rank-2 packed destination array."))
  (unless (and (arrayp source) (= (array-rank source) 3)
               (member (array-dimension source 2) '(3 4)))
    (error "Expected an RGB(A) rank-3 source array."))
  (let ((width (array-dimension destination 0))
        (height (array-dimension destination 1)))
    (unless (and (or (= width (array-dimension source 0)) (= (array-dimension source 0) 1))
                 (or (= height (array-dimension source 1)) (= (array-dimension source 1) 1)))
      (error "Source spatial dimensions must match the destination or be one.")))
  (dotimes (index (array-total-size source))
    (unless (typep (row-major-aref source index) '(unsigned-byte 8))
      (error 'type-error :datum (row-major-aref source index)
             :expected-type '(unsigned-byte 8))))
  t)

(defun %map-array-into (destination source surface)
  (px.surface::check-surface surface)
  (%validate-map-source destination source)
  (let* ((width (array-dimension destination 0))
         (height (array-dimension destination 1))
         (source-width (array-dimension source 0))
         (source-height (array-dimension source 1))
         (channels (array-dimension source 2))
         (format (pixelisp.internal:%ptr
                  (sdl2:surface-format (pixelisp.internal:surface-handle surface))))
         (mapped (make-array (list width height))))
    (dotimes (x width)
      (dotimes (y height)
        (let ((sx (if (= source-width 1) 0 x))
              (sy (if (= source-height 1) 0 y)))
          (setf (aref mapped x y)
                (pixelisp.internal::%map-rgba
                 format (aref source sx sy 0) (aref source sx sy 1)
                 (aref source sx sy 2)
                 (if (= channels 4) (aref source sx sy 3) 255))))))
    (dotimes (index (array-total-size destination))
      (unless (%array-element-accepts-p destination (row-major-aref mapped index))
        (error 'type-error :datum (row-major-aref mapped index)
               :expected-type (array-element-type destination))))
    (dotimes (index (array-total-size destination) destination)
      (setf (row-major-aref destination index) (row-major-aref mapped index)))))

(defun map-array (surface array)
  "Map RGB(A) channel values to SURFACE's packed pixel format without changing it."
  (px.surface::check-surface surface)
  (unless (and (arrayp array) (= (array-rank array) 3)
               (member (array-dimension array 2) '(3 4)))
    (error "Expected an RGB(A) channel array."))
  (dotimes (index (array-total-size array))
    (unless (typep (row-major-aref array index) '(unsigned-byte 8))
      (error 'type-error :datum (row-major-aref array index)
             :expected-type '(unsigned-byte 8))))
  (let* ((width (array-dimension array 0))
         (height (array-dimension array 1))
         (channels (array-dimension array 2))
         (result
           (make-array (list width height)
                       :element-type '(unsigned-byte 32)))
         (format
           (pixelisp.internal:%ptr
            (sdl2:surface-format
             (pixelisp.internal:surface-handle surface)))))
    (dotimes (x width result)
      (dotimes (y height)
        (setf (aref result x y)
              (pixelisp.internal::%map-rgba
               format (aref array x y 0) (aref array x y 1) (aref array x y 2)
               (if (= channels 4) (aref array x y 3) 255)))))))
(defun get-arraytype () :common-lisp)
(defun get-arraytypes () '(:common-lisp))
(defun use-arraytype (type)
  (unless (eq type :common-lisp)
    (error 'pixelisp:unsupported-feature :operation 'use-arraytype :message "Pixelisp uses native Common Lisp arrays.")) type)

(in-package #:pixelisp.pixelcopy)
(defun surface-to-array (array surface &key (kind :pixels) (opaque 255) (clear 0))
  (px.surfarray::surface-to-array array surface :kind kind :opaque opaque :clear clear))
(defun array-to-surface (surface array)
  (px.surfarray:blit-array surface array))
(defun map-array (destination-or-surface source-or-array &optional (surface nil surface-p))
  (if surface-p
      (px.surfarray::%map-array-into destination-or-surface source-or-array surface)
      (px.surfarray:map-array destination-or-surface source-or-array)))
(defun make-surface (array) (px.surfarray:make-surface array))

(in-package #:pixelisp.pixelarray)
(deftype pixel-array () 'px.buffer:buffer-view)
(defun make-pixel-array (surface)
  ;; PixelArray supports 24-bit pixels through a native three-byte stride.
  (px.surface:get-view surface #\2))
(setf (fdefinition 'ref) #'px.buffer:view-ref
      (fdefinition 'close) #'px.buffer:close
      (fdefinition 'slice) #'px.buffer:slice)
(defmacro with-pixel-array ((name surface) &body body)
  `(px.buffer:with-view (,name (make-pixel-array ,surface)) ,@body))
(defun %owner-surface (pixels)
  "Find the surface backing PIXELS, even when PIXELS is a dependent view."
  (let ((owner (px.buffer:owner pixels)))
    (loop while (typep owner 'px.buffer:buffer-view)
          do (setf owner (px.buffer:owner owner)))
    (unless (typep owner 'pixelisp.surface::surface)
      (error "Pixel array is not backed by a surface."))
    owner))
(defun %validate-pixel-array (pixels)
  ;; Do this before looking at dimensions: empty views still have live owners.
  (unless (typep pixels 'pixel-array)
    (error "Expected a packed pixel array view."))
  (pixelisp.internal:ensure-live pixels)
  (let* ((surface (%owner-surface pixels))
         (bits (* 8 (px.surface:get-bytesize surface)))
         (base pixels))
    (loop while (typep (px.buffer:owner base) 'px.buffer:buffer-view)
          do (setf base (px.buffer:owner base)))
    (unless (and (px.buffer::%packed-view-p pixels)
                 (px.buffer::%packed-view-p base)
                 (member (length (px.buffer:dimensions pixels)) '(1 2))
                 (= (length (px.buffer:dimensions base)) 2)
                 (equal (px.buffer:owner base) surface)
                 (equal (px.buffer:dimensions base)
                        (list (px.surface:width surface) (px.surface:height surface)))
                 (equal (px.buffer:strides base)
                        (list (px.surface:get-bytesize surface) (px.surface:get-pitch surface)))
                 (equal (px.buffer:element-type pixels) `(unsigned-byte ,bits)))
      (error "Expected a live one- or two-dimensional packed pixel array."))
    surface))
(defun surface (pixels)
  "Return the live Surface backing PIXELS, including dependent views."
  (%validate-pixel-array pixels))
(defun itemsize (pixels)
  "Return the number of native bytes in each packed pixel."
  (px.surface:get-bytesize (%validate-pixel-array pixels)))
(defun ndim (pixels)
  "Return the rank of this PixelArray view (one or two)."
  (%validate-pixel-array pixels)
  (length (px.buffer:dimensions pixels)))
(defun shape (pixels)
  "Return a fresh list containing this PixelArray view's dimensions."
  (%validate-pixel-array pixels)
  (px.buffer:dimensions pixels))
(defun strides (pixels)
  "Return a fresh list of signed byte strides for this PixelArray view."
  (%validate-pixel-array pixels)
  (px.buffer:strides pixels))
(defun %pixel-logical-dimensions (pixels)
  "Treat a 1D PixelArray as a width-by-one array for pixel traversal."
  (let ((dimensions (px.buffer:dimensions pixels)))
    (if (= (length dimensions) 1) (list (first dimensions) 1) dimensions)))
(defun %pixel-ref-at (pixels x y)
  "Read logical coordinate X,Y from either a 1D or 2D view."
  (if (= (length (px.buffer:dimensions pixels)) 1) (ref pixels x) (ref pixels x y)))
(defun %pixel-set-at (pixels value x y)
  "Write a validated packed value at logical coordinate X,Y."
  (apply #'(setf px.buffer:view-ref) value pixels
         (if (= (length (px.buffer:dimensions pixels)) 1) (list x) (list x y))))
(defun %pixel-index (index length)
  "Validate an integer selector index and wrap valid negative indices."
  (unless (integerp index)
    (error 'type-error :datum index :expected-type 'integer))
  (let ((wrapped (if (minusp index) (+ length index) index)))
    (unless (and (plusp length) (<= 0 wrapped) (< wrapped length))
      (error "PixelArray selector index ~D is outside an axis of length ~D." index length))
    wrapped))
(defun row (pixels y)
  "Return a writable dependent 1D view of row Y; negative indices wrap."
  (%validate-pixel-array pixels)
  (unless (= (ndim pixels) 2) (error "ROW requires a two-dimensional PixelArray."))
  (let* ((dimensions (px.buffer:dimensions pixels))
         (wrapped (%pixel-index y (second dimensions)))
         (strides (px.buffer:strides pixels)))
    (px.buffer::%make-packed-view
     :owner pixels :dimensions (list (first dimensions))
     :strides (list (first strides))
     :byte-offset (+ (px.buffer:byte-offset pixels) (* wrapped (second strides)))
     :element-type (px.buffer:element-type pixels)
     :reader (lambda (x) (ref pixels x wrapped))
     :writer (lambda (value x) (setf (ref pixels x wrapped) value)))))
(defun column (pixels x)
  "Return a writable dependent 1D view of column X; negative indices wrap."
  (%validate-pixel-array pixels)
  (unless (= (ndim pixels) 2) (error "COLUMN requires a two-dimensional PixelArray."))
  (let* ((dimensions (px.buffer:dimensions pixels))
         (wrapped (%pixel-index x (first dimensions)))
         (strides (px.buffer:strides pixels)))
    (px.buffer::%make-packed-view
     :owner pixels :dimensions (list (second dimensions))
     :strides (list (second strides))
     :byte-offset (+ (px.buffer:byte-offset pixels) (* wrapped (first strides)))
     :element-type (px.buffer:element-type pixels)
     :reader (lambda (y) (ref pixels wrapped y))
     :writer (lambda (value y) (setf (ref pixels wrapped y) value)))))
(defun %packed-color (surface color)
  "Map a normal RGB(A) value to SURFACE, or accept an already packed integer."
  (if (integerp color)
      (progn
        (let* ((bits (* 8 (px.surface:get-bytesize surface)))
               (minimum (if (= bits 32) (- (ash 1 31)) 0))
               (maximum (1- (ash 1 bits))))
          (unless (<= minimum color maximum)
            (error 'type-error :datum color :expected-type `(integer ,minimum ,maximum)))
          (ldb (byte bits 0) color)))
      (px.surface:map-rgb surface
                          (if (stringp color) (pixelisp.color:parse color) color))))
(defun %normalized-options (distance weights)
  "Validate options and return DISTANCE and normalized red, green, blue weights."
  (unless (and (realp distance) (<= 0 distance 1))
    (error "Distance must be a real number in the range 0 through 1."))
  (unless (and (typep weights 'sequence) (>= (length weights) 3)
               (every #'realp (subseq weights 0 3)))
    (error "Weights must be a sequence with at least three real values."))
  (let* ((values (map 'list #'float (subseq weights 0 3)))
         (sum (reduce #'+ values)))
    (unless (and (every (lambda (weight) (>= weight 0)) values) (> sum 0))
      (error "Weights must be nonnegative and have a positive sum."))
    (values (float distance) (mapcar (lambda (weight) (/ weight sum)) values))))
(defun %color-distance (first second weights)
  "Pygame's normalized, weighted RGB Euclidean distance; alpha is ignored."
  (let ((a (px.color:to-list first)) (b (px.color:to-list second)))
    (/ (sqrt (loop for weight in weights
                   for left in a for right in b
                   sum (* weight (expt (- left right) 2))))
       255.0)))
(defun %matches-color-p (surface packed color distance weights)
  (if (zerop distance)
      (= packed color)
      (<= (%color-distance (px.surface:unmap-rgb surface packed)
                           (px.surface:unmap-rgb surface color) weights)
          distance)))
(defun make-surface (pixels)
  "Copy PIXELS into matching native storage, preserving palette indices."
  (let* ((surface (%validate-pixel-array pixels))
         (dimensions (%pixel-logical-dimensions pixels))
         (result (px.surface::%make-like surface dimensions)))
    (handler-case
        (destructuring-bind (width height) dimensions
          (px.surface:lock result)
          (unwind-protect
               (dotimes (x width)
                 (dotimes (y height)
                   (px.surface::%write-packed-pixel result x y (%pixel-ref-at pixels x y))))
            (px.surface:unlock result))
          result)
      (error (condition) (px:dispose result) (error condition)))))
(defun replace (pixels old-color new-color &key (distance 0) (weights '(0.299 0.587 0.114)))
  "Replace matching pixels in place and return PIXELS.

At distance zero, native packed pixels must match exactly, including alpha.
For positive distance, matching uses normalized weighted RGB distance and
ignores alpha, as in pygame 2.6.1. Both colors and all options are validated
before the first write."
  (let* ((surface (%validate-pixel-array pixels))
         (old-packed (%packed-color surface old-color))
         (new-packed (%packed-color surface new-color)))
    (multiple-value-bind (distance weights) (%normalized-options distance weights)
      (destructuring-bind (width height) (%pixel-logical-dimensions pixels)
        (dotimes (x width)
          (dotimes (y height)
            (let ((pixel (%pixel-ref-at pixels x y)))
              (when (%matches-color-p surface pixel old-packed distance weights)
                (%pixel-set-at pixels new-packed x y)))))))
  pixels))
(defun extract (pixels color &key (distance 0) (weights '(0.299 0.587 0.114)))
  "Return a specialized bit array, with 1 for pixels matching COLOR.

Exact matching includes alpha; positive-distance RGB matching ignores alpha."
  (let* ((surface (%validate-pixel-array pixels))
         (packed-color (%packed-color surface color)))
    (multiple-value-bind (distance weights) (%normalized-options distance weights)
      (destructuring-bind (width height) (%pixel-logical-dimensions pixels)
        (let ((result (make-array (shape pixels) :element-type 'bit)))
          (dotimes (x width result)
            (dotimes (y height)
              (let ((value (if (%matches-color-p surface (%pixel-ref-at pixels x y)
                                                packed-color distance weights)
                               1 0)))
                (if (= (ndim pixels) 1)
                    (setf (aref result x) value)
                    (setf (aref result x y) value))))))))))
(defun compare (first second &key (distance 0) (weights '(0.299 0.587 0.114)))
  "Return a specialized bit array, with 1 where decoded colors match.

At distance zero, RGBA components are compared exactly. Positive distance
uses weighted RGB distance and ignores alpha. Surface layouts may differ."
  (let* ((first-surface (%validate-pixel-array first))
         (second-surface (%validate-pixel-array second)))
    (unless (and (= (ndim first) (ndim second))
                 (equal (shape first) (shape second)))
      (error "Pixel array dimensions differ."))
    (multiple-value-bind (distance weights) (%normalized-options distance weights)
      (destructuring-bind (width height) (%pixel-logical-dimensions first)
        (let ((result (make-array (shape first) :element-type 'bit)))
          (dotimes (x width result)
            (dotimes (y height)
              (let ((left (px.surface:unmap-rgb first-surface (%pixel-ref-at first x y)))
                    (right (px.surface:unmap-rgb second-surface (%pixel-ref-at second x y))))
                (let ((value (if (if (zerop distance)
                                    (equal (px.color:to-list left) (px.color:to-list right))
                                    (<= (%color-distance left right weights) distance))
                                 1 0)))
                  (if (= (ndim first) 1)
                      (setf (aref result x) value)
                      (setf (aref result x y) value)))))))))))
(defun transpose (pixels)
  "Swap 2D axes, or add a length-one first axis to a 1D PixelArray."
  (let ((surface (%validate-pixel-array pixels))
        (dimensions (px.buffer:dimensions pixels))
        (strides (px.buffer:strides pixels)))
    (if (= (length dimensions) 1)
        (px.buffer::%make-packed-view
         :owner pixels :dimensions (list 1 (first dimensions))
         ;; pygame reports the singleton axis as one full logical row, even
         ;; when the selected line itself has a negative or nonunit stride.
         :strides (list (* (first dimensions) (px.surface:get-bytesize surface))
                        (first strides))
         :byte-offset (px.buffer:byte-offset pixels)
         :element-type (px.buffer:element-type pixels)
         :reader (lambda (x y) (declare (ignore x)) (ref pixels y))
         :writer (lambda (value x y) (declare (ignore x)) (setf (ref pixels y) value)))
        (px.buffer::%make-packed-view
         :owner pixels :dimensions (reverse dimensions) :strides (reverse strides)
         :byte-offset (px.buffer:byte-offset pixels)
         :element-type (px.buffer:element-type pixels)
         :reader (lambda (x y) (ref pixels y x))
         :writer (lambda (value x y) (setf (ref pixels y x) value))))))
