;;;; Native input devices, cursors, and text clipboard.
(defpackage #:pixelisp.devices.internal
  (:use #:cl)
  (:export #:check-code #:check-pointer #:pointer #:init-flags #:quit-flags #:flags-p))
(in-package #:pixelisp.devices.internal)
(cffi:defcfun ("SDL_InitSubSystem" %init) :int (flags :uint32))
(cffi:defcfun ("SDL_QuitSubSystem" %quit) :void (flags :uint32))
(cffi:defcfun ("SDL_WasInit" %was-init) :uint32 (flags :uint32))
(cffi:defcfun ("SDL_GetError" %error) :string)
(defun check-code (code operation)
  (when (minusp code) (error 'pixelisp:error :operation operation :message (%error))) code)
(defun check-pointer (ptr operation)
  (when (or (null ptr) (cffi:null-pointer-p ptr))
    (error 'pixelisp:error :operation operation :message (%error))) ptr)
(defun pointer (resource)
  (pixelisp.internal:ensure-live resource)
  (pixelisp.internal:handle resource))
(defun init-flags (flags) (check-code (%init flags) 'init) t)
(defun quit-flags (flags) (%quit flags) nil)
(defun flags-p (flags) (= flags (%was-init flags)))

(defpackage #:pixelisp.joystick
  (:nicknames #:px.joystick) (:use #:cl) (:shadow #:close)
  (:export #:init #:quit #:get-init #:get-count #:names #:joystick #:open-joystick
           #:close #:name #:get-guid #:get-power-level #:instance-id #:attached-p #:get-numaxes #:get-numbuttons
           #:get-numhats #:get-numballs #:get-axis #:get-button #:get-hat #:get-ball
           #:rumble #:stop-rumble #:update #:with-joystick))
(in-package #:pixelisp.joystick)
(cffi:defcfun ("SDL_NumJoysticks" %count) :int)
(cffi:defcfun ("SDL_JoystickOpen" %open) :pointer (index :int))
(cffi:defcfun ("SDL_JoystickClose" %close) :void (ptr :pointer))
(cffi:defcfun ("SDL_JoystickNameForIndex" %index-name) :string (index :int))
(cffi:defcfun ("SDL_JoystickName" %name) :string (ptr :pointer))
(cffi:defcfun ("SDL_JoystickInstanceID" %id) :int32 (ptr :pointer))
(cffi:defcfun ("SDL_JoystickGetAttached" %attached) :int (ptr :pointer))
(cffi:defcfun ("SDL_JoystickNumAxes" %axes) :int (ptr :pointer))
(cffi:defcfun ("SDL_JoystickNumButtons" %buttons) :int (ptr :pointer))
(cffi:defcfun ("SDL_JoystickNumHats" %hats) :int (ptr :pointer))
(cffi:defcfun ("SDL_JoystickNumBalls" %balls) :int (ptr :pointer))
(cffi:defcfun ("SDL_JoystickGetAxis" %axis) :int16 (ptr :pointer) (index :int))
(cffi:defcfun ("SDL_JoystickGetButton" %button) :uint8 (ptr :pointer) (index :int))
(cffi:defcfun ("SDL_JoystickGetHat" %hat) :uint8 (ptr :pointer) (index :int))
(cffi:defcfun ("SDL_JoystickGetBall" %ball) :int (ptr :pointer) (index :int) (dx :pointer) (dy :pointer))
(cffi:defcfun ("SDL_JoystickRumble" %rumble) :int (ptr :pointer) (low :uint16) (high :uint16) (milliseconds :uint32))
(cffi:defcfun ("SDL_JoystickUpdate" %update) :void)
(defclass joystick (pixelisp.internal:resource) ())
(defvar *initialized* nil)
(defun init ()
  (unless *initialized*
    ;; SDL_GameControllerInit also initializes one joystick reference, so a
    ;; native SDL_WasInit check cannot tell whether this module owns one.
    (pixelisp.devices.internal:init-flags #x200)
    (setf *initialized* t)))
(defun quit ()
  (dolist (resource (copy-list pixelisp.internal:*resources*))
    (when (typep resource 'joystick) (pixelisp:dispose resource)))
  (when (and *initialized* (pixelisp.devices.internal:flags-p #x200))
    (pixelisp.devices.internal:quit-flags #x200))
  (setf *initialized* nil)
  nil)
(defun get-init () (and *initialized* (pixelisp.devices.internal:flags-p #x200)))
(defun %reset-init-state () (setf *initialized* nil))
(pushnew #'%reset-init-state pixelisp.internal:*shutdown-hooks*)
(defun get-count () (unless (get-init) (init)) (pixelisp.devices.internal:check-code (%count) 'get-count))
(defun names () (loop for i below (get-count) collect (%index-name i)))
(defun open-joystick (index)
  (check-type index (integer 0 *))
  (unless (get-init) (init))
  (let ((pointer (pixelisp.devices.internal:check-pointer (%open index) 'open-joystick))
        (complete nil))
    (unwind-protect
         (let ((object (pixelisp.internal:register-resource
                        (make-instance 'joystick :handle pointer))))
           (setf complete t)
           object)
      (unless complete (%close pointer)))))
(defmethod pixelisp.internal:dispose ((object joystick)) (%close (pixelisp.internal:handle object)))
(defun close (object)
  (check-type object joystick)
  (pixelisp.internal:dispose object))
(defun %joystick-pointer (object)
  (check-type object joystick)
  (pixelisp.devices.internal:pointer object))
(defun %attached-pointer (object operation)
  (let ((pointer (%joystick-pointer object)))
    (unless (plusp (%attached pointer))
      (error 'pixelisp:error :operation operation :message "Joystick is detached."))
    pointer))
(defun name (object) (%name (%attached-pointer object 'name)))
(defun instance-id (object) (%id (%joystick-pointer object)))
(defun attached-p (object) (plusp (%attached (%joystick-pointer object))))
(defun get-numaxes (object) (%axes (%attached-pointer object 'get-numaxes)))
(defun get-numbuttons (object) (%buttons (%attached-pointer object 'get-numbuttons)))
(defun get-numhats (object) (%hats (%attached-pointer object 'get-numhats)))
(defun get-numballs (object) (%balls (%attached-pointer object 'get-numballs)))
(defun %index (index count)
  (unless (and (integerp index) (<= 0 index) (< index count))
    (error 'type-error :datum index :expected-type `(integer 0 (,count)))) index)
(defun get-axis (object index)
  (let ((ptr (%attached-pointer object 'get-axis)))
    (let ((n (%axis ptr (%index index (%axes ptr)))))
      (/ n (if (minusp n) 32768.0 32767.0)))))
(defun get-button (object index)
  (let ((ptr (%attached-pointer object 'get-button)))
    (plusp (%button ptr (%index index (%buttons ptr))))))
(defun get-hat (object index)
  (let* ((ptr (%attached-pointer object 'get-hat))
         (bits (%hat ptr (%index index (%hats ptr)))))
    (list (- (if (logtest bits 2) 1 0) (if (logtest bits 8) 1 0))
          (- (if (logtest bits 1) 1 0) (if (logtest bits 4) 1 0)))))
(defun get-ball (object index)
  (cffi:with-foreign-objects ((dx :int) (dy :int))
    (let ((ptr (%attached-pointer object 'get-ball)))
      (pixelisp.devices.internal:check-code
       (%ball ptr (%index index (%balls ptr)) dx dy) 'get-ball)
      (list (cffi:mem-ref dx :int) (cffi:mem-ref dy :int)))))
(defun rumble (object low high milliseconds)
  (check-type low (real 0 1)) (check-type high (real 0 1)) (check-type milliseconds (unsigned-byte 32))
  (pixelisp.devices.internal:check-code
   (%rumble (%attached-pointer object 'rumble) (round (* low 65535)) (round (* high 65535)) milliseconds) 'rumble) t)
(defun stop-rumble (object) (rumble object 0 0 0))
(defun update () (%update))
(defmacro with-joystick ((var index) &body body)
  `(let ((,var (open-joystick ,index))) (unwind-protect (progn ,@body) (close ,var))))

(defpackage #:pixelisp.controller
  (:nicknames #:px.controller #:pixelisp.sdl2.controller #:px.sdl2.controller) (:use #:cl)
  (:shadow #:close)
  (:export #:init #:quit #:get-init #:get-count #:controller-p #:controller #:name-for-index
           #:get-eventstate #:set-eventstate #:open-controller
           #:close #:name #:instance-id #:attached-p #:get-axis #:get-button #:rumble
           #:stop-rumble #:add-mapping #:mapping #:get-numtouchpads #:get-touchpad-finger
           #:axis-names #:button-names #:with-controller #:from-joystick #:as-joystick
           #:get-mapping #:set-mapping))
(in-package #:pixelisp.controller)
(cffi:defcfun ("SDL_IsGameController" %is-controller) :int (index :int))
(cffi:defcfun ("SDL_GameControllerOpen" %open) :pointer (index :int))
(cffi:defcfun ("SDL_GameControllerClose" %close) :void (ptr :pointer))
(cffi:defcfun ("SDL_GameControllerName" %name) :string (ptr :pointer))
(cffi:defcfun ("SDL_GameControllerGetJoystick" %joystick) :pointer (ptr :pointer))
(cffi:defcfun ("SDL_JoystickInstanceID" %instance-id) :int32 (ptr :pointer))
(cffi:defcfun ("SDL_GameControllerGetAttached" %attached) :int (ptr :pointer))
(cffi:defcfun ("SDL_GameControllerGetAxis" %axis) :int16 (ptr :pointer) (axis :int))
(cffi:defcfun ("SDL_GameControllerGetButton" %button) :uint8 (ptr :pointer) (button :int))
(cffi:defcfun ("SDL_GameControllerRumble" %rumble) :int (ptr :pointer) (low :uint16) (high :uint16) (duration :uint32))
(cffi:defcfun ("SDL_GameControllerAddMapping" %mapping-add) :int (mapping :string))
(cffi:defcfun ("SDL_GameControllerMapping" %mapping) :pointer (ptr :pointer))
(cffi:defcfun ("SDL_free" %free) :void (ptr :pointer))
(cffi:defcfun ("SDL_GameControllerGetNumTouchpads" %numtouchpads) :int (ptr :pointer))
(cffi:defcfun ("SDL_GameControllerGetTouchpadFinger" %finger) :int (ptr :pointer) (pad :int) (finger :int) (state :pointer) (x :pointer) (y :pointer) (pressure :pointer))
(defparameter axis-names '(:left-x :left-y :right-x :right-y :trigger-left :trigger-right))
(defparameter button-names '(:a :b :x :y :back :guide :start :left-stick :right-stick :left-shoulder :right-shoulder :dpad-up :dpad-down :dpad-left :dpad-right :misc1 :paddle1 :paddle2 :paddle3 :paddle4 :touchpad))
(defclass controller (pixelisp.internal:resource) ())
(defvar *initialized* nil)
(defun init ()
  (unless *initialized*
    ;; Keep our own reference distinct from SDL's joystick dependency ref.
    (pixelisp.devices.internal:init-flags #x2000)
    (setf *initialized* t)))
(defun quit ()
  (dolist (resource (copy-list pixelisp.internal:*resources*))
    (when (typep resource 'controller) (pixelisp:dispose resource)))
  (when (and *initialized* (pixelisp.devices.internal:flags-p #x2000))
    (pixelisp.devices.internal:quit-flags #x2000))
  (setf *initialized* nil)
  nil)
(defun get-init () (and *initialized* (pixelisp.devices.internal:flags-p #x2000)))
(defun %reset-init-state () (setf *initialized* nil))
(pushnew #'%reset-init-state pixelisp.internal:*shutdown-hooks*)
(defun get-count () (unless (get-init) (init)) (px.joystick:get-count))
(defun controller-p (index) (unless (get-init) (init)) (plusp (%is-controller index)))
(defun open-controller (index)
  (check-type index (integer 0 *)) (unless (get-init) (init))
  (let ((pointer (pixelisp.devices.internal:check-pointer (%open index) 'open-controller))
        (complete nil))
    (unwind-protect
         (let ((object (pixelisp.internal:register-resource
                        (make-instance 'controller :handle pointer))))
           (setf complete t)
           object)
      (unless complete (%close pointer)))))
(defmethod pixelisp.internal:dispose ((object controller)) (%close (pixelisp.internal:handle object)))
(defun close (object)
  (check-type object controller)
  (pixelisp.internal:dispose object))
(defun %controller-pointer (object)
  (check-type object controller)
  (pixelisp.devices.internal:pointer object))
(defun %attached-pointer (object operation)
  (let ((pointer (%controller-pointer object)))
    (unless (plusp (%attached pointer))
      (error 'pixelisp:error :operation operation :message "Controller is detached."))
    pointer))
(defun name (object) (%name (%attached-pointer object 'name)))
(defun instance-id (object)
  (let* ((pointer (%controller-pointer object))
         (joystick (pixelisp.devices.internal:check-pointer
                    (%joystick pointer) 'instance-id)))
    (%instance-id joystick)))
(defun attached-p (object) (plusp (%attached (%controller-pointer object))))
(defun %enum (value names)
  (if (integerp value) (px.joystick::%index value (length names))
      (or (position value names) (error 'type-error :datum value :expected-type `(member ,@names)))))
(defun get-axis (object axis)
  (let ((n (%axis (%attached-pointer object 'get-axis) (%enum axis axis-names))))
    (/ n (if (minusp n) 32768.0 32767.0))))
(defun get-button (object button) (plusp (%button (%attached-pointer object 'get-button) (%enum button button-names))))
(defun rumble (object low high milliseconds)
  (check-type low (real 0 1)) (check-type high (real 0 1)) (check-type milliseconds (unsigned-byte 32))
  (pixelisp.devices.internal:check-code (%rumble (%attached-pointer object 'rumble) (round (* low 65535)) (round (* high 65535)) milliseconds) 'rumble) t)
(defun stop-rumble (object) (rumble object 0 0 0))
(defun add-mapping (string) (pixelisp.devices.internal:check-code (%mapping-add string) 'add-mapping))
(defun mapping (object)
  (let ((p (pixelisp.devices.internal:check-pointer (%mapping (%attached-pointer object 'mapping)) 'mapping)))
    (unwind-protect (cffi:foreign-string-to-lisp p :encoding :utf-8) (%free p))))
(defun get-numtouchpads (object) (pixelisp.devices.internal:check-code (%numtouchpads (%attached-pointer object 'get-numtouchpads)) 'get-numtouchpads))
(defun get-touchpad-finger (object pad finger)
  (let ((ptr (%attached-pointer object 'get-touchpad-finger)))
    (cffi:with-foreign-objects ((state :uint8) (x :float) (y :float) (pressure :float))
      (pixelisp.devices.internal:check-code (%finger ptr pad finger state x y pressure) 'get-touchpad-finger)
      (list :down (plusp (cffi:mem-ref state :uint8)) :x (cffi:mem-ref x :float)
            :y (cffi:mem-ref y :float) :pressure (cffi:mem-ref pressure :float)))))
(defmacro with-controller ((var index) &body body)
  `(let ((,var (open-controller ,index))) (unwind-protect (progn ,@body) (close ,var))))

(defpackage #:pixelisp.touch
  (:nicknames #:px.touch #:pixelisp.sdl2.touch #:px.sdl2.touch) (:use #:cl)
  (:export #:get-num-devices #:get-device #:get-num-fingers #:get-finger #:devices))
(in-package #:pixelisp.touch)
(cffi:defcstruct finger (id :int64) (x :float) (y :float) (pressure :float))
(cffi:defcfun ("SDL_GetNumTouchDevices" %count) :int)
(cffi:defcfun ("SDL_GetTouchDevice" %device) :int64 (index :int))
(cffi:defcfun ("SDL_GetNumTouchFingers" %count-fingers) :int (id :int64))
(cffi:defcfun ("SDL_GetTouchFinger" %finger) :pointer (id :int64) (index :int))
(defun get-num-devices () (pixelisp.devices.internal:check-code (%count) 'get-num-devices))
(defun get-device (index)
  (px.joystick::%index index (get-num-devices))
  (let ((id (%device index))) (when (zerop id) (error 'pixelisp:error :operation 'get-device :message "Touch device disappeared.")) id))
(defun devices () (loop for i below (get-num-devices) collect (get-device i)))
(defun get-num-fingers (device-id) (pixelisp.devices.internal:check-code (%count-fingers device-id) 'get-num-fingers))
(defun get-finger (device-id index)
  (let ((p (pixelisp.devices.internal:check-pointer (%finger device-id index) 'get-finger)))
    (cffi:with-foreign-slots ((id x y pressure) p (:struct finger))
      (list :id id :x x :y y :pressure pressure))))

(defpackage #:pixelisp.cursors
  (:nicknames #:px.cursors) (:use #:cl) (:shadow #:close)
  (:export #:cursor #:system-cursor #:color-cursor #:bitmap-cursor #:set-cursor #:get-cursor #:close #:load-xbm #:compile-cursor #:system-cursors))
(in-package #:pixelisp.cursors)
(cffi:defcfun ("SDL_CreateSystemCursor" %system) :pointer (id :int))
(cffi:defcfun ("SDL_CreateColorCursor" %color) :pointer (surface :pointer) (x :int) (y :int))
(cffi:defcfun ("SDL_CreateCursor" %bitmap) :pointer (data :pointer) (mask :pointer) (w :int) (h :int) (x :int) (y :int))
(cffi:defcfun ("SDL_SetCursor" %set) :void (ptr :pointer))
(cffi:defcfun ("SDL_FreeCursor" %free) :void (ptr :pointer))
(defclass cursor (pixelisp.internal:resource) ())
(defparameter system-cursors '(:arrow :ibeam :wait :crosshair :wait-arrow :size-nwse :size-nesw :size-we :size-ns :size-all :no :hand))
(defvar *cursor* nil)
(defun %new (ptr) (pixelisp.internal:register-resource (make-instance 'cursor :handle (pixelisp.devices.internal:check-pointer ptr 'make-cursor))))
(defun system-cursor (&optional (kind :arrow))
  (pixelisp.internal:check-video-thread)
  (%new (%system (or (position kind system-cursors) (error 'type-error :datum kind :expected-type `(member ,@system-cursors))))))
(defun color-cursor (surface &optional (hotspot '(0 0)))
  (pixelisp.internal:check-video-thread)
  (%new (%color (pixelisp.internal::%ptr (pixelisp.internal:surface-handle surface)) (first hotspot) (second hotspot))))
(defun compile-cursor (rows &key (black #\X) (white #\.) (transparent #\Space))
  "Compile equal-width strings into SDL data/mask octets. Width must be a multiple of eight."
  (let* ((h (length rows)) (w (if rows (length (first rows)) 0))
         (data (make-array (* h (/ w 8)) :element-type '(unsigned-byte 8) :initial-element 0))
         (mask (copy-seq data)))
    (unless (and (plusp w) (zerop (mod w 8)) (every (lambda (row) (= w (length row))) rows))
      (error 'pixelisp:error :operation 'compile-cursor :message "Cursor rows must have equal, positive widths divisible by eight."))
    (loop for row in rows for y from 0 do
      (loop for ch across row for x from 0 for index = (+ (* y (/ w 8)) (floor x 8)) for bit = (ash 1 (- 7 (mod x 8))) do
        (cond ((char= ch black) (setf (aref data index) (logior bit (aref data index)) (aref mask index) (logior bit (aref mask index))))
              ((char= ch white) (setf (aref mask index) (logior bit (aref mask index))))
              ((char/= ch transparent) (error 'pixelisp:error :operation 'compile-cursor :message "Unknown cursor pixel character.")))))
    (values data mask (list w h))))
(defun bitmap-cursor (size data mask &optional (hotspot '(0 0)))
  (pixelisp.internal:check-video-thread)
  (destructuring-bind (w h) size
    (unless (and (plusp w) (plusp h) (zerop (mod w 8)) (= (length data) (length mask) (* h (/ w 8))))
      (error 'pixelisp:error :operation 'bitmap-cursor :message "Bitmap cursor dimensions and buffers disagree."))
    (cffi:with-foreign-objects ((d :uint8 (length data)) (m :uint8 (length mask)))
      (dotimes (i (length data)) (setf (cffi:mem-aref d :uint8 i) (elt data i) (cffi:mem-aref m :uint8 i) (elt mask i)))
      (%new (%bitmap d m w h (first hotspot) (second hotspot))))))
(defun set-cursor (cursor)
  (pixelisp.internal:check-video-thread)
  (%set (if cursor (pixelisp.devices.internal:pointer cursor) (cffi:null-pointer))) (setf *cursor* cursor))
(defun get-cursor () *cursor*)
(defmethod pixelisp.internal:dispose ((object cursor))
  (pixelisp.internal:check-video-thread)
  (when (eq object *cursor*) (%set (cffi:null-pointer)) (setf *cursor* nil))
  (%free (pixelisp.internal:handle object)))
(defun close (cursor) (pixelisp.internal:dispose cursor))

(defpackage #:pixelisp.scrap
  (:nicknames #:px.scrap) (:use #:cl) (:shadow #:get)
  (:export #:init #:quit #:get-init #:get #:put #:get-text #:put-text #:get-types #:contains #:set-mode #:get-mode #:capabilities))
(in-package #:pixelisp.scrap)
(cffi:defcfun ("SDL_GetClipboardText" %get) :pointer)
(cffi:defcfun ("SDL_SetClipboardText" %put) :int (text :string))
(cffi:defcfun ("SDL_HasClipboardText" %has) :int)
(cffi:defcfun ("SDL_GetPrimarySelectionText" %primary-get) :pointer)
(cffi:defcfun ("SDL_SetPrimarySelectionText" %primary-put) :int (text :string))
(cffi:defcfun ("SDL_HasPrimarySelectionText" %primary-has) :int)
(cffi:defcfun ("SDL_free" %free) :void (ptr :pointer))
(defvar *initialized* nil)
(defvar *mode* :clipboard)
(defun init () (pixelisp.internal:check-video-thread) (setf *initialized* t))
(defun quit () (setf *initialized* nil *mode* :clipboard) nil)
(defun get-init () *initialized*)
(defun capabilities () '(:text t :mime-types ("text/plain" "text/plain;charset=utf-8") :binary nil :primary-selection :platform-dependent))
(defun %ready () (pixelisp.internal:check-video-thread) (unless *initialized* (init)))
(defun set-mode (mode) (check-type mode (member :clipboard :selection)) (setf *mode* mode))
(defun get-mode () *mode*)
(defun get-text ()
  (%ready)
  (let ((p (pixelisp.devices.internal:check-pointer (if (eq *mode* :selection) (%primary-get) (%get)) 'get-text)))
    (unwind-protect (cffi:foreign-string-to-lisp p :encoding :utf-8) (%free p))))
(defun put-text (text)
  (%ready) (check-type text string)
  (when (find #\Null text) (error 'pixelisp:error :operation 'put-text :message "Clipboard text cannot contain NUL characters."))
  (pixelisp.devices.internal:check-code (if (eq *mode* :selection) (%primary-put text) (%put text)) 'put-text) text)
(defun contains (type)
  (%ready) (and (member type '("text/plain" "text/plain;charset=utf-8") :test #'string-equal)
               (plusp (if (eq *mode* :selection) (%primary-has) (%has)))))
(defun get-types () (if (contains "text/plain") '("text/plain" "text/plain;charset=utf-8") nil))
(defun %text-type (type)
  (unless (member type '("text/plain" "text/plain;charset=utf-8") :test #'string-equal)
    (error 'pixelisp:unsupported-feature :operation 'clipboard :message "The SDL clipboard adapter supports UTF-8 text only; inspect CAPABILITIES.")))
(defun get (&optional (type "text/plain")) (%text-type type) (when (contains type) (babel:string-to-octets (get-text) :encoding :utf-8)))
(defun put (type data) (%text-type type) (put-text (if (stringp data) data (babel:octets-to-string data :encoding :utf-8))))
