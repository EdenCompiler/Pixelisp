;;;; Lightweight views into renderer-owned textures, following pygame 2.6.1 Image.
(in-package #:pixelisp.sdl2.video)

(defclass image ()
  ;; Plain slots avoid exposing unchecked CLOS-generated setter functions.
  ((texture :initarg :texture)
   (base-rect :initarg :base-rect)
   (source-rect :initarg :source-rect)
   (angle :initform 0d0)
   (origin :initform nil)
   (flip-x :initform nil)
   (flip-y :initform nil)
   (color :initform '(255 255 255))
   (alpha :initform 255)
   (blend-mode :initarg :blend-mode :initform :blend)))

(defun %image-rect (value)
  (let ((rect (pixelisp.internal:as-rect value)))
    (px.rect:copy rect)))
(defun %image-base-rect (image)
  (px.rect:copy (slot-value image 'base-rect)))

(defun %image-contained-p (rect bounds)
  (and (not (minusp (px.rect:x rect))) (not (minusp (px.rect:y rect)))
       (plusp (px.rect:width rect)) (plusp (px.rect:height rect))
       (<= (+ (px.rect:x rect) (px.rect:width rect)) (px.rect:width bounds))
       (<= (+ (px.rect:y rect) (px.rect:height rect)) (px.rect:height bounds))))

(defun %image-absolute-rect (relative base)
  (let ((rect (%image-rect relative)))
    (unless (%image-contained-p rect base)
      (error "Image region ~S is outside its parent region ~S." rect base))
    (setf (px.rect:x rect) (+ (px.rect:x rect) (px.rect:x base))
          (px.rect:y rect) (+ (px.rect:y rect) (px.rect:y base)))
    rect))

(defun make-image (texture-or-image &optional source-rect)
  "Make a no-allocation atlas view. SOURCE-RECT is relative to the input view."
  (let* ((nested (typep texture-or-image 'image))
         (texture (if nested (image-texture texture-or-image) texture-or-image)))
    (check-type texture texture)
    (%pointer texture)
    (let* ((base (if nested
                   (image-source-rect texture-or-image)
                   (apply #'px.rect:make-rect 0 0 (texture-size texture))))
           (region (if source-rect (%image-absolute-rect source-rect base)
                       (px.rect:copy base)))
           (blend (if nested (image-blend-mode texture-or-image)
                      (texture-blend-mode texture))))
      (make-instance 'image :texture texture :base-rect base :source-rect region
                     :blend-mode blend))))

(defun (setf image-source-rect) (value image)
  (%image-live image)
  (let ((rect (%image-rect value)))
    (let ((base (%image-base-rect image)))
      (unless (and (plusp (px.rect:width rect)) (plusp (px.rect:height rect))
                   (<= (px.rect:x base) (px.rect:x rect))
                   (<= (px.rect:y base) (px.rect:y rect))
                   (<= (+ (px.rect:x rect) (px.rect:width rect))
                       (+ (px.rect:x base) (px.rect:width base)))
                   (<= (+ (px.rect:y rect) (px.rect:height rect))
                       (+ (px.rect:y base) (px.rect:height base))))
      (error "Image source rectangle ~S must be positive and inside its parent region." rect))
      (setf (slot-value image 'source-rect) rect))))
(defun image-source-rect (image)
  (%image-live image)
  (px.rect:copy (slot-value image 'source-rect)))
(defun image-texture (image)
  (check-type image image)
  (%pointer (slot-value image 'texture))
  (slot-value image 'texture))
(defun (setf image-texture) (value image)
  (%image-live image)
  (check-type value texture)
  (%pointer value)
  (unless (eq (%parent value) (%parent (slot-value image 'texture)))
    (error 'pixelisp:error :operation 'image-texture
           :message "An image can only be rebound to a texture owned by the same renderer."))
  (let ((bounds (apply #'px.rect:make-rect 0 0 (texture-size value)))
        (base (%image-base-rect image)))
    (unless (and (<= 0 (px.rect:x base)) (<= 0 (px.rect:y base))
                 (<= (+ (px.rect:x base) (px.rect:width base)) (px.rect:width bounds))
                 (<= (+ (px.rect:y base) (px.rect:height base)) (px.rect:height bounds)))
      (error "The image's parent region does not fit the replacement texture.")))
  (setf (slot-value image 'texture) value))

(defun %image-live (image)
  (check-type image image)
  (%pointer (image-texture image))
  image)
(defun image-angle (image) (%image-live image) (slot-value image 'angle))
(defun (setf image-angle) (value image)
  (%image-live image) (check-type value real)
  (setf (slot-value image 'angle) (coerce value 'double-float)))
(defun image-origin (image) (%image-live image) (copy-list (slot-value image 'origin)))
(defun (setf image-origin) (value image)
  (%image-live image)
  (setf (slot-value image 'origin)
        (when value
          (multiple-value-bind (x y) (pixelisp.internal:pair value)
            (check-type x real) (check-type y real)
            (list (truncate x) (truncate y))))))
(defun image-flip-x (image) (%image-live image) (slot-value image 'flip-x))
(defun (setf image-flip-x) (value image) (%image-live image) (check-type value boolean) (setf (slot-value image 'flip-x) value))
(defun image-flip-y (image) (%image-live image) (slot-value image 'flip-y))
(defun (setf image-flip-y) (value image) (%image-live image) (check-type value boolean) (setf (slot-value image 'flip-y) value))
(defun image-color (image) (%image-live image) (copy-list (slot-value image 'color)))
(defun (setf image-color) (value image)
  (%image-live image)
  (multiple-value-bind (r g b) (pixelisp.internal:rgba value)
    (setf (slot-value image 'color) (list r g b))))
(defun image-alpha (image) (%image-live image) (slot-value image 'alpha))
(defun (setf image-alpha) (value image) (%image-live image) (check-type value (unsigned-byte 8)) (setf (slot-value image 'alpha) value))
(defun image-blend-mode (image) (%image-live image) (slot-value image 'blend-mode))
(defun (setf image-blend-mode) (value image)
  (%image-live image)
  (unless (or (member value '(:none :blend :add :mod :mul))
              (member value '(0 1 2 4 8)))
    (error 'type-error :datum value
           :expected-type '(or (member 0 1 2 4 8) (member :none :blend :add :mod :mul))))
  (setf (slot-value image 'blend-mode) value))

(defun image-get-rect (image &rest anchors)
  "Return a copy of the absolute texture region, positioned by anchor pairs."
  (%image-live image)
  (let ((rect (px.rect:copy (image-source-rect image))))
    ;; Reuse the established anchor behavior from texture-get-rect, then preserve
    ;; the requested crop's dimensions while applying the resulting coordinates.
    (apply #'texture-get-rect (image-texture image) anchors) ; validates anchor names/pairs
      (when (evenp (length anchors))
        (loop for (key val) on anchors by #'cddr do
          (case key
            ((:top-left :topleft) (setf (px.rect:top-left rect) val))
            ((:top-right :topright) (setf (px.rect:top-right rect) val))
            ((:bottom-left :bottomleft) (setf (px.rect:bottom-left rect) val))
            ((:bottom-right :bottomright) (setf (px.rect:bottom-right rect) val))
            ((:mid-top :midtop) (setf (px.rect:mid-top rect) val))
            ((:mid-left :midleft) (setf (px.rect:mid-left rect) val))
            ((:mid-bottom :midbottom) (setf (px.rect:mid-bottom rect) val))
            ((:mid-right :midright) (setf (px.rect:mid-right rect) val))
            ((:left :x) (setf (px.rect:left rect) (truncate val)))
            ((:top :y) (setf (px.rect:top rect) (truncate val)))
            (:right (setf (px.rect:right rect) (truncate val)))
            (:bottom (setf (px.rect:bottom rect) (truncate val)))
            ((:center-x :centerx) (setf (px.rect:center-x rect) (truncate val)))
            ((:center-y :centery) (setf (px.rect:center-y rect) (truncate val)))
            (:center (setf (px.rect:center rect) val)))))
    rect))

(defun %image-destination (destination region)
  ;; pygame Image.draw accepts an (x,y) position and uses the view's native size.
  (if (and (typep destination 'sequence) (= (length destination) 2))
      (multiple-value-bind (x y) (pixelisp.internal:pair destination)
        (px.rect:make-rect (truncate x) (truncate y)
                           (px.rect:width region) (px.rect:height region)))
      destination))

(defun draw-image (renderer image &key source destination)
  "Draw IMAGE's atlas region; SOURCE is relative, and a two-item DESTINATION is a position."
  (pixelisp.internal:with-native-context
    (%image-live image)
    (let* ((texture (image-texture image))
           (region (image-source-rect image))
           (src (if source (%image-absolute-rect source region) (px.rect:copy region)))
           (dst (%image-destination destination region))
           (old-color (texture-color texture)) (old-alpha (texture-alpha texture))
           (old-blend (texture-blend-mode texture)))
      (unless (eq renderer (%parent texture))
        (error 'pixelisp:error :operation 'draw-image :message "Image texture belongs to a different renderer."))
      (unwind-protect
           (progn
             (setf (texture-color texture) (image-color image)
                   (texture-alpha texture) (image-alpha image)
                   (texture-blend-mode texture) (image-blend-mode image))
             (draw-texture renderer texture :source src :destination dst
                           :angle (image-angle image) :origin (image-origin image)
                           :flip-x (image-flip-x image) :flip-y (image-flip-y image))
             renderer)
        ;; Image modifiers are per-view; restore the shared texture even on SDL errors.
        (setf (texture-color texture) old-color
              (texture-alpha texture) old-alpha
              (texture-blend-mode texture) old-blend))
      renderer)))
